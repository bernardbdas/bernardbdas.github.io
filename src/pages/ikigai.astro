---
/**
 * ikigai.astro — The Sea We Breathe-inspired Experiential Sanctuary for Ikigai
 * UI/UX reference: https://www.bluemarinefoundation.com/the-sea-we-breathe/journeys/
 *
 * Characteristics:
 * - Themeless Monastic Void & Kintsugi Gold: Complete theme lockdown (no theme switching allowed).
 * - 15-Minute Sacred Immersion Lock: User is held in mindful presence with a 15-minute countdown;
 *   attempting to leave triggers the Zen Gatekeeper with Nuclear Hard Reload as the only escape hatch.
 * - Ethereal HUD Telemetry & Fluid Particle Canvas: Inspired by Green Chameleon / Unseen Studio's award-winning WebGL UX.
 * - Interactive Guided Breathing Conduit (Conscious Inhale-Hold-Exhale-Stillness).
 * - 5 Interactive Narrative Journeys:
 *   1. The Circumference & The Center (Religiousness vs. Dogma)
 *   2. Synthesis of Matter & Spirit (Worldly Excellence & Meditative Stillness)
 *   3. The 5 Authentic Japanese Pillars of Ikigai (Ken Mogi's 5 Pillars)
 *   4. The Triad in Sacred Sync (Mind, Body, Heart)
 *   5. The Dhyana Interval Engine with Tibetan Singing Bowl harmonics & Zen Soundscapes
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromeNav from '../components/ChromeNav.astro';
import ChromeFooter from '../components/ChromeFooter.astro';
import Loader from '../components/Loader.astro';

interface JourneyChapter {
  id: string;
  num: string;
  subtag: string;
  title: string;
  subtitle: string;
  essence: string;
}

const chapters: JourneyChapter[] = [
  {
    id: 'journey-center',
    num: 'JOURNEY 01',
    subtag: 'THE INNER AXIS',
    title: 'THE CENTER & CIRCUMFERENCE',
    subtitle: 'Religiousness Without Dogma',
    essence:
      'The journey from the noisy perimeter of beliefs to the silent sanctuary of pure being.',
  },
  {
    id: 'journey-synthesis',
    num: 'JOURNEY 02',
    subtag: 'MATTER & SPIRIT',
    title: 'SYNTHESIS OF MATTER & SPIRIT',
    subtitle: 'Earth & Sky in Unison',
    essence:
      'Why scarcity of mind and body restricts the spirit; how material competence liberates you to seek the infinite.',
  },
  {
    id: 'journey-pillars',
    num: 'JOURNEY 03',
    subtag: 'FIVE PILLARS',
    title: 'THE FIVE PILLARS OF IKIGAI',
    subtitle: 'Authentic Japanese Tradition',
    essence:
      'Beyond the modern Venn diagram myth. The ordinary, joyful contentment of living here and now.',
  },
  {
    id: 'journey-triad',
    num: 'JOURNEY 04',
    subtag: 'TRIAD IN SYNC',
    title: 'THE TRIAD IN HARMONY',
    subtitle: 'Mind, Body, and Heart',
    essence:
      'Consecrating your vital energies through single-minded craft, physical vitality, and deep devotion.',
  },
  {
    id: 'journey-dhyana',
    num: 'JOURNEY 05',
    subtag: 'PRESENCE ENGINE',
    title: 'THE DHYANA ENGINE',
    subtitle: 'Intervals of Presence',
    essence:
      'Conscious timeboxing with Tibetan singing bowl acoustic harmonics and temple rain streams.',
  },
];

interface CadenceOption {
  id: string;
  name: string;
  focusMin: number;
  breakMin: number;
  tag: string;
  cadenceLabel: string;
}

const cadences: CadenceOption[] = [
  {
    id: 'deep-presence',
    name: '50m Deep Presence // 10m Stillness & Reflection',
    focusMin: 50,
    breakMin: 10,
    tag: 'DEEP WORK',
    cadenceLabel: 'DEEP FOCUS',
  },
  {
    id: 'mindful-flow',
    name: '25m Mindful Flow // 5m Conscious Breath',
    focusMin: 25,
    breakMin: 5,
    tag: 'CLASSIC FLOW',
    cadenceLabel: 'MINDFUL FLOW',
  },
  {
    id: 'ultradian-rhythm',
    name: '90m Deep Craft // 20m Quiet Reverie',
    focusMin: 90,
    breakMin: 20,
    tag: 'ULTRADIAN',
    cadenceLabel: 'EXPANSIVE CYCLE',
  },
  {
    id: 'clarity-burst',
    name: '15m Clarity Sprint // 3m Micro-Meditation',
    focusMin: 15,
    breakMin: 3,
    tag: 'CLARITY',
    cadenceLabel: 'FOCUSED SPRINT',
  },
];

interface SanctuaryTrack {
  id: string;
  name: string;
  desc: string;
  ytId?: string;
  code: string;
}

const sanctuaryTracks: SanctuaryTrack[] = [
  {
    id: 'lofi-piano',
    name: 'PEACEFUL PIANO',
    desc: 'Acoustic piano to soothe the heart',
    ytId: 'N0snMcR6aaA',
    code: 'PIANO',
  },
  {
    id: 'rain-window',
    name: 'ZEN RAINDROPS',
    desc: 'Precipitation against monastery glass',
    ytId: 'mPZkdNFkNps',
    code: 'RAIN',
  },
  {
    id: 'lofi-girl',
    name: 'LOFI STUDY BEATS',
    desc: 'Rhythmic study beats by Lofi Girl',
    ytId: '5qap5aO4i9A',
    code: 'LOFI',
  },
  {
    id: 'cabin-rain-fire',
    name: 'RAIN & HEARTH FIRE',
    desc: 'Crackling warmth & distant storm',
    ytId: 'i38TNpJ6pDs',
    code: 'HEARTH',
  },
  {
    id: 'loop',
    name: 'SUBTERRANEAN VOID',
    desc: 'Deep atmospheric resonance',
    code: 'VOID',
  },
  {
    id: 'silent',
    name: 'SILENT WITNESS',
    desc: 'Zero sound • Pure emptiness',
    code: 'OFF',
  },
];
---

<BaseLayout
  title="Ikigai — The Way of Meaning • An Experiential Journey"
  description="Immersive spiritual sanctuary exploring authentic Japanese Ikigai, the synthesis of earthly mastery with inner stillness, and the harmonization of Mind, Body, and Heart."
>
  <!-- Background Ambient Fluid Canvas -->
  <canvas id="zenFluidCanvas" class="zen-fluid-canvas" aria-hidden="true"></canvas>

  <ChromeNav />

  <!-- ══════════════════════════════════════════════════════════
       THE SEA WE BREATHE-STYLE EXPEDITION HUD & WAYPOINT RAIL
       ══════════════════════════════════════════════════════════ -->
  <div class="swb-sanctuary-container" id="ikigaiSanctuaryRoot">
    <!-- Top HUD Telemetry Ribbon -->
    <aside class="swb-hud-ribbon" aria-label="Sanctuary Telemetry">
      <div class="hud-item hud-coords">
        <span class="hud-dot"></span>
        <span class="hud-text">AXIS: 35.0116° N // 135.7681° E (GLOBAL SANCTUARY)</span>
      </div>
      <div
        class="hud-item hud-lock-capsule"
        id="hudLockCapsule"
        title="15-minute sacred immersion lock in effect"
      >
        <span class="lock-indicator" aria-hidden="true">
          <span class="lock-dot"></span>
        </span>
        <span class="hud-lock-label">15-MIN IMMERSION LOCK:</span>
        <span class="hud-countdown" id="hudCountdownReadout">
          15:00
        </span>
      </div>
      <div class="hud-item hud-escape-gate">
        <span class="escape-label">SANCTUARY ESCAPE:</span>
        <button
          type="button"
          class="hud-purge-btn"
          id="hudPurgeEscapeBtn"
          title="Nuclear Hard Reload Purge"
        >
          HARD RELOAD // PURGE
        </button>
      </div>
    </aside>

    <div class="swb-expedition-layout">
      <!-- ─── FLOATING WAYPOINT JOURNEY RAIL (LEFT DOCKED) ──────── -->
      <nav class="swb-waypoint-rail" aria-label="Journeys of Consciousness">
        <div class="rail-title-row">
          <span class="rail-tag">JOURNEYS // CONSCIOUS EXPEDITIONS</span>
          <span class="rail-counter" id="railActiveStep">
            01 / 05
          </span>
        </div>
        <div class="rail-nodes-list" role="tablist">
          {chapters.map((chap, idx) => (
            <a
              href={`#${chap.id}`}
              class:list={['rail-node-link', { active: idx === 0 }]}
              data-target={chap.id}
              role="tab"
              aria-label={chap.title}
            >
              <div class="node-glyph-wrap">
                <span class="node-num">{chap.num.replace('JOURNEY ', '')}</span>
                <span class="node-pulse-ring"></span>
              </div>
              <div class="node-meta">
                <span class="node-title">{chap.title}</span>
                <span class="node-subtag">{chap.subtag}</span>
              </div>
            </a>
          ))}
        </div>
      </nav>

      <!-- ─── MAIN EXPEDITION VIEWPORT ───────────────────────────── -->
      <main class="swb-expedition-viewport" id="top">
        <!-- Breadcrumb link -->
        <div class="subpage-breadcrumb swb-breadcrumb">
          <a href="/" class="breadcrumb-link" aria-label="Return to index">
            <span class="breadcrumb-arrow">←</span>
            <span>INDEX // CORE SYSTEMS</span>
          </a>
          <span class="breadcrumb-sep">//</span>
          <a href="/media" class="breadcrumb-link">
            MEDIA
          </a>
          <span class="breadcrumb-sep">//</span>
          <span class="breadcrumb-current">IKIGAI</span>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             HERO: THE SACRED BREATH ONBOARDING ("TAKE A BREATH")
             Directly inspired by The Sea We Breathe's opening ritual
             ══════════════════════════════════════════════════════════ -->
        <header class="swb-hero-portal anim-hero" aria-labelledby="swb-main-title">
          <div class="swb-hero-meta">
            <span class="swb-micro-chip">
              <Loader />
              THE SACRED CENTER // HARMONY OF MATTER & SPIRIT // REASON FOR BEING
            </span>
            <span class="themeless-indicator">
              <span>CIRCLE OF STILLNESS</span>
              <span>THEMELESS MONASTIC VOID</span>
            </span>
          </div>

          <h1 id="swb-main-title" class="swb-hero-headline">
            Ikigai // The Sea of Consciousness<span class="caret" aria-hidden="true"></span>
          </h1>
          <p class="swb-hero-tagline">
            A 15-minute sacred immersion into Mind, Body, and Heart. Rooted in authentic Japanese
            contentment, the synthesis of material competence with inner stillness, and the art of
            living with genuine religiousness.
          </p>

          <!-- ── Guided Breathing Conduit (Inhale 4s -> Hold 4s -> Exhale 4s -> Hold 4s) ── -->
          <div class="swb-breathing-conduit glass-panel" id="breathingConduit">
            <div class="conduit-header">
              <div class="conduit-title-wrap">
                <span class="conduit-dot" aria-hidden="true"></span>
                <span class="conduit-title">TAKE A BREATH // CONSCIOUS BREATHING</span>
              </div>
              <span class="conduit-badge">SYNCHRONIZE BIOLOGY</span>
            </div>

            <div class="conduit-orb-stage">
              <div class="conduit-pulse-halo" id="conduitHalo" aria-hidden="true"></div>
              <div class="conduit-core-orb" id="conduitOrb">
                <span class="conduit-phase" id="conduitPhase">
                  INHALE
                </span>
                <span class="conduit-sec" id="conduitSec">
                  4s
                </span>
              </div>
            </div>

            <p class="conduit-caption">
              Deep diaphragmatic rhythm:{' '}
              <strong>Inhale (4s) • Stillness (4s) • Exhale (4s) • Emptiness (4s)</strong>.
              Dissolving the frantic noise of survival into the calm waters of conscious presence.
            </p>
          </div>
        </header>

        <!-- ══════════════════════════════════════════════════════════
             CHAPTER 01: THE CIRCUMFERENCE & THE CENTER
             ══════════════════════════════════════════════════════════ -->
        <article class="swb-chapter-card glass-panel" id="journey-center">
          <div class="chapter-card-top">
            <div class="chapter-badge-cluster">
              <span class="chapter-num">JOURNEY 01</span>
              <span class="chapter-subtag">THE INNER AXIS</span>
            </div>
            <span class="chapter-origin">
              DISCOURSES ON CONSCIOUSNESS // CIRCUMFERENCE &amp; CENTER
            </span>
          </div>

          <h2 class="chapter-headline">The Circumference &amp; The Sacred Center</h2>

          <blockquote class="swb-quote">
            “Religions belong to the circumference; religiousness belongs to the center. At the
            circumference there are dogmas, rituals, creeds, and theological debates. At the center
            there is only the silent witness, undivided awareness, and existential gratitude.”
          </blockquote>

          <div class="chapter-body-split">
            <div class="split-column">
              <h3 class="split-title">The Circumference (Dogma &amp; Separation)</h3>
              <p class="split-desc">
                Dogmatic creeds, sectarian labels, and intellectual debates remain at the outer edge
                of life. They turn the sacred into transactional rituals and performative identity.
                Seeking status, arguing doctrines, and clinging to rigid beliefs keeps the mind
                restless on the periphery of the wheel.
              </p>
            </div>
            <div class="split-column">
              <h3 class="split-title">The Center (The Witness &amp; Silent Presence)</h3>
              <p class="split-desc">
                At the center, there is no dogma. There is only the silent witness—unshakable
                awareness, deep reverence for life, and quiet gratitude. Here, the effortless
                non-striving of Lao Tzu (Wu Wei), the silent meditation of Gautama Buddha, the inner
                kingdom of Jesus, the detached action of Krishna, and the ecstatic devotion of Rumi
                meet in one shared sea of consciousness.
              </p>
            </div>
          </div>

          <div class="chapter-footer-insight">
            <span class="insight-label">SANCTUARY AXIOM:</span>
            <span class="insight-text">
              Live with religiousness, not dogma. Practice everything out of gratitude, never out of
              fear.
            </span>
          </div>
        </article>

        <!-- ══════════════════════════════════════════════════════════
             CHAPTER 02: SYNTHESIS OF MATTER & SPIRIT (EARTH & SKY)
             ══════════════════════════════════════════════════════════ -->
        <article class="swb-chapter-card glass-panel" id="journey-synthesis">
          <div class="chapter-card-top">
            <div class="chapter-badge-cluster">
              <span class="chapter-num">JOURNEY 02</span>
              <span class="chapter-subtag">MATTER &amp; SPIRIT</span>
            </div>
            <span class="chapter-origin">PHILOSOPHICAL INQUIRY // TRANSCENDING POVERTY</span>
          </div>

          <h2 class="chapter-headline">Matter &amp; Spirit // Freedom from Scarcity</h2>

          <blockquote class="swb-quote">
            “Poverty of any kind cannot lead to genuine spiritual flowering. Material competence and
            worldly excellence allow you to ask the right questions, rather than remaining trapped
            in the primal panic of survival.”
          </blockquote>

          <div class="synthesis-grid">
            <div class="synthesis-box">
              <span class="synthesis-tag">EARTH // CRAFT &amp; WORLDLY MASTERY</span>
              <h3 class="synthesis-name">Vitality, Craft &amp; Material Competence</h3>
              <p class="synthesis-text">
                Living fully on the earth: building software, mastering architecture, enjoying
                music, physical vitality, and fine craftsmanship. Ascetic self-denial is not
                holiness. Thriving materially removes survival panic and provides the foundation for
                higher existential inquiry.
              </p>
            </div>
            <div class="synthesis-box">
              <span class="synthesis-tag">SKY // INNER STILLNESS &amp; MEDITATION</span>
              <h3 class="synthesis-name">Silence, Transcendence &amp; Meditative Grace</h3>
              <p class="synthesis-text">
                The inner witness ascends into quietude. Pure awareness, freedom from compulsive
                desire, and unconditional compassion. When grounded craftsmanship meets meditative
                depth, one becomes a whole human: hands active in the world, consciousness rooted in
                silence.
              </p>
            </div>
            <div class="synthesis-box highlight-box">
              <span class="synthesis-tag">THE REVELATION // SOVEREIGN MASTERY</span>
              <h3 class="synthesis-name">Discipline as Sovereign Freedom</h3>
              <p class="synthesis-text">
                Authentic discipline is never guilt or ascetic punishment. It is the joyful,
                sovereign devotion that liberates you from intellectual scarcity, material
                desperation, and mental chaos. Practice discipline out of freedom and gratitude.
              </p>
            </div>
          </div>
        </article>

        <!-- ══════════════════════════════════════════════════════════
             CHAPTER 03: THE 5 AUTHENTIC PILLARS OF IKIGAI (KEN MOGI)
             ══════════════════════════════════════════════════════════ -->
        <article class="swb-chapter-card glass-panel" id="journey-pillars">
          <div class="chapter-card-top">
            <div class="chapter-badge-cluster">
              <span class="chapter-num">JOURNEY 03</span>
              <span class="chapter-subtag">FIVE PILLARS OF IKIGAI</span>
            </div>
            <span class="chapter-origin">JAPANESE TRADITION // KEN MOGI'S FIVE PILLARS</span>
          </div>

          <h2 class="chapter-headline">
            The Five Pillars of Ikigai // Beyond the Venn Diagram Myth
          </h2>

          <p class="swb-lead-text">
            The popular four-circle Venn diagram overlapping <em>“what you love,”</em>{' '}
            <em>“what you are good at,”</em> <em>“what the world needs,”</em> and{' '}
            <em>“what you can get paid for”</em> was created in 2011 by Spanish author Andrés
            Zuzunaga as a personal purpose diagram, and later labeled "Ikigai" by Western bloggers
            in 2014. In authentic Japanese culture dating back to the Heian period (794–1185),
            Ikigai (derived from the words for life, <em>iki</em>, and value or worth, <em>gai</em>)
            is not a career monetization formula. As documented by neuroscientist Ken Mogi in{' '}
            <em>The Little Book of Ikigai</em>, it is the humble, everyday art of waking up with joy
            and contentment.
          </p>

          <div class="swb-pillars-carousel">
            <div class="swb-pillar-card">
              <div class="p-card-top">
                <span class="p-num">01</span>
                <span class="p-subtag">PILLAR ONE</span>
              </div>
              <h3 class="p-title">Starting Small</h3>
              <p class="p-desc">
                Humble devotion to detail and craftsmanship without demanding immediate praise or
                applause. The craftsman who polishes a joint until it is invisible; the engineer who
                refines an internal primitive. Greatness begins with humility in small devotions.
              </p>
            </div>

            <div class="swb-pillar-card">
              <div class="p-card-top">
                <span class="p-num">02</span>
                <span class="p-subtag">PILLAR TWO</span>
              </div>
              <h3 class="p-title">Releasing Yourself</h3>
              <p class="p-desc">
                Surrendering the anxious, self-conscious ego. When the craftsman disappears entirely
                into the work, only the craft remains. Deep flow is the sweet relief from the
                constant burden of self-importance.
              </p>
            </div>

            <div class="swb-pillar-card">
              <div class="p-card-top">
                <span class="p-num">03</span>
                <span class="p-subtag">PILLAR THREE</span>
              </div>
              <h3 class="p-title">Harmony &amp; Sustainability</h3>
              <p class="p-desc">
                Living in balance with your biological rhythms, the environment, and the people
                around you. Authentic discipline does not lead to burnout; it sustains itself
                rhythmically like clean water flowing down a mountain.
              </p>
            </div>

            <div class="swb-pillar-card">
              <div class="p-card-top">
                <span class="p-num">04</span>
                <span class="p-subtag">PILLAR FOUR</span>
              </div>
              <h3 class="p-title">The Joy of Little Things</h3>
              <p class="p-desc">
                Finding gratitude in everyday sensory moments: a hot cup of green tea in the morning
                quiet; the crisp feel of fresh air; rain falling against glass. Contentment is not
                found in an elusive, dramatic summit; it is woven into the texture of ordinary life.
              </p>
            </div>

            <div class="swb-pillar-card">
              <div class="p-card-top">
                <span class="p-num">05</span>
                <span class="p-subtag">PILLAR FIVE</span>
              </div>
              <h3 class="p-title">Being Here and Now</h3>
              <p class="p-desc">
                Recognizing that this exact moment will never occur again. Anchoring awareness
                completely in the immediate present. The past is a memory, the future is an
                anticipation; only the present moment is alive.
              </p>
            </div>
          </div>
        </article>

        <!-- ══════════════════════════════════════════════════════════
             CHAPTER 04: THE TRIAD IN SACRED SYNC (MIND, BODY, HEART)
             ══════════════════════════════════════════════════════════ -->
        <article class="swb-chapter-card glass-panel" id="journey-triad">
          <div class="chapter-card-top">
            <div class="chapter-badge-cluster">
              <span class="chapter-num">JOURNEY 04</span>
              <span class="chapter-subtag">TRIAD IN SYNC</span>
            </div>
            <span class="chapter-origin">DAILY CONSECRATION CAPSULE</span>
          </div>

          <h2 class="chapter-headline">The Triad in Sacred Sync // Mind, Body &amp; Heart</h2>

          <p class="swb-lead-text">
            Rather than maintaining an anxiety-fueled checklist, dedicate three conscious offerings
            of your vital energy each day. One for the intellect, one for the physical vessel, and
            one for the heart. Persists seamlessly in your browser.
          </p>

          <div class="swb-consecration-matrix" id="consecrationMatrix">
            <div class="matrix-card" data-center="mind">
              <div class="matrix-card-header">
                <span class="center-title">MIND // INTELLECT</span>
                <span class="center-archetype">AWARENESS &amp; FOCUS</span>
              </div>
              <p class="matrix-subtitle">
                One noble intellectual craft or engineering challenge pursued with undivided focus.
              </p>
              <div class="matrix-input-row">
                <button
                  type="button"
                  class="swb-checkbox"
                  aria-label="Mark Mind consecration complete"
                >
                  <span class="cb-check"></span>
                </button>
                <input
                  type="text"
                  class="swb-input"
                  id="consecrateMindInput"
                  value="Refactor distributed systems architecture with calm, immaculate clarity"
                  placeholder="Primary engineering / intellectual offering..."
                />
              </div>
            </div>

            <div class="matrix-card" data-center="body">
              <div class="matrix-card-header">
                <span class="center-title">BODY // VESSEL</span>
                <span class="center-archetype">SOMA &amp; VITALITY</span>
              </div>
              <p class="matrix-subtitle">
                Nourishing the physical vessel with vitality, fresh hydration, and deliberate
                movement.
              </p>
              <div class="matrix-input-row">
                <button
                  type="button"
                  class="swb-checkbox"
                  aria-label="Mark Body consecration complete"
                >
                  <span class="cb-check"></span>
                </button>
                <input
                  type="text"
                  class="swb-input"
                  id="consecrateBodyInput"
                  value="Hydration armed, brisk outdoor walk, deep spinal posture, physical vitality"
                  placeholder="Physical temple offering (movement, nutrition, breath)..."
                />
              </div>
            </div>

            <div class="matrix-card" data-center="heart">
              <div class="matrix-card-header">
                <span class="center-title">HEART // DEVOTION</span>
                <span class="center-archetype">DEVOTION &amp; GRATITUDE</span>
              </div>
              <p class="matrix-subtitle">
                Gratitude without transaction; warmth, generosity, and unconditional reverence.
              </p>
              <div class="matrix-input-row">
                <button
                  type="button"
                  class="swb-checkbox"
                  aria-label="Mark Heart consecration complete"
                >
                  <span class="cb-check"></span>
                </button>
                <input
                  type="text"
                  class="swb-input"
                  id="consecrateHeartInput"
                  value="Express unconditional thankfulness to someone without expecting a reply"
                  placeholder="Sacred offering of heart, gratitude, or kindness..."
                />
              </div>
            </div>
          </div>
        </article>

        <!-- ══════════════════════════════════════════════════════════
             CHAPTER 05: THE DHYANA ENGINE & 15-MINUTE IMMERSION
             ══════════════════════════════════════════════════════════ -->
        <article class="swb-chapter-card glass-panel" id="journey-dhyana">
          <div class="chapter-card-top">
            <div class="chapter-badge-cluster">
              <span class="chapter-num">JOURNEY 05</span>
              <span class="chapter-subtag">PRESENCE ENGINE</span>
            </div>
            <span class="chapter-origin">PRESENCE &amp; ACOUSTIC SANCTUARY</span>
          </div>

          <h2 class="chapter-headline">The Dhyana Engine // 15-Minute Sacred Immersion</h2>

          <p class="swb-lead-text">
            Timebox your flow state in sacred stillness. Synthesized Tibetan singing bowls mark
            phase transitions. Auto-syncs with atmospheric background soundscapes to melt away all
            mental friction.
          </p>

          <!-- Cadence selection -->
          <div class="swb-cadence-group">
            <span class="cadence-title">INTERVAL CADENCE &amp; RHYTHM:</span>
            <div class="cadence-grid" role="group" aria-label="Select Cadence Preset">
              {cadences.map((cad, i) => (
                <button
                  type="button"
                  class:list={['swb-cadence-pill', { active: i === 0 }]}
                  data-preset-id={cad.id}
                  data-focus-min={cad.focusMin}
                  data-break-min={cad.breakMin}
                  data-tag={cad.tag}
                  title={`Select ${cad.name}`}
                >
                  <span class="c-subtag">{cad.cadenceLabel}</span>
                  <span class="c-name">{cad.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- The Dial & Meter -->
          <div class="swb-dial-stage">
            <div class="swb-enso-dial">
              <svg class="enso-dial-svg" viewBox="0 0 220 220" aria-hidden="true">
                <circle class="enso-dial-track" cx="110" cy="110" r="96"></circle>
                <circle
                  class="enso-dial-progress"
                  id="dhyanaProgressMeter"
                  cx="110"
                  cy="110"
                  r="96"
                ></circle>
              </svg>
              <div class="enso-dial-center">
                <span class="dhyana-time-readout" id="dhyanaTimeReadout">
                  50:00
                </span>
                <span class="dhyana-phase-text" id="dhyanaPhaseText">
                  CONSCIOUS WORK
                </span>
              </div>
            </div>

            <!-- Lotus cycle dots -->
            <div class="swb-cycle-stats">
              <div class="swb-lotus-row" id="swbLotusRow" aria-label="Completed cycles">
                <span class="swb-lotus-dot active" title="Cycle 1"></span>
                <span class="swb-lotus-dot" title="Cycle 2"></span>
                <span class="swb-lotus-dot" title="Cycle 3"></span>
                <span class="swb-lotus-dot" title="Cycle 4"></span>
              </div>
              <span class="swb-cycle-readout" id="swbCycleReadout">
                CYCLE 1 / 4 • 0 SESSIONS COMPLETED TODAY
              </span>
            </div>
          </div>

          <!-- Controls Bar -->
          <div class="swb-controls-bar">
            <button
              type="button"
              class="swb-btn swb-btn-primary"
              id="dhyanaToggleBtn"
              aria-label="Start or pause interval"
            >
              <span id="dhyanaPlayIcon" aria-hidden="true">
                ▶
              </span>
              <span id="dhyanaToggleLabel">ENTER PRESENCE</span>
            </button>

            <button
              type="button"
              class="swb-btn swb-btn-secondary"
              id="dhyanaResetBtn"
              aria-label="Reset interval"
              title="Reset current interval"
            >
              <span>↺ RESET</span>
            </button>

            <button
              type="button"
              class="swb-btn swb-btn-secondary"
              id="dhyanaSkipBtn"
              aria-label="Skip to break or focus"
              title="Shift between presence and rest"
            >
              <span>⏭ SHIFT PHASE</span>
            </button>

            <button
              type="button"
              class="swb-btn swb-btn-chime"
              id="dhyanaBowlTestBtn"
              aria-label="Sound Tibetan Singing Bowl"
              title="Play resonant Tibetan singing bowl chime"
            >
              <span>SOUND BOWL</span>
            </button>
          </div>

          <!-- Soundscape Selector -->
          <div class="swb-soundscape-section">
            <div class="soundscape-header">
              <div class="soundscape-title-wrap">
                <span class="soundscape-title">ACOUSTIC SANCTUARY // BACKGROUND STREAM</span>
                <span class="soundscape-badge" id="swbAudioBadge">
                  AMB // PIANO
                </span>
              </div>
              <label
                class="swb-sync-label"
                title="Play focus stream during presence, pause during rest"
              >
                <input type="checkbox" id="swbAudioSyncCheckbox" checked />
                <span class="sync-slider"></span>
                <span>AUTO-SYNC WITH TIMER</span>
              </label>
            </div>

            <div
              class="soundscape-grid"
              role="group"
              aria-label="Select Focus Background Soundscape"
            >
              {sanctuaryTracks.map((trk) => (
                <button
                  type="button"
                  class:list={['soundscape-card', { active: trk.id === 'lofi-piano' }]}
                  data-track-id={trk.id}
                  data-yt-id={trk.ytId || ''}
                  data-name={trk.name}
                  data-code={trk.code}
                  title={trk.desc}
                >
                  <div class="sc-card-top">
                    <span class="sc-code">{trk.code}</span>
                  </div>
                  <span class="sc-name">{trk.name}</span>
                  <span class="sc-desc">{trk.desc}</span>
                  <div class="sc-eq" aria-hidden="true">
                    <span class="sc-bar"></span>
                    <span class="sc-bar"></span>
                    <span class="sc-bar"></span>
                  </div>
                </button>
              ))}
            </div>
          </div>
        </article>
      </main>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       THE ZEN GATEKEEPER OVERLAY (15-MIN IMMERSION LOCK ENFORCEMENT)
       User cannot leave the page for 15 mins unless doing a hard reload
       ══════════════════════════════════════════════════════════ -->
  <div
    class="zen-gatekeeper-modal"
    id="zenGatekeeperModal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div class="zen-gatekeeper-card">
      <svg class="gatekeeper-enso enso-svg" viewBox="0 0 100 100" aria-hidden="true">
        <circle
          class="enso-outer-ring"
          cx="50"
          cy="50"
          r="42"
          stroke="var(--accent)"
          stroke-width="3"
          fill="none"
          stroke-dasharray="230 35"
          stroke-linecap="round"
        ></circle>
        <circle class="enso-center-dot" cx="50" cy="50" r="5" fill="var(--accent)"></circle>
      </svg>

      <h3 class="gatekeeper-title">IMMERSION IN PROGRESS // SACRED TIMEBOX</h3>

      <blockquote class="gatekeeper-quote">
        “You entered the sacred sanctuary of Ikigai. Mind, Body, and Heart require at least 15
        minutes of undivided presence. There is no escaping the present moment — except via Nuclear
        Hard Reload.”
      </blockquote>

      <div class="gatekeeper-timer-cluster">
        <span class="gatekeeper-time-digits" id="gatekeeperTimeDigits">
          14:52
        </span>
        <span class="gatekeeper-time-label">REMAINING IN SACRED IMMERSION</span>
      </div>

      <div class="gatekeeper-actions">
        <button type="button" class="gatekeeper-stay-btn" id="gatekeeperStayBtn">
          <span>REMAIN IN PRESENCE (CONTINUE)</span>
        </button>
        <button type="button" class="gatekeeper-purge-btn" id="gatekeeperPurgeBtn">
          <span>BREAK VESSEL // HARD RELOAD</span>
        </button>
      </div>
    </div>
  </div>

  <ChromeFooter />
</BaseLayout>

<!-- Client Script for Immersion Lock, Breathing, Soundscapes, and Waypoint Navigation -->
<script>
  interface Cadence {
    id: string;
    focusMin: number;
    breakMin: number;
    tag: string;
  }

  class IkigaiSanctuaryEngine {
    private currentCadence: Cadence = {
      id: 'deep-presence',
      focusMin: 50,
      breakMin: 10,
      tag: 'DEEP WORK',
    };

    private isRunning = false;
    private phase: 'focus' | 'break' = 'focus';
    private remainingSeconds = 50 * 60;
    private totalSeconds = 50 * 60;
    private timerInterval: number | null = null;
    private cycleIndex = 1;
    private completedCyclesToday = 0;
    private audioCtx: AudioContext | null = null;

    private activeTrackId = 'lofi-piano';
    private autoSyncAudio = true;

    // 15-Minute Immersion Lock
    private immersionEndTime = 0;
    private immersionInterval: number | null = null;
    private isImmersionLocked = true;
    private breathInterval: number | null = null;

    constructor() {
      this.init();
    }

    private init() {
      this.lockThemelessMode();
      this.initImmersionLock();
      this.initBreathingPacer();
      this.initWaypointRail();
      this.attachEvents();
      this.restorePreferences();
      this.updateDisplay();
      this.listenToGlobalAudio();
    }

    /**
     * Enforce themeless Zen Sanctuary palette across the page
     * Permanently lock theme buttons while on /ikigai
     */
    private lockThemelessMode() {
      document.documentElement.setAttribute('data-theme', 'zen-sanctuary');
      document.body.classList.add('is-ikigai-sanctuary');

      // Intercept any click on theme switchers
      const handleThemeLockClick = (e: MouseEvent) => {
        const target = (e.target as HTMLElement).closest(
          '.theme-toggle, .palette-btn, [data-set-theme], .mobile-theme-toggle',
        );
        if (target) {
          e.preventDefault();
          e.stopPropagation();
          this.showZenToast('The center has no theme. The witness has no color.');
        }
      };

      document.addEventListener('click', handleThemeLockClick, true);
    }

    private showZenToast(message: string) {
      let toast = document.getElementById('zenNotificationToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'zenNotificationToast';
        toast.style.cssText = `
          position: fixed;
          bottom: 24px;
          left: 50%;
          transform: translateX(-50%) translateY(20px);
          padding: 8px 18px;
          border-radius: 9999px;
          background: rgba(14, 13, 18, 0.95);
          border: 1px solid rgba(212, 163, 89, 0.5);
          box-shadow: 0 8px 32px rgba(0,0,0,0.8), 0 0 16px rgba(212, 163, 89, 0.25);
          font-family: var(--font-mono);
          font-size: 10.5px;
          letter-spacing: 0.12em;
          color: #d4a359;
          z-index: 10000;
          opacity: 0;
          transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
          pointer-events: none;
        `;
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.style.opacity = '1';
      toast.style.transform = 'translateX(-50%) translateY(0)';
      setTimeout(() => {
        if (toast) {
          toast.style.opacity = '0';
          toast.style.transform = 'translateX(-50%) translateY(20px)';
        }
      }, 3000);
    }

    /**
     * 15-Minute Sacred Immersion Lock
     * Prevents user from navigating away before 15 mins without a hard reload
     */
    private initImmersionLock() {
      const IMMERSION_DURATION_MS = 15 * 60 * 1000; // 15 minutes
      const savedEnd = sessionStorage.getItem('ikigai_immersion_end');

      if (savedEnd) {
        const parsed = parseInt(savedEnd, 10);
        if (parsed > Date.now()) {
          this.immersionEndTime = parsed;
        } else {
          // Restart fresh 15-min immersion
          this.immersionEndTime = Date.now() + IMMERSION_DURATION_MS;
          sessionStorage.setItem('ikigai_immersion_end', String(this.immersionEndTime));
        }
      } else {
        this.immersionEndTime = Date.now() + IMMERSION_DURATION_MS;
        sessionStorage.setItem('ikigai_immersion_end', String(this.immersionEndTime));
      }

      this.updateImmersionReadouts();

      this.immersionInterval = window.setInterval(() => {
        this.updateImmersionReadouts();
      }, 1000);

      // Intercept navigation links
      document.addEventListener(
        'click',
        (e: MouseEvent) => {
          const anchor = (e.target as HTMLElement).closest<HTMLAnchorElement>('a');
          if (!anchor) return;
          const href = anchor.getAttribute('href');
          if (!href) return;

          // Allow in-page anchor jumps (#journey-...)
          if (href.startsWith('#') || href.startsWith('/ikigai#')) return;

          // If still within 15 mins, intercept and trigger gatekeeper modal!
          if (Date.now() < this.immersionEndTime) {
            e.preventDefault();
            e.stopPropagation();
            this.openGatekeeperModal();
          }
        },
        true,
      );

      // Intercept browser tab close or reload
      window.addEventListener('beforeunload', (e) => {
        if (Date.now() < this.immersionEndTime) {
          e.preventDefault();
        }
      });
    }

    private updateImmersionReadouts() {
      const remainingMs = Math.max(0, this.immersionEndTime - Date.now());
      const totalSec = Math.floor(remainingMs / 1000);
      const min = Math.floor(totalSec / 60);
      const sec = totalSec % 60;
      const timeStr = `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;

      const hudDigits = document.getElementById('hudCountdownReadout');
      const gatekeeperDigits = document.getElementById('gatekeeperTimeDigits');
      if (hudDigits) hudDigits.textContent = timeStr;
      if (gatekeeperDigits) gatekeeperDigits.textContent = timeStr;

      if (remainingMs <= 0 && this.isImmersionLocked) {
        this.isImmersionLocked = false;
        if (this.immersionInterval !== null) {
          clearInterval(this.immersionInterval);
          this.immersionInterval = null;
        }
        if (hudDigits) hudDigits.textContent = 'LIBERATED';
        this.playTibetanSingingBowl();
        this.showZenToast('15-Minute Consecration Complete. You are liberated.');
      }
    }

    private openGatekeeperModal() {
      const modal = document.getElementById('zenGatekeeperModal');
      if (modal) {
        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
      }
    }

    private closeGatekeeperModal() {
      const modal = document.getElementById('zenGatekeeperModal');
      if (modal) {
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    private triggerNuclearEscape() {
      // Direct hard reload purge invoking the hard-reload.ts engine
      const purgeBtn =
        document.getElementById('footerReloadBtn') || document.getElementById('hardReloadBtn');
      if (purgeBtn) {
        purgeBtn.click();
      } else {
        sessionStorage.clear();
        localStorage.removeItem('ikigai_immersion_end');
        window.location.href = '/?hard_reload=1';
      }
    }

    /**
     * Guided Breathing Conduit (Conscious Box Breathing)
     */
    private initBreathingPacer() {
      const conduit = document.getElementById('breathingConduit');
      const phaseEl = document.getElementById('conduitPhase');
      const secEl = document.getElementById('conduitSec');
      if (!conduit || !phaseEl || !secEl) return;

      const phases = [
        { name: 'INHALE', className: 'breathing-inhale' },
        { name: 'HOLD', className: 'breathing-hold' },
        { name: 'EXHALE', className: 'breathing-exhale' },
        { name: 'STILLNESS', className: 'breathing-stillness' },
      ];

      let currentPhaseIdx = 0;
      let count = 4;

      const applyPhase = (idx: number) => {
        phases.forEach((p) => conduit.classList.remove(p.className));
        conduit.classList.add(phases[idx].className);
        phaseEl.textContent = phases[idx].name;
      };

      applyPhase(0);

      this.breathInterval = window.setInterval(() => {
        count--;
        if (count <= 0) {
          currentPhaseIdx = (currentPhaseIdx + 1) % 4;
          count = 4;
          applyPhase(currentPhaseIdx);
        }
        secEl.textContent = `${count}s`;
      }, 1000);
    }

    /**
     * Smooth Waypoint Rail Tracking
     */
    private initWaypointRail() {
      const links = document.querySelectorAll<HTMLAnchorElement>('.rail-node-link');
      const counterEl = document.getElementById('railActiveStep');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              links.forEach((l, idx) => {
                const isActive = l.getAttribute('data-target') === id;
                l.classList.toggle('active', isActive);
                if (isActive && counterEl) {
                  counterEl.textContent = `${String(idx + 1).padStart(2, '0')} / 05`;
                }
              });
            }
          });
        },
        { threshold: 0.35 },
      );

      document.querySelectorAll('.swb-chapter-card').forEach((sec) => observer.observe(sec));
    }

    private restorePreferences() {
      try {
        const savedCadence = localStorage.getItem('ikigai_cadence');
        if (savedCadence) {
          const parsed = JSON.parse(savedCadence);
          if (parsed?.focusMin && parsed?.breakMin) {
            this.currentCadence = parsed;
            this.totalSeconds = this.currentCadence.focusMin * 60;
            this.remainingSeconds = this.totalSeconds;
          }
        }

        const savedCycles = localStorage.getItem('ikigai_cycles_completed');
        if (savedCycles) {
          this.completedCyclesToday = parseInt(savedCycles, 10) || 0;
        }

        const savedAudio = localStorage.getItem('ikigai_music_id');
        if (savedAudio) {
          this.activeTrackId = savedAudio;
        }

        // Restore daily offerings
        const savedOfferings = localStorage.getItem('ikigai_matrix_offerings');
        if (savedOfferings) {
          const data: { [key: string]: { text: string; done: boolean } } =
            JSON.parse(savedOfferings);
          ['mind', 'body', 'heart'].forEach((key) => {
            const card = document.querySelector(`.matrix-card[data-center="${key}"]`);
            if (card && data[key]) {
              const input = card.querySelector<HTMLInputElement>('.swb-input');
              const cb = card.querySelector<HTMLButtonElement>('.swb-checkbox');
              if (input) input.value = data[key].text;
              if (data[key].done) {
                cb?.classList.add('is-checked');
                input?.classList.add('is-done');
              }
            }
          });
        }
      } catch {}
    }

    private saveOfferings() {
      try {
        const data: { [key: string]: { text: string; done: boolean } } = {};
        ['mind', 'body', 'heart'].forEach((key) => {
          const card = document.querySelector(`.matrix-card[data-center="${key}"]`);
          if (card) {
            const input = card.querySelector<HTMLInputElement>('.swb-input');
            const cb = card.querySelector<HTMLButtonElement>('.swb-checkbox');
            data[key] = {
              text: input?.value || '',
              done: Boolean(cb?.classList.contains('is-checked')),
            };
          }
        });
        localStorage.setItem('ikigai_matrix_offerings', JSON.stringify(data));
      } catch {}
    }

    private attachEvents() {
      // Gatekeeper buttons
      const stayBtn = document.getElementById('gatekeeperStayBtn');
      const purgeEscapeBtn = document.getElementById('gatekeeperPurgeBtn');
      const hudPurgeBtn = document.getElementById('hudPurgeEscapeBtn');

      stayBtn?.addEventListener('click', () => this.closeGatekeeperModal());
      purgeEscapeBtn?.addEventListener('click', () => this.triggerNuclearEscape());
      hudPurgeBtn?.addEventListener('click', () => this.triggerNuclearEscape());

      // Dhyana Timer buttons
      const toggleBtn = document.getElementById('dhyanaToggleBtn');
      const resetBtn = document.getElementById('dhyanaResetBtn');
      const skipBtn = document.getElementById('dhyanaSkipBtn');
      const bowlBtn = document.getElementById('dhyanaBowlTestBtn');

      toggleBtn?.addEventListener('click', () => this.toggleDhyanaTimer());
      resetBtn?.addEventListener('click', () => this.resetDhyanaTimer());
      skipBtn?.addEventListener('click', () => this.skipDhyanaPhase());
      bowlBtn?.addEventListener('click', () => this.playTibetanSingingBowl());

      // Cadence pills
      const cadencePills = document.querySelectorAll<HTMLButtonElement>('.swb-cadence-pill');
      cadencePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const id = pill.getAttribute('data-preset-id') || 'deep-presence';
          const focusMin = parseInt(pill.getAttribute('data-focus-min') || '50', 10);
          const breakMin = parseInt(pill.getAttribute('data-break-min') || '10', 10);
          const tag = pill.getAttribute('data-tag') || 'DEEP WORK';

          this.selectCadence({ id, focusMin, breakMin, tag });

          cadencePills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
        });
      });

      // Soundscape cards
      const soundscapeCards = document.querySelectorAll<HTMLButtonElement>('.soundscape-card');
      soundscapeCards.forEach((card) => {
        card.addEventListener('click', () => {
          const trackId = card.getAttribute('data-track-id') || '';
          const ytId = card.getAttribute('data-yt-id') || '';
          const name = card.getAttribute('data-name') || '';
          const code = card.getAttribute('data-code') || '';

          this.selectSoundscape(trackId, ytId, name, code);

          soundscapeCards.forEach((c) => c.classList.remove('active'));
          card.classList.add('active');
        });
      });

      // Auto-sync audio checkbox
      const syncCb = document.getElementById('swbAudioSyncCheckbox') as HTMLInputElement | null;
      syncCb?.addEventListener('change', () => {
        this.autoSyncAudio = Boolean(syncCb.checked);
      });

      // Consecration inputs and checkboxes
      const matrixCards = document.querySelectorAll<HTMLElement>('.matrix-card');
      matrixCards.forEach((card) => {
        const cb = card.querySelector<HTMLButtonElement>('.swb-checkbox');
        const input = card.querySelector<HTMLInputElement>('.swb-input');

        cb?.addEventListener('click', () => {
          cb.classList.toggle('is-checked');
          input?.classList.toggle('is-done');
          this.playSolfeggioTone(528);
          this.saveOfferings();
        });

        input?.addEventListener('input', () => this.saveOfferings());
      });
    }

    private selectCadence(cadence: Cadence) {
      this.currentCadence = cadence;
      try {
        localStorage.setItem('ikigai_cadence', JSON.stringify(cadence));
      } catch {}

      this.pauseDhyanaTimer();
      this.phase = 'focus';
      this.totalSeconds = cadence.focusMin * 60;
      this.remainingSeconds = this.totalSeconds;
      this.updateDisplay();
    }

    private selectSoundscape(trackId: string, ytId: string, name: string, code: string) {
      this.activeTrackId = trackId;
      try {
        localStorage.setItem('ikigai_music_id', trackId);
      } catch {}

      const badge = document.getElementById('swbAudioBadge');
      if (badge) badge.textContent = `AMB // ${code}`;

      if (trackId === 'silent') {
        window.dispatchEvent(
          new CustomEvent('set-ambient-sound', {
            detail: { id: 'silent', code: 'OFF' },
          }),
        );
        const ambCtrl = (window as any).__ambientSoundController;
        ambCtrl?.pause();
        return;
      }

      window.dispatchEvent(
        new CustomEvent('set-ambient-sound', {
          detail: {
            id: trackId,
            ytId: ytId || undefined,
            name,
            code,
          },
        }),
      );
    }

    private toggleDhyanaTimer() {
      if (this.isRunning) {
        this.pauseDhyanaTimer();
      } else {
        this.startDhyanaTimer();
      }
    }

    private startDhyanaTimer() {
      this.isRunning = true;
      if (this.timerInterval !== null) {
        window.clearInterval(this.timerInterval);
      }

      this.timerInterval = window.setInterval(() => {
        this.tick();
      }, 1000);

      this.updateDisplay();

      if (this.autoSyncAudio && this.phase === 'focus' && this.activeTrackId !== 'silent') {
        const ambCtrl = (window as any).__ambientSoundController;
        ambCtrl?.play();
      }
    }

    private pauseDhyanaTimer() {
      this.isRunning = false;
      if (this.timerInterval !== null) {
        window.clearInterval(this.timerInterval);
        this.timerInterval = null;
      }
      this.updateDisplay();
    }

    private resetDhyanaTimer() {
      this.pauseDhyanaTimer();
      this.totalSeconds =
        (this.phase === 'focus' ? this.currentCadence.focusMin : this.currentCadence.breakMin) * 60;
      this.remainingSeconds = this.totalSeconds;
      this.updateDisplay();
    }

    private skipDhyanaPhase() {
      this.completeDhyanaPhase();
    }

    private tick() {
      if (this.remainingSeconds > 0) {
        this.remainingSeconds--;
        this.updateDisplay();
      } else {
        this.completeDhyanaPhase();
      }
    }

    private completeDhyanaPhase() {
      this.playTibetanSingingBowl();

      if (this.phase === 'focus') {
        this.phase = 'break';
        this.totalSeconds = this.currentCadence.breakMin * 60;
        this.remainingSeconds = this.totalSeconds;
        this.completedCyclesToday++;
        try {
          localStorage.setItem('ikigai_cycles_completed', String(this.completedCyclesToday));
        } catch {}

        this.cycleIndex = (this.cycleIndex % 4) + 1;

        if (this.autoSyncAudio) {
          const ambCtrl = (window as any).__ambientSoundController;
          ambCtrl?.pause();
        }
      } else {
        this.phase = 'focus';
        this.totalSeconds = this.currentCadence.focusMin * 60;
        this.remainingSeconds = this.totalSeconds;

        if (this.autoSyncAudio && this.activeTrackId !== 'silent') {
          const ambCtrl = (window as any).__ambientSoundController;
          ambCtrl?.play();
        }
      }

      this.updateDisplay();
    }

    private updateDisplay() {
      const min = Math.floor(this.remainingSeconds / 60);
      const sec = this.remainingSeconds % 60;
      const timeStr = `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;

      const digits = document.getElementById('dhyanaTimeReadout');
      const phaseText = document.getElementById('dhyanaPhaseText');
      if (digits) digits.textContent = timeStr;
      if (phaseText) {
        phaseText.textContent = this.phase === 'focus' ? 'CONSCIOUS WORK' : 'SACRED STILLNESS';
      }

      const toggleLabel = document.getElementById('dhyanaToggleLabel');
      const playIcon = document.getElementById('dhyanaPlayIcon');
      const toggleBtn = document.getElementById('dhyanaToggleBtn');

      if (toggleLabel)
        toggleLabel.textContent = this.isRunning
          ? 'PAUSE STILLNESS'
          : this.phase === 'focus'
            ? 'ENTER PRESENCE'
            : 'REST & REFLECT';
      if (playIcon) playIcon.textContent = this.isRunning ? '⏸' : '▶';
      toggleBtn?.classList.toggle('is-running', this.isRunning);

      // Dial meter (circumference 2 * PI * 96 = ~603.18)
      const meter = document.getElementById('dhyanaProgressMeter');
      if (meter) {
        const circumference = 2 * Math.PI * 96;
        const progress = this.totalSeconds > 0 ? this.remainingSeconds / this.totalSeconds : 0;
        const offset = circumference * (1 - progress);
        meter.style.strokeDasharray = `${circumference}`;
        meter.style.strokeDashoffset = `${offset}`;
        meter.classList.toggle('is-break-meter', this.phase === 'break');
      }

      // Lotus dots
      const lotusDots = document.querySelectorAll('#swbLotusRow .swb-lotus-dot');
      lotusDots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx < this.cycleIndex);
      });

      const cycleReadout = document.getElementById('swbCycleReadout');
      if (cycleReadout) {
        cycleReadout.textContent = `CYCLE ${this.cycleIndex} / 4 • ${this.completedCyclesToday} CONSECRATIONS COMPLETED TODAY`;
      }
    }

    /**
     * Synthesize Tibetan Singing Bowl (Multi-Harmonics at 216Hz/432Hz with natural exponential decay)
     */
    private playTibetanSingingBowl() {
      try {
        if (!this.audioCtx) {
          const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
          if (AudioCtxClass) this.audioCtx = new AudioCtxClass();
        }
        if (this.audioCtx) {
          if (this.audioCtx.state === 'suspended') this.audioCtx.resume();

          const now = this.audioCtx.currentTime;
          const fundamental = this.phase === 'focus' ? 216 : 288;
          const harmonics = [1, 2.76, 5.4, 8.9];
          const amplitudes = [0.24, 0.15, 0.09, 0.04];
          const decays = [4.5, 3.2, 2.4, 1.5];

          harmonics.forEach((ratio, i) => {
            const osc = this.audioCtx!.createOscillator();
            const gain = this.audioCtx!.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(fundamental * ratio, now);

            // Subtle natural vibrato
            const lfo = this.audioCtx!.createOscillator();
            const lfoGain = this.audioCtx!.createGain();
            lfo.frequency.value = 4.2 + i * 0.4;
            lfoGain.gain.value = 1.1;
            lfo.connect(osc.frequency);
            lfo.start(now);
            lfo.stop(now + decays[i]);

            gain.gain.setValueAtTime(0.001, now);
            gain.gain.exponentialRampToValueAtTime(amplitudes[i], now + 0.04);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + decays[i]);

            osc.connect(gain);
            gain.connect(this.audioCtx!.destination);

            osc.start(now);
            osc.stop(now + decays[i]);
          });
        }
      } catch {}
    }

    private playSolfeggioTone(freq = 528) {
      try {
        if (!this.audioCtx) {
          const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
          if (AudioCtxClass) this.audioCtx = new AudioCtxClass();
        }
        if (this.audioCtx) {
          if (this.audioCtx.state === 'suspended') this.audioCtx.resume();
          const now = this.audioCtx.currentTime;
          const osc = this.audioCtx.createOscillator();
          const gain = this.audioCtx.createGain();

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now);

          gain.gain.setValueAtTime(0.001, now);
          gain.gain.exponentialRampToValueAtTime(0.14, now + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.65);

          osc.connect(gain);
          gain.connect(this.audioCtx.destination);

          osc.start(now);
          osc.stop(now + 0.68);
        }
      } catch {}
    }

    private listenToGlobalAudio() {
      window.addEventListener('ambient-sound-changed', ((e: CustomEvent) => {
        const detail = e.detail;
        if (!detail?.track) return;
        const badge = document.getElementById('swbAudioBadge');
        if (badge) {
          badge.textContent = detail.isPlaying ? `AMB // ${detail.track.code}` : 'AMB // OFF';
        }
      }) as EventListener);
    }
  }

  // Fluid Particle Canvas for Zen Sanctuary
  const initZenFluidCanvas = () => {
    const canvas = document.getElementById('zenFluidCanvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const particles: { x: number; y: number; r: number; alpha: number; vx: number; vy: number }[] =
      [];
    for (let i = 0; i < 48; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 2 + 0.5,
        alpha: Math.random() * 0.4 + 0.1,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25 - 0.1,
      });
    }

    const render = () => {
      ctx.clearRect(0, 0, width, height);

      // Warm Kintsugi cosmic dust
      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(212, 163, 89, ${p.alpha})`;
        ctx.fill();
      });

      requestAnimationFrame(render);
    };

    render();
  };

  const startSanctuary = () => {
    if (document.getElementById('ikigaiSanctuaryRoot')) {
      new IkigaiSanctuaryEngine();
      initZenFluidCanvas();
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startSanctuary);
  } else {
    startSanctuary();
  }

  document.addEventListener('astro:page-load', startSanctuary);
</script>
