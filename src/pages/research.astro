---
/**
 * research.astro — Doctoral Research & Publications
 * Under active development.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromeNav from '../components/ChromeNav.astro';
import ChromeFooter from '../components/ChromeFooter.astro';
import UnderDevelopment from '../components/UnderDevelopment.astro';
---

<BaseLayout
  title="Research — Bernard Birendra Das"
  description="Research publications, preprints, and empirical investigations in distributed machine learning, continual memory systems, and neural optimization by Bernard Birendra Das."
>
  <canvas id="scene" transition:persist="terrain-canvas" aria-hidden="true"></canvas>

  <ChromeNav />

  <div class="page-grid">
    <!-- ─── LEFT: CONTENT COLUMN ─────────────────────────────── -->
    <main class="content-col" id="top">
      <UnderDevelopment
        moduleIndex="01"
        moduleKey="RESEARCH"
        title="Research & Publications"
        subtitle="Distributed Systems • Foundation Models • Continual Learning • Neural Optimization"
        category="RESEARCH & PREPRINTS"
        scopeSummary="Research manuscripts, preprints, empirical benchmarks, and open-source models are currently being prepared for release."
        tags={[
          'Distributed Optimization',
          'Foundation Models',
          'Continual Learning',
          'Muon Optimizer',
          'Privacy-Preserving AI',
        ]}
      />
    </main>

    <!-- ─── RIGHT: NEGATIVE SPACE SHOWING 3D TERRAIN ─────────── -->
    <div class="bg-col" aria-hidden="true"></div>
  </div>

  <ChromeFooter />

  <script>
    // Defer 3D terrain canvas
    const loadTerrain = () => {
      import('../scripts/terrain.ts');
    };
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadTerrain, { timeout: 1000 });
      } else {
        setTimeout(loadTerrain, 100);
      }
    }
  </script>
</BaseLayout>
