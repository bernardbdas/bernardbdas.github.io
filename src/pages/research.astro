---
/**
 * research.astro — Doctoral Research, Preprints & Literature
 * Focused on Bernard Birendra Das's PhD research in Federated Learning,
 * Foundation Models, Catastrophic Forgetting, and Test-Time Training.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromeNav from '../components/ChromeNav.astro';
import ChromeFooter from '../components/ChromeFooter.astro';
import ResearchHero from '../components/ResearchHero.astro';
import ResearchBenchmarkTable from '../components/ResearchBenchmarkTable.astro';
import ResearchPapersList from '../components/ResearchPapersList.astro';
import ResearchDictionary from '../components/ResearchDictionary.astro';
import MathInspectorModal from '../components/MathInspectorModal.astro';
import 'katex/dist/katex.min.css';
---

<BaseLayout
  title="Research // Distributed Systems & Optimization — Bernard Birendra Das"
  description="Research publications, preprints, and empirical benchmarks in distributed optimization, continual memory systems, and decentralized foundation models."
>
  <canvas id="scene" aria-hidden="true"></canvas>

  <ChromeNav />

  <div class="page-grid">
    <!-- ─── LEFT: CONTENT COLUMN ─────────────────────────────── -->
    <main class="content-col" id="top">
      <ResearchHero />
      <ResearchBenchmarkTable />
      <ResearchPapersList />
      <ResearchDictionary />
    </main>

    <!-- ─── RIGHT: NEGATIVE SPACE SHOWING 3D TERRAIN ─────────── -->
    <div class="bg-col" aria-hidden="true"></div>
  </div>

  <MathInspectorModal />

  <ChromeFooter />

  <script>
    // Defer 3D terrain canvas
    const loadTerrain = () => {
      import('../scripts/terrain.ts');
    };
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadTerrain, { timeout: 1000 });
      } else {
        setTimeout(loadTerrain, 100);
      }
    }
  </script>
</BaseLayout>
