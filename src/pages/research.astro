---
/**
 * research.astro — Doctoral Research, Preprints & Literature
 * Focused on Bernard Birendra Das's PhD research in Federated Learning,
 * Foundation Models, Catastrophic Forgetting, and Test-Time Training.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromeNav from '../components/ChromeNav.astro';
import ChromeFooter from '../components/ChromeFooter.astro';
import ResearchHero from '../components/ResearchHero.astro';
import ResearchVisualizer from '../components/ResearchVisualizer.astro';
import ResearchArchitecture from '../components/ResearchArchitecture.astro';
import ResearchPapersList from '../components/ResearchPapersList.astro';
---

<BaseLayout
  title="Research // Nested Federated Learning & Foundation Models — Bernard Birendra Das"
  description="Doctoral research portfolio of Bernard Birendra Das: Nested Federated Learning, Continuous Memory Systems (CMS-TTT), and FedM3 polar optimization at CHRIST (Deemed to be University)."
>
  <canvas id="scene" aria-hidden="true"></canvas>

  <ChromeNav />

  <div class="page-grid">
    <!-- ─── LEFT: CONTENT COLUMN ─────────────────────────────── -->
    <main class="content-col" id="top">
      <ResearchHero />
      <ResearchVisualizer />
      <ResearchArchitecture />
      <ResearchPapersList />
    </main>

    <!-- ─── RIGHT: NEGATIVE SPACE SHOWING 3D TERRAIN ─────────── -->
    <div class="bg-col" aria-hidden="true"></div>
  </div>

  <ChromeFooter />

  <script>
    // Defer 3D terrain canvas
    const loadTerrain = () => {
      import('../scripts/terrain.ts');
    };
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadTerrain, { timeout: 1000 });
      } else {
        setTimeout(loadTerrain, 100);
      }
    }
  </script>
</BaseLayout>
