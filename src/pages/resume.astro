---
/**
 * resume.astro — Dedicated Visual Resume Viewer
 * Source Serif Pro Edition with interactive PDF embed, fallback document view, and action controls.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChromeNav from '../components/ChromeNav.astro';
import ChromeFooter from '../components/ChromeFooter.astro';
import Loader from '../components/Loader.astro';
---

<BaseLayout
  title="Visual Resume — Bernard Birendra Das"
  description="Visual curriculum vitae of Bernard Birendra Das, AI & Machine Learning Engineer with 2+ years of production software engineering experience."
>
  <canvas id="scene" aria-hidden="true"></canvas>

  <ChromeNav />

  <div class="page-grid">
    <!-- ─── LEFT: CONTENT COLUMN ─────────────────────────────── -->
    <main class="content-col" id="top">
      <section class="section anim-s1" id="resume-viewer" aria-labelledby="resume-heading">
        <p class="micro-label">
          <Loader />
          Curriculum Vitae // Source Serif Pro Edition
        </p>

        <h1 class="section-heading" id="resume-heading">
          Visual Resume
        </h1>

        <p class="resume-intro">
          AI & Machine Learning Engineer • 2+ Years Software Engineering • Distributed Systems &
          MLOps Pipelines.
        </p>

        <div class="resume-actions">
          <a
            class="resume-action"
            href="/bernard-resume-sourceserifpro.pdf"
            download="Bernard_Birendra_Das_Resume.pdf"
          >
            Download PDF{' '}
            <span class="arrow" aria-hidden="true">
              ↓
            </span>
          </a>
          <a
            class="resume-action"
            href="/bernard-resume-sourceserifpro.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open Fullscreen{' '}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <a
            class="resume-action"
            href="https://github.com/bernardbdas/professional-portfolio"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub Source{' '}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <a class="resume-action" href="/">
            Return Home{' '}
            <span class="arrow" aria-hidden="true">
              ←
            </span>
          </a>
        </div>

        <!-- Embedded Document Viewer Card -->
        <div class="resume-viewer-card">
          <div class="viewer-bar">
            <div class="viewer-file-info">
              <span class="viewer-badge">PDF</span>
              <span class="viewer-filename">bernard-resume-sourceserifpro.pdf</span>
            </div>
            <span class="viewer-edition">SOURCE SERIF PRO EDITION</span>
          </div>

          <div class="pdf-wrapper">
            <!-- Desktop Native PDF Object Embed -->
            <div class="pdf-desktop-container">
              <object
                data="/bernard-resume-sourceserifpro.pdf#view=FitH"
                type="application/pdf"
                class="pdf-embed"
                title="Bernard Birendra Das Visual Resume"
              >
                <div class="pdf-fallback">
                  <img
                    src="/bernard-resume-preview.png"
                    alt="Bernard Birendra Das Visual Resume — Source Serif Pro Edition"
                    class="resume-doc-img"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </object>
            </div>

            <!-- Mobile Responsive Document View -->
            <div class="pdf-mobile-container">
              <div class="mobile-doc-toolbar">
                <span class="mobile-doc-hint">Pinch or zoom to inspect</span>
                <a
                  href="/bernard-resume-sourceserifpro.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mobile-raw-link"
                >
                  Open Raw PDF ↗
                </a>
              </div>
              <div class="mobile-doc-paper">
                <img
                  src="/bernard-resume-preview.png"
                  alt="Bernard Birendra Das Visual Resume — Source Serif Pro Edition"
                  class="resume-doc-img"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ─── RIGHT: NEGATIVE SPACE SHOWING 3D TERRAIN ─────────── -->
    <div class="bg-col" aria-hidden="true"></div>
  </div>

  <ChromeFooter />

  <script>
    const loadTerrain = () => {
      import('../scripts/terrain.ts');
    };
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadTerrain, { timeout: 1000 });
      } else {
        setTimeout(loadTerrain, 100);
      }
    }
  </script>
</BaseLayout>

<style>
  .resume-intro {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.5;
    margin-top: 8px;
    margin-bottom: 16px;
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  /* Document Viewer Card */
  .resume-viewer-card {
    width: 100%;
    margin-top: 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: rgba(var(--bg-rgb), 0.7);
    backdrop-filter: blur(8px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .viewer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: rgba(var(--bg-rgb), 0.85);
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono);
  }

  .viewer-file-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .viewer-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: var(--radius);
    background: rgba(var(--accent-rgb, 242, 149, 89), 0.15);
    color: var(--accent);
    border: 1px solid rgba(var(--accent-rgb, 242, 149, 89), 0.3);
    letter-spacing: 0.05em;
  }

  .viewer-filename {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
  }

  .viewer-edition {
    font-size: 11px;
    color: var(--ink-dim);
    letter-spacing: 0.04em;
  }

  .pdf-wrapper {
    width: 100%;
    height: 900px;
    background: #1c1e22;
    overflow: hidden;
  }

  .pdf-desktop-container {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pdf-mobile-container {
    display: none;
  }

  .pdf-embed {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .pdf-fallback {
    padding: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    overflow-y: auto;
  }

  .resume-doc-img {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
    border-radius: var(--radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  /* Responsive Mobile View */
  @media (max-width: 768px) {
    .pdf-wrapper {
      height: auto;
    }

    .pdf-desktop-container {
      display: none;
    }

    .pdf-mobile-container {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .mobile-doc-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 12px;
      background: rgba(var(--bg-rgb), 0.9);
      border-bottom: 1px solid var(--hairline);
      font-size: 11px;
      font-family: var(--font-mono);
    }

    .mobile-doc-hint {
      color: var(--ink-dim);
    }

    .mobile-raw-link {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
    }

    .mobile-doc-paper {
      padding: 12px;
      background: #14171c;
      display: flex;
      justify-content: center;
    }
  }
</style>
