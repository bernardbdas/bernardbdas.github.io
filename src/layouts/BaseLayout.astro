---
import { ClientRouter } from 'astro:transitions';
import WeatherDashboard from '../components/WeatherDashboard.astro';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://api4.ipify.org" />
    <link rel="dns-prefetch" href="https://ipwho.is" />
    <!-- Preconnect to YouTube streaming domains for SDR radio instant buffering -->
    <link rel="preconnect" href="https://www.youtube.com" crossorigin />
    <link rel="preconnect" href="https://www.google.com" crossorigin />
    <link rel="preconnect" href="https://googlevideo.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://yt3.ggpht.com" />
    <link rel="dns-prefetch" href="https://googlevideo.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,wght@0,400;1,400&display=swap"
    />
    <script is:inline>
      (function () {
        function getSolarDefault() {
          try {
            var lat = parseFloat(localStorage.getItem('client_geo_lat') || '');
            var lon = parseFloat(localStorage.getItem('client_geo_lon') || '');
            var now = new Date();
            var hours = now.getHours() + now.getMinutes() / 60;
            var sunrise = 6;
            var sunset = 18;

            if (!isNaN(lat) && !isNaN(lon)) {
              var start = new Date(now.getFullYear(), 0, 0);
              var diff = now - start;
              var dayOfYear = Math.floor(diff / 86400000);
              var declination =
                -23.44 * Math.cos(((2 * Math.PI) / 365) * (dayOfYear + 10)) * (Math.PI / 180);
              var latRad = lat * (Math.PI / 180);
              var cosH =
                (Math.sin((-0.833 * Math.PI) / 180) - Math.sin(latRad) * Math.sin(declination)) /
                (Math.cos(latRad) * Math.cos(declination));
              if (cosH >= -1 && cosH <= 1) {
                var hDeg = Math.acos(cosH) * (180 / Math.PI);
                var noon = 12 - lon / 15 - now.getTimezoneOffset() / 60;
                var half = hDeg / 15;
                var sr = noon - half;
                var ss = noon + half;
                if (sr >= 0 && ss <= 24 && sr < ss) {
                  sunrise = sr;
                  sunset = ss;
                }
              }
            }
            // Sunrise to Sunset: Light
            // Sunset to Sunrise: Amber ('dark')
            return hours >= sunrise && hours < sunset ? 'light' : 'dark';
          } catch {
            var h = new Date().getHours();
            return h >= 6 && h < 18 ? 'light' : 'dark';
          }
        }

        var saved = localStorage.getItem('theme');
        var manual = localStorage.getItem('theme_manual') === 'true';
        var valid = ['dark', 'light', 'blue', 'white', 'violet', 'emerald'];

        var activeTheme;
        if (manual && saved && valid.includes(saved) && saved !== 'auto') {
          activeTheme = saved;
        } else {
          // Dynamic default based upon local solar time of the user
          activeTheme = getSolarDefault();
        }

        document.documentElement.setAttribute('data-theme', activeTheme);

        // Register high-performance asset cache service worker if supported
        if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      })();
    </script>
  </head>
  <body>
    <!-- Persistent Ambient Audio & Stream Elements (preserved across all page navigations via Astro transitions) -->
    <audio
      id="ambient-audio-element"
      transition:persist="ambient-audio"
      loop
      preload="auto"
      aria-hidden="true"
    ></audio>
    <div
      id="ambient-stream-container"
      transition:persist="ambient-stream"
      style="position: fixed; width: 200px; height: 200px; bottom: 0; right: 0; opacity: 0.001; pointer-events: none; z-index: -9999; overflow: hidden;"
      aria-hidden="true"
    >
      <div id="ambient-yt-player"></div>
    </div>
    <!-- Seasonal Holiday Visual Effects Canvas (Christmas Snowfall & New Year Celebration Sparks) -->
    <canvas
      id="seasonal-canvas"
      transition:persist="seasonal-canvas"
      class="seasonal-canvas"
      aria-hidden="true"
    ></canvas>
    <!-- Atmospheric Weather HUD (Customizable, Draggable, Pinnable) -->
    <WeatherDashboard />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
