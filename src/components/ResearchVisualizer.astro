---
/**
 * ResearchVisualizer.astro — Interactive Empirical Visualizer & Synthesis Engine
 * Recreates the experimental trajectories, aggregation strategy matrix,
 * and non-IID classification analysis from Bernard's PhD research presentation.
 */
---

<div class="research-visualizer-section">
  <div class="sdr-section-title-row">
    <div>
      <h2 class="sdr-section-title">EMPIRICAL BENCHMARKS // ARCHITECTURAL SYNTHESIS</h2>
      <p class="section-micro-desc">
        Experimental validation across 100 edge clients on Non-IID data distributions (Christ
        University RAC-3)
      </p>
    </div>
    <span class="sdr-station-count-badge">EVALUATION BENCHMARK</span>
  </div>

  <!-- Interactive Visualizer Navigation Tabs -->
  <div class="visualizer-container">
    <div class="dev-card-corner-tl" aria-hidden="true"></div>
    <div class="dev-card-corner-br" aria-hidden="true"></div>

    <div class="viz-tabs-bar" role="tablist" aria-label="Research Visualizer Modes">
      <button
        type="button"
        class="viz-tab-btn active"
        id="viz-tab-curves"
        data-target="panel-curves"
        role="tab"
        aria-selected="true"
        aria-controls="panel-curves"
      >
        <span class="tab-marker">// 01</span>
        <span>CONVERGENCE &amp; ACCURACY TRAJECTORIES</span>
      </button>

      <button
        type="button"
        class="viz-tab-btn"
        id="viz-tab-matrix"
        data-target="panel-matrix"
        role="tab"
        aria-selected="false"
        aria-controls="panel-matrix"
      >
        <span class="tab-marker">// 02</span>
        <span>AGGREGATION STRATEGY COMPARISON</span>
      </button>

      <button
        type="button"
        class="viz-tab-btn"
        id="viz-tab-regimes"
        data-target="panel-regimes"
        role="tab"
        aria-selected="false"
        aria-controls="panel-regimes"
      >
        <span class="tab-marker">// 03</span>
        <span>NON-IID HETEROGENEITY REGIMES</span>
      </button>
    </div>

    <!-- ── PANEL 1: CONVERGENCE & ACCURACY CURVES ────────────────── -->
    <div
      class="viz-panel active"
      id="panel-curves"
      role="tabpanel"
      aria-labelledby="viz-tab-curves"
    >
      <div class="panel-header-row">
        <div>
          <h3 class="viz-panel-title">
            Federated Learning Trajectories across Communication Rounds
          </h3>
          <p class="viz-panel-subtitle">
            Vision Test-Time Training (TTT) + FedMuon vs. Vision Titans vs. FedAvg Baselines (Rounds
            1.0 – 5.0)
          </p>
        </div>

        <div class="metric-toggle-group">
          <button type="button" class="metric-toggle-btn active" id="btn-show-acc">
            ACCURACY (%)
          </button>
          <button type="button" class="metric-toggle-btn" id="btn-show-loss">
            GLOBAL LOSS
          </button>
        </div>
      </div>

      <!-- Vector SVG Chart Canvas -->
      <div class="chart-wrapper">
        <svg class="viz-svg-chart" viewBox="0 0 760 300" id="viz-curves-svg">
          <!-- Background Grid Lines -->
          <line
            x1="60"
            y1="40"
            x2="720"
            y2="40"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="60"
            y1="95"
            x2="720"
            y2="95"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="60"
            y1="150"
            x2="720"
            y2="150"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="60"
            y1="205"
            x2="720"
            y2="205"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line x1="60" y1="260" x2="720" y2="260" stroke="var(--hairline)"></line>

          <!-- Vertical Round Grid Lines (Rounds 1 to 5) -->
          <line
            x1="100"
            y1="40"
            x2="100"
            y2="260"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="240"
            y1="40"
            x2="240"
            y2="260"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="380"
            y1="40"
            x2="380"
            y2="260"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="520"
            y1="40"
            x2="520"
            y2="260"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>
          <line
            x1="660"
            y1="40"
            x2="660"
            y2="260"
            stroke="var(--hairline)"
            stroke-dasharray="2,2"
          ></line>

          <!-- Axes Labels -->
          <text
            x="100"
            y="280"
            fill="var(--ink-dim)"
            font-size="10"
            font-family="var(--font-mono)"
            text-anchor="middle"
          >
            ROUND 1.0
          </text>
          <text
            x="240"
            y="280"
            fill="var(--ink-dim)"
            font-size="10"
            font-family="var(--font-mono)"
            text-anchor="middle"
          >
            ROUND 2.0
          </text>
          <text
            x="380"
            y="280"
            fill="var(--ink-dim)"
            font-size="10"
            font-family="var(--font-mono)"
            text-anchor="middle"
          >
            ROUND 3.0
          </text>
          <text
            x="520"
            y="280"
            fill="var(--ink-dim)"
            font-size="10"
            font-family="var(--font-mono)"
            text-anchor="middle"
          >
            ROUND 4.0
          </text>
          <text
            x="660"
            y="280"
            fill="var(--ink-dim)"
            font-size="10"
            font-family="var(--font-mono)"
            text-anchor="middle"
          >
            ROUND 5.0
          </text>

          <!-- Dynamic Y-Axis Labels (Default: Accuracy %) -->
          <g id="y-axis-labels-acc">
            <text
              x="50"
              y="44"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              35.0%
            </text>
            <text
              x="50"
              y="99"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              30.0%
            </text>
            <text
              x="50"
              y="154"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              25.0%
            </text>
            <text
              x="50"
              y="209"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              20.0%
            </text>
            <text
              x="50"
              y="264"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              15.0%
            </text>
          </g>

          <g id="y-axis-labels-loss" style="display: none;">
            <text
              x="50"
              y="44"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              2.40
            </text>
            <text
              x="50"
              y="99"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              2.25
            </text>
            <text
              x="50"
              y="154"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              2.10
            </text>
            <text
              x="50"
              y="209"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              1.95
            </text>
            <text
              x="50"
              y="264"
              fill="var(--ink-dim)"
              font-size="10"
              font-family="var(--font-mono)"
              text-anchor="end"
            >
              1.80
            </text>
          </g>

          <!-- ACCURACY CURVES (Visible by default) -->
          <g id="group-curves-acc">
            <!-- Curve 1: Vision TTT (FedMuon) - Star Model (Orange / Accent) -->
            <path
              d="M 100 240 L 240 160 L 380 120 L 520 85 L 660 55"
              fill="none"
              stroke="var(--accent)"
              stroke-width="3"
              stroke-linecap="round"
            ></path>
            <!-- Points -->
            <circle cx="100" cy="240" r="4.5" fill="var(--accent)"></circle>
            <circle cx="240" cy="160" r="4.5" fill="var(--accent)"></circle>
            <circle cx="380" cy="120" r="4.5" fill="var(--accent)"></circle>
            <circle cx="520" cy="85" r="4.5" fill="var(--accent)"></circle>
            <circle
              cx="660"
              cy="55"
              r="6"
              fill="#ffffff"
              stroke="var(--accent)"
              stroke-width="2.5"
            ></circle>
            <text
              x="660"
              y="38"
              fill="var(--accent)"
              font-size="11"
              font-weight="700"
              font-family="var(--font-mono)"
              text-anchor="middle"
            >
              32.5% [PEAK]
            </text>

            <!-- Curve 2: Vision Titans (FedMuon) - Cyan -->
            <path
              d="M 100 205 L 240 185 L 380 178 L 520 120 L 660 105"
              fill="none"
              stroke="#00f2fe"
              stroke-width="2"
              stroke-dasharray="3,3"
            ></path>
            <circle cx="660" cy="105" r="4" fill="#00f2fe"></circle>

            <!-- Curve 3: Vision TTT (FedAvg) - Purple -->
            <path
              d="M 100 175 L 240 148 L 380 142 L 520 115 L 660 112"
              fill="none"
              stroke="#8a2be2"
              stroke-width="2"
            ></path>
            <circle cx="660" cy="112" r="4" fill="#8a2be2"></circle>

            <!-- Curve 4: SimpleCNN (FedAvg Baseline) - Dim Ink -->
            <path
              d="M 100 215 L 240 165 L 380 135 L 520 125 L 660 145"
              fill="none"
              stroke="var(--ink-dim)"
              stroke-width="1.5"
              stroke-dasharray="4,4"
            ></path>
            <circle cx="660" cy="145" r="3.5" fill="var(--ink-dim)"></circle>
          </g>

          <!-- LOSS CURVES (Hidden initially) -->
          <g id="group-curves-loss" style="display: none;">
            <!-- Curve 1: Vision TTT (FedMuon) - Star Model -->
            <path
              d="M 100 68 L 240 125 L 380 152 L 520 185 L 660 238"
              fill="none"
              stroke="var(--accent)"
              stroke-width="3"
            ></path>
            <circle
              cx="660"
              cy="238"
              r="6"
              fill="#ffffff"
              stroke="var(--accent)"
              stroke-width="2.5"
            ></circle>
            <text
              x="660"
              y="258"
              fill="var(--accent)"
              font-size="11"
              font-weight="700"
              font-family="var(--font-mono)"
              text-anchor="middle"
            >
              1.88 [LOWEST LOSS]
            </text>

            <!-- Curve 2: Vision Titans (FedMuon) -->
            <path
              d="M 100 52 L 240 110 L 380 145 L 520 175 L 660 198"
              fill="none"
              stroke="#00f2fe"
              stroke-width="2"
              stroke-dasharray="3,3"
            ></path>

            <!-- Curve 3: Vision TTT (FedAvg) -->
            <path
              d="M 100 85 L 240 115 L 380 140 L 520 162 L 660 180"
              fill="none"
              stroke="#8a2be2"
              stroke-width="2"
            ></path>

            <!-- Curve 4: SimpleCNN (FedAvg) -->
            <path
              d="M 100 75 L 240 120 L 380 148 L 520 170 L 660 178"
              fill="none"
              stroke="var(--ink-dim)"
              stroke-width="1.5"
              stroke-dasharray="4,4"
            ></path>
          </g>
        </svg>
      </div>

      <!-- Legend Bar -->
      <div class="chart-legend-row">
        <div class="legend-item">
          <span class="legend-color-line stroke-accent"></span>
          <span class="legend-text">Vision TTT (FedMuon / FedM3) — Proposed</span>
        </div>
        <div class="legend-item">
          <span class="legend-color-line stroke-cyan"></span>
          <span class="legend-text">Vision Titans (FedMuon)</span>
        </div>
        <div class="legend-item">
          <span class="legend-color-line stroke-purple"></span>
          <span class="legend-text">Vision TTT (FedAvg)</span>
        </div>
        <div class="legend-item">
          <span class="legend-color-line stroke-dim"></span>
          <span class="legend-text">SimpleCNN (FedAvg Baseline)</span>
        </div>
      </div>
    </div>

    <!-- ── PANEL 2: AGGREGATION STRATEGY COMPARISON ─────────────── -->
    <div class="viz-panel" id="panel-matrix" role="tabpanel" aria-labelledby="viz-tab-matrix">
      <div class="panel-header-row">
        <div>
          <h3 class="viz-panel-title">
            Federated Aggregation Strategies &amp; Privacy Compatibility
          </h3>
          <p class="viz-panel-subtitle">
            Comprehensive evaluation of parameter update mechanisms across communication,
            complexity, and encryption
          </p>
        </div>
      </div>

      <div class="table-responsive">
        <table class="research-table">
          <thead>
            <tr>
              <th>PARADIGM</th>
              <th>STRATEGY</th>
              <th>AGGREGATION FORMULATION</th>
              <th>COMPUTATIONAL PROFILE</th>
              <th>PRIVACY COMPATIBILITY</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <span class="paradigm-badge">Static Baseline</span>
              </td>
              <td class="strategy-col">
                <strong>FedAvg</strong>
              </td>
              <td class="math-col">
                <code>&Delta;w = &sum; p_k &Delta;w_k</code>
              </td>
              <td>O(d) linear compute. Vulnerable to client drift under non-IID data.</td>
              <td>
                <span class="compat-pill good">Trivial</span> (native linear SMPC / additive
                Paillier)
              </td>
            </tr>
            <tr>
              <td>
                <span class="paradigm-badge">Proximal</span>
              </td>
              <td class="strategy-col">
                <strong>FedProx</strong>
              </td>
              <td class="math-col">
                <code>min_w F_k(w) + &mu;/2 ||w - w^t||&sup2;</code>
              </td>
              <td>Limits local update divergence. O(d) server step.</td>
              <td>
                <span class="compat-pill good">Trivial</span> (linear server combination)
              </td>
            </tr>
            <tr>
              <td>
                <span class="paradigm-badge">Robust Stats</span>
              </td>
              <td class="strategy-col">
                <strong>FedMedian</strong>
              </td>
              <td class="math-col">
                <code>&Delta;w^(j) = median(&#123;&Delta;w_k^(j)&#125;)</code>
              </td>
              <td>Rejects extreme skewed / poisoned client updates.</td>
              <td>
                <span class="compat-pill poor">High Complexity</span> (non-linear coordinate sorting
                under SMPC)
              </td>
            </tr>
            <tr>
              <td>
                <span class="paradigm-badge">Trimmed</span>
              </td>
              <td class="strategy-col">
                <strong>FedTrimmedMean</strong>
              </td>
              <td class="math-col">
                <code>&Delta;w^(j) = 1/(K-2&beta;K) &sum; trimmed(&Delta;w_k)</code>
              </td>
              <td>Robust interpolation between mean and median.</td>
              <td>
                <span class="compat-pill poor">High Complexity</span> (sorting required before
                aggregation)
              </td>
            </tr>
            <tr>
              <td>
                <span class="paradigm-badge">Adaptive Mom.</span>
              </td>
              <td class="strategy-col">
                <strong>FedAdam</strong>
              </td>
              <td class="math-col">
                <code>v_t = &beta;_2 v_&#123;t-1&#125; + (1-&beta;_2)&Delta;_t&sup2;</code>
              </td>
              <td>
                Second-moment adaptive scaling per coordinate; accelerates escape from saddle
                points.
              </td>
              <td>
                <span class="compat-pill medium">Moderate</span> (linear client sum + server
                element-wise math)
              </td>
            </tr>
            <tr class="highlight-row">
              <td>
                <span class="paradigm-badge proposed">Proposed Framework</span>
              </td>
              <td class="strategy-col">
                <strong class="highlight-text">FedM3 / FedMuon</strong>
              </td>
              <td class="math-col">
                <code class="highlight-code">&Delta;w_orth = NS_5(M_t) &middot; &eta;</code>
              </td>
              <td>
                <strong>Spectral norm bounded updates</strong> via quintic Newton-Schulz; prevents
                gradient explosion without sorting.
              </td>
              <td>
                <span class="compat-pill good">Moderate-Low</span> (matrix multiplication friendly
                under HE)
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── PANEL 3: NON-IID REGIMES ─────────────────────────────── -->
    <div class="viz-panel" id="panel-regimes" role="tabpanel" aria-labelledby="viz-tab-regimes">
      <div class="panel-header-row">
        <div>
          <h3 class="viz-panel-title">Non-IID Heterogeneity Regimes &amp; Local Sparsity</h3>
          <p class="viz-panel-subtitle">
            Empirical impact of feature skew and missing classes on global model generalization
          </p>
        </div>
      </div>

      <div class="regimes-grid">
        <div class="regime-card">
          <div class="regime-tag">REGIME 01 // IID BASELINE</div>
          <h4 class="regime-title">Uniform Centralized Distribution</h4>
          <p class="regime-desc">
            All edge clients sample uniformly from the complete data distribution (identical
            marginal label distributions). Model achieves steady, monotonic loss reduction with
            naive FedAvg.
          </p>
          <div class="regime-metric">
            <span class="rm-k">FEDAVG ACCURACY:</span>
            <span class="rm-v">95.3%</span>
          </div>
          <div class="regime-status good">IDEALIZED BENCHMARK ONLY</div>
        </div>

        <div class="regime-card">
          <div class="regime-tag">REGIME 02 // DIRICHLET SKEW</div>
          <h4 class="regime-title">Dirichlet Distribution (&alpha; = 0.1)</h4>
          <p class="regime-desc">
            Severe partition skew where client class proportions are drawn from a sparse Dirichlet
            prior. Clients receive only 2-3 dominant classes, causing immediate weight divergence
            under FedAvg.
          </p>
          <div class="regime-metric">
            <span class="rm-k">FEDAVG ACCURACY:</span>
            <span class="rm-v">41.6% (-53.7%)</span>
          </div>
          <div class="regime-status warning">COMMON IN CLINICAL DATA</div>
        </div>

        <div class="regime-card highlight-card">
          <div class="regime-tag">REGIME 03 // PATHOLOGICAL SKEW</div>
          <h4 class="regime-title">Missing Classes &amp; Extreme Non-IID</h4>
          <p class="regime-desc">
            Strict non-overlapping partitions (each hospital node sees solely 1 or 2 specific
            pathologies). FedAvg collapses to 0.0% accuracy on unseen minority classes. FedM3
            stabilizes representation space.
          </p>
          <div class="regime-metric">
            <span class="rm-k">FEDM3 RESTORED ACC:</span>
            <span class="rm-v">74.7% (vs 0% FedAvg)</span>
          </div>
          <div class="regime-status proposed">RESOLVED BY FEDM3 + CMS</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Interactive Visualizer Tabs & Metric Switcher
  function initVisualizer() {
    const tabs = document.querySelectorAll('.viz-tab-btn');
    const panels = document.querySelectorAll('.viz-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => p.classList.remove('active'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const targetId = tab.getAttribute('data-target');
        const panel = document.getElementById(targetId || '');
        panel?.classList.add('active');
      });
    });

    // Accuracy vs Loss Metric Toggle
    const btnAcc = document.getElementById('btn-show-acc');
    const btnLoss = document.getElementById('btn-show-loss');
    const groupAcc = document.getElementById('group-curves-acc');
    const groupLoss = document.getElementById('group-curves-loss');
    const yAxisAcc = document.getElementById('y-axis-labels-acc');
    const yAxisLoss = document.getElementById('y-axis-labels-loss');

    btnAcc?.addEventListener('click', () => {
      btnAcc.classList.add('active');
      btnLoss?.classList.remove('active');
      if (groupAcc) groupAcc.style.display = 'inline';
      if (groupLoss) groupLoss.style.display = 'none';
      if (yAxisAcc) yAxisAcc.style.display = 'inline';
      if (yAxisLoss) yAxisLoss.style.display = 'none';
    });

    btnLoss?.addEventListener('click', () => {
      btnLoss.classList.add('active');
      btnAcc?.classList.remove('active');
      if (groupAcc) groupAcc.style.display = 'none';
      if (groupLoss) groupLoss.style.display = 'inline';
      if (yAxisAcc) yAxisAcc.style.display = 'none';
      if (yAxisLoss) yAxisLoss.style.display = 'inline';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVisualizer);
  } else {
    initVisualizer();
  }
</script>
