---
/**
 * ChromeNav — Fixed top navigation bar (instrument HUD style).
 * Brand mark left, inline typographic links right separated by 1px hairlines.
 */

interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

const links: NavLink[] = [
  { label: 'About', href: '#about' },
  { label: 'Works', href: '#works' },
  { label: 'Skills', href: '#skills' },
  { label: 'GitHub', href: 'https://github.com/bernardbdas', external: true },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/bernardbdas', external: true },
];
---

<nav class="chrome-top anim-chrome" aria-label="Main navigation">
  <div class="brand-group">
    <a href="/" class="brand" aria-label="Bernard Birendra Das (Home)">
      bernardbdas<span class="brand-suffix">.github.io</span>
    </a>
    <span class="hud-sep" aria-hidden="true">
      //
    </span>
    <div class="age-counter" id="age-counter" title="Live Age Counter (Click to toggle format)">
      <span class="age-badge">UPTIME</span>
      <span class="age-display" id="age-display">
        <span class="age-num" id="age-y">
          --
        </span>
        <span class="age-unit">Y</span>
        <span class="age-num" id="age-d">
          --
        </span>
        <span class="age-unit">D</span>
        <span class="age-num" id="age-h">
          --
        </span>
        <span class="age-sep">:</span>
        <span class="age-num" id="age-m">
          --
        </span>
        <span class="age-sep">:</span>
        <span class="age-num" id="age-s">
          --
        </span>
        <span class="age-dot">.</span>
        <span class="age-ms" id="age-ms">
          ---
        </span>
      </span>
    </div>
  </div>
  <div class="nav-links" role="navigation">
    {links.map((link, i) => (
      <>
        {i > 0 && <span class="nav-sep" aria-hidden="true" />}
        <a
          href={link.href}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
          {link.external && (
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          )}
        </a>
      </>
    ))}
    <span class="nav-sep" aria-hidden="true"></span>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle color theme">
      <span class="theme-icon" aria-hidden="true">
        ◐
      </span>
      <span class="theme-label" id="themeLabel">
        LIGHT
      </span>
    </button>
    <button
      class="mobile-nav-toggle"
      id="mobileNavToggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="menu-icon-bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="mobile-nav-text">MENU</span>
    </button>
  </div>
</nav>

<!-- Mobile HUD Drawer Overlay -->
<div class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>
  <div class="mobile-nav-panel">
    <div class="mobile-nav-header">
      <span class="mobile-nav-brand">
        bernardbdas<span class="brand-suffix">.github.io</span>
      </span>
      <button class="mobile-nav-close" id="mobileNavClose" type="button" aria-label="Close menu">
        ✕
      </button>
    </div>

    <div class="mobile-nav-list" role="navigation">
      {links.map((link, i) => (
        <a
          href={link.href}
          class="mobile-nav-item"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="mobile-item-index">0{i + 1}</span>
          <span class="mobile-item-label">{link.label}</span>
          <span class="mobile-item-arrow">{link.external ? '↗' : '→'}</span>
        </a>
      ))}
      <a
        href="/bernard-resume-sourceserifpro.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-item"
      >
        <span class="mobile-item-index">06</span>
        <span class="mobile-item-label">Resume</span>
        <span class="mobile-item-arrow">↗</span>
      </a>
    </div>

    <div class="mobile-nav-footer">
      <div class="mobile-nav-status">
        <span class="status-dot"></span>
        <span>INSTRUMENT ONLINE // 2026</span>
      </div>
      <button class="mobile-theme-toggle" id="mobileThemeToggle" type="button">
        <span class="theme-icon">◐</span>
        <span class="theme-label" id="mobileThemeLabel">
          LIGHT MODE
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/age-counter';

  function setupThemeToggle(): void {
    const btn = document.getElementById('themeToggle');
    const label = document.getElementById('themeLabel');

    function syncLabel(theme: string): void {
      if (label) {
        label.textContent = theme === 'dark' ? 'LIGHT' : 'DARK';
      }
    }

    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    syncLabel(current);

    btn?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'dark';
      const target = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      localStorage.setItem('theme', target);
      syncLabel(target);
      window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: target } }));
    });
  }

  function setupBrandNavigation(): void {
    const brandLink = document.querySelector<HTMLAnchorElement>('a.brand');
    if (!brandLink) return;

    brandLink.addEventListener('click', (e: MouseEvent) => {
      // Respect standard browser modifier clicks (Cmd/Ctrl click, new tab)
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

      const contentCol = document.querySelector('.content-col');
      const isScrolled = (contentCol && contentCol.scrollTop > 30) || window.scrollY > 30;

      if (isScrolled) {
        e.preventDefault();
        if (contentCol) {
          contentCol.scrollTo({ top: 0, behavior: 'smooth' });
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });

        if (window.location.hash) {
          history.pushState(null, '', window.location.pathname);
        }
      } else {
        // Already at top: trigger a clean reload/refresh
        e.preventDefault();
        window.location.href = '/';
      }
    });
  }

  function setupMobileMenu(): void {
    const toggleBtn = document.getElementById('mobileNavToggle');
    const drawer = document.getElementById('mobileNavDrawer');
    const closeBtn = document.getElementById('mobileNavClose');
    const backdrop = document.getElementById('mobileNavBackdrop');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-item');
    const mobileThemeToggle = document.getElementById('mobileThemeToggle');
    const mobileThemeLabel = document.getElementById('mobileThemeLabel');

    if (!toggleBtn || !drawer) return;

    function syncMobileThemeLabel(theme: string): void {
      if (mobileThemeLabel) {
        mobileThemeLabel.textContent = theme === 'dark' ? 'LIGHT MODE' : 'DARK MODE';
      }
    }

    const curTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    syncMobileThemeLabel(curTheme);

    window.addEventListener('themechange', (e: Event) => {
      const custom = e as CustomEvent<{ theme: string }>;
      if (custom.detail?.theme) {
        syncMobileThemeLabel(custom.detail.theme);
      }
    });

    mobileThemeToggle?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'dark';
      const target = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      localStorage.setItem('theme', target);
      window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: target } }));
    });

    function openMenu(): void {
      drawer!.setAttribute('aria-hidden', 'false');
      toggleBtn!.setAttribute('aria-expanded', 'true');
      const textSpan = toggleBtn!.querySelector('.mobile-nav-text');
      if (textSpan) textSpan.textContent = 'CLOSE';
      document.body.style.overflow = 'hidden';
    }

    function closeMenu(): void {
      drawer!.setAttribute('aria-hidden', 'true');
      toggleBtn!.setAttribute('aria-expanded', 'false');
      const textSpan = toggleBtn!.querySelector('.mobile-nav-text');
      if (textSpan) textSpan.textContent = 'MENU';
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer!.getAttribute('aria-hidden') === 'false';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && drawer!.getAttribute('aria-hidden') === 'false') {
        closeMenu();
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', (e: MouseEvent) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          e.preventDefault();
          closeMenu();
          const target = document.querySelector(href);
          if (target) {
            const topBarOffset = 44;
            const y = target.getBoundingClientRect().top + window.scrollY - topBarOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
            const contentCol = document.querySelector('.content-col');
            if (contentCol && contentCol.scrollHeight > contentCol.clientHeight) {
              contentCol.scrollTo({ top: y, behavior: 'smooth' });
            }
          }
        } else {
          closeMenu();
        }
      });
    });
  }

  function initNav(): void {
    setupThemeToggle();
    setupBrandNavigation();
    setupMobileMenu();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>
