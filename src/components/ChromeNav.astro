---
/**
 * ChromeNav — Fixed top navigation bar (instrument HUD style).
 * Brand mark left, inline typographic links right separated by 1px hairlines.
 */

interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href.startsWith('http')) return false;
  if (href.startsWith('/#') || href.startsWith('#')) return false;
  return currentPath === href || currentPath === `${href}/`;
};

const links: NavLink[] = [
  { label: 'About', href: '/#about' },
  { label: 'Work', href: '/#work' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Research', href: '/research' },
  { label: 'Blog', href: '/blog' },
  { label: 'Media', href: '/media' },
  { label: 'GitHub', href: 'https://github.com/bernardbdas', external: true },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/bernardbdas', external: true },
];
---

<nav class="chrome-top anim-chrome" aria-label="Main navigation">
  <div class="brand-group">
    <a href="/" class="brand" aria-label="Bernard Birendra Das (Home)">
      bernardbdas<span class="brand-suffix">.github.io</span>
    </a>
    <span class="hud-sep" aria-hidden="true">
      //
    </span>
    <div class="age-counter" id="age-counter" title="Live Age Counter (Click to toggle format)">
      <span class="age-badge">UPTIME</span>
      <span class="age-display" id="age-display">
        <span class="age-num age-y" id="age-y">
          --
        </span>
        <span class="age-unit">Y</span>
        <span class="age-num age-d" id="age-d">
          --
        </span>
        <span class="age-unit">D</span>
        <span class="age-num age-h" id="age-h">
          --
        </span>
        <span class="age-sep">:</span>
        <span class="age-num age-m" id="age-m">
          --
        </span>
        <span class="age-sep">:</span>
        <span class="age-num age-s" id="age-s">
          --
        </span>
        <span class="age-dot">.</span>
        <span class="age-ms" id="age-ms">
          ---
        </span>
      </span>
    </div>
  </div>

  <div class="chrome-nav-spacer" aria-hidden="true"></div>

  <div class="chrome-top-center">
    <div
      class="local-clock"
      id="local-clock"
      role="button"
      tabindex="0"
      title="User Local Time (Click to cycle clock modes: Local > Bernard's > Pomodoro)"
      aria-label="Clock and Pomodoro flow instrument readout"
    >
      <span class="clock-badge" id="clock-badge">
        LOCAL
      </span>
      <span class="clock-display" id="clock-display">
        <span class="clock-weekday" id="clock-weekday">
          ---
        </span>
        <span class="clock-date" id="clock-date">
          -- --- ----
        </span>
        <span class="clock-sep" aria-hidden="true">
          //
        </span>
        <span class="clock-time" id="clock-time">
          --:--:--
        </span>
        <span class="clock-tz" id="clock-tz"></span>
      </span>

      <!-- Pomodoro Minimal Display (rendered when mode === 'pomodoro') -->
      <span class="pomo-display" id="pomo-display" style="display: none;">
        <span class="pomo-tag" id="pomo-tag">
          WORK
        </span>
        <span class="clock-time pomo-time" id="pomo-time">
          25:00
        </span>
        <span class="pomo-mini-actions">
          <button
            type="button"
            class="pomo-mini-btn pomo-play-btn"
            id="pomo-play-btn"
            title="Start / Pause Flow (Space)"
            aria-label="Start or Pause Flow"
          >
            <span class="pomo-btn-icon-wrap" id="pomo-play-icon">
              <svg
                class="pomo-svg-icon"
                width="7"
                height="7"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <polygon points="6 3 20 12 6 21 6 3" />
              </svg>
            </span>
          </button>
          <button
            type="button"
            class="pomo-mini-btn pomo-deck-btn"
            id="pomo-deck-btn"
            title="Pomodoro Presets & Controls"
            aria-label="Open Pomodoro Controls"
          >
            <span class="pomo-btn-icon-wrap">
              <svg
                class="pomo-svg-icon pomo-chevron-icon"
                width="8"
                height="5"
                viewBox="0 0 8 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M1 1L4 4L7 1" />
              </svg>
            </span>
          </button>
        </span>
      </span>
    </div>

    <!-- Floating Preset & Controls Deck Popover -->
    <div
      class="pomo-deck-popover"
      id="pomo-deck-popover"
      role="region"
      aria-label="Pomodoro Instrument Deck"
      style="display: none;"
    >
      <div class="pomo-deck-header">
        <span class="pomo-deck-title">// POMODORO FLOW INSTRUMENT</span>
        <button
          type="button"
          class="pomo-deck-close"
          id="pomo-deck-close"
          aria-label="Close presets"
        >
          &times;
        </button>
      </div>

      <div class="pomo-deck-row">
        <span class="pomo-deck-label">FLOW PRESET</span>
        <div class="pomo-preset-group">
          <button
            type="button"
            class="pomo-preset-btn is-active"
            data-preset="25-5"
            id="pomo-preset-25"
          >
            25 / 5 CLASSIC
          </button>
          <button type="button" class="pomo-preset-btn" data-preset="50-10" id="pomo-preset-50">
            50 / 10 DEEP
          </button>
        </div>
      </div>

      <div class="pomo-deck-row">
        <span class="pomo-deck-label">FLOW CONTROLS</span>
        <div class="pomo-controls-group">
          <button type="button" class="pomo-action-btn pomo-action-play" id="pomo-action-play">
            <span id="pomo-deck-play-text">START FLOW</span>
          </button>
          <button
            type="button"
            class="pomo-action-btn"
            id="pomo-action-reset"
            title="Reset timer to beginning"
          >
            RESET
          </button>
          <button
            type="button"
            class="pomo-action-btn"
            id="pomo-action-skip"
            title="Skip to next session"
          >
            SKIP
          </button>
        </div>
      </div>

      <div class="pomo-deck-row">
        <span class="pomo-deck-label">COMPLETION CHIME</span>
        <div class="pomo-chimes-group">
          <div class="pomo-chime-select-wrap">
            <select class="pomo-chime-select" id="pomo-chime-select" aria-label="Select chime tone">
              <option value="zen">ZEN BOWL (Harmonic 528Hz)</option>
              <option value="synth">SYNTH CHIME (Cyberpunk Shimmer)</option>
              <option value="radar">RADAR PING (Tactical Sonar)</option>
              <option value="beep">DIGITAL BEEP (Retro Chrono)</option>
            </select>
            <span class="pomo-select-arrow" aria-hidden="true">
              <svg
                width="8"
                height="5"
                viewBox="0 0 8 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 1L4 4L7 1" />
              </svg>
            </span>
          </div>
          <button
            type="button"
            class="pomo-test-chime-btn"
            id="pomo-test-chime"
            title="Test chime preview"
          >
            TEST ♪
          </button>
        </div>
      </div>

      <div class="pomo-deck-footer">
        <button type="button" class="pomo-open-stats-btn" id="pomo-open-stats-btn">
          DETAILED STATISTICS &amp; TELEMETRY &rarr;
        </button>
      </div>
    </div>
  </div>

  <div class="chrome-nav-spacer" aria-hidden="true"></div>

  <div class="nav-links" role="navigation">
    {links.map((link, i) => (
      <>
        {i > 0 && <span class="nav-sep" aria-hidden="true" />}
        <a
          href={link.href}
          class:list={['nav-link-item', { active: isActive(link.href) }]}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
          {link.external && (
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          )}
        </a>
      </>
    ))}
    <span class="nav-sep" aria-hidden="true"></span>
    <div class="theme-dropdown-wrap">
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label="Color theme selector (Click to cycle, hover for options)"
        title="Color Theme (Click to cycle)"
      >
        <span class="theme-swatch" id="themeSwatch" aria-hidden="true"></span>
        <span class="theme-label" id="themeLabel">
          AMBER
        </span>
      </button>

      <div class="theme-palette-menu" id="themePaletteMenu" role="menu" aria-label="Color themes">
        <button class="palette-item" data-set-theme="dark" role="menuitem" type="button">
          <span class="swatch-dot dot-amber"></span>
          <span>Amber</span>
        </button>
        <button class="palette-item" data-set-theme="light" role="menuitem" type="button">
          <span class="swatch-dot dot-light"></span>
          <span>Light</span>
        </button>
        <button class="palette-item" data-set-theme="blue" role="menuitem" type="button">
          <span class="swatch-dot dot-blue"></span>
          <span>Blue</span>
        </button>
        <button class="palette-item" data-set-theme="white" role="menuitem" type="button">
          <span class="swatch-dot dot-white"></span>
          <span>White</span>
        </button>
        <button class="palette-item" data-set-theme="violet" role="menuitem" type="button">
          <span class="swatch-dot dot-violet"></span>
          <span>Violet</span>
        </button>
        <button class="palette-item" data-set-theme="emerald" role="menuitem" type="button">
          <span class="swatch-dot dot-emerald"></span>
          <span>Emerald</span>
        </button>
      </div>
    </div>
    <div class="sound-toggle-wrap">
      <button
        class="sound-toggle ambient-toggle"
        id="soundToggle"
        type="button"
        aria-label="Toggle atmospheric background audio (Dark soundscape)"
        title="Atmospheric Sound (Click to pause/play, Double-click to switch track)"
        aria-pressed="false"
      >
        <span class="sound-icon-wrap" aria-hidden="true">
          <span class="eq-bar bar-1"></span>
          <span class="eq-bar bar-2"></span>
          <span class="eq-bar bar-3"></span>
        </span>
        <span class="sound-label" id="soundLabel">
          AMB // OFF
        </span>
      </button>

      <button
        class="sound-toggle fx-toggle is-active"
        id="fxToggle"
        type="button"
        aria-label="Toggle sound effects (FX)"
        title="Sound Effects: FX [Active] (Click to toggle)"
        aria-pressed="true"
      >
        <span class="fx-icon-wrap" aria-hidden="true">
          <span class="fx-dot"></span>
        </span>
        <span class="fx-badge">FX</span>
        <span class="sound-label" id="fxLabel">
          // ON
        </span>
      </button>

      <button
        class="sound-toggle persist-toggle is-active"
        id="persistToggle"
        type="button"
        aria-label="Toggle background audio persistence across tabs and windows"
        title="Background Audio Persistence: [Active] (Continuous playback across tabs/windows. Click to pause when tab is hidden)"
        aria-pressed="true"
      >
        <span class="persist-icon-wrap" aria-hidden="true">
          <span class="persist-dot"></span>
        </span>
        <span class="persist-badge">FLOW</span>
        <span class="sound-label" id="persistLabel">
          // ON
        </span>
      </button>
    </div>
    <button
      class="mobile-nav-toggle"
      id="mobileNavToggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="menu-icon-bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      <span class="mobile-nav-text">MENU</span>
    </button>
  </div>
</nav>

<!-- Mobile HUD Drawer Overlay -->
<div class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>
  <div class="mobile-nav-panel">
    <div class="mobile-nav-header">
      <span class="mobile-nav-brand">
        bernardbdas<span class="brand-suffix">.github.io</span>
      </span>
      <button class="mobile-nav-close" id="mobileNavClose" type="button" aria-label="Close menu">
        &times;
      </button>
    </div>

    <div class="mobile-drawer-uptime">
      <div class="age-counter" title="Live Age Counter (Click to toggle format)">
        <span class="age-badge">UPTIME</span>
        <span class="age-display">
          <span class="age-num age-y">--</span>
          <span class="age-unit">Y</span>
          <span class="age-num age-d">--</span>
          <span class="age-unit">D</span>
          <span class="age-num age-h">--</span>
          <span class="age-sep">:</span>
          <span class="age-num age-m">--</span>
          <span class="age-sep">:</span>
          <span class="age-num age-s">--</span>
          <span class="age-dot">.</span>
          <span class="age-ms">---</span>
        </span>
      </div>
    </div>

    <div class="mobile-nav-list" role="navigation">
      {links.map((link, i) => (
        <a
          href={link.href}
          class:list={['mobile-nav-item', { active: isActive(link.href) }]}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="mobile-item-index">{String(i + 1).padStart(2, '0')}</span>
          <span class="mobile-item-label">{link.label}</span>
          <span class="mobile-item-arrow">{link.external ? '↗' : '→'}</span>
        </a>
      ))}
    </div>

    <div class="mobile-theme-palette">
      <div class="mobile-section-header">
        <span class="palette-title">COLOR PALETTE</span>
        <span class="palette-current" id="paletteCurrentTheme">
          AMBER
        </span>
      </div>
      <div class="palette-swatches">
        <button class="palette-btn" data-set-theme="dark" type="button" aria-label="Amber theme">
          <span class="swatch-dot dot-amber"></span>
          <span>Amber</span>
        </button>
        <button class="palette-btn" data-set-theme="light" type="button" aria-label="Light theme">
          <span class="swatch-dot dot-light"></span>
          <span>Light</span>
        </button>
        <button class="palette-btn" data-set-theme="blue" type="button" aria-label="Blue theme">
          <span class="swatch-dot dot-blue"></span>
          <span>Blue</span>
        </button>
        <button class="palette-btn" data-set-theme="white" type="button" aria-label="White theme">
          <span class="swatch-dot dot-white"></span>
          <span>White</span>
        </button>
        <button class="palette-btn" data-set-theme="violet" type="button" aria-label="Violet theme">
          <span class="swatch-dot dot-violet"></span>
          <span>Violet</span>
        </button>
        <button
          class="palette-btn"
          data-set-theme="emerald"
          type="button"
          aria-label="Emerald theme"
        >
          <span class="swatch-dot dot-emerald"></span>
          <span>Emerald</span>
        </button>
      </div>
    </div>

    <div class="mobile-audio-section">
      <div class="mobile-section-header">
        <span class="mobile-section-title">AUDIO & INTERACTION</span>
      </div>
      <div class="mobile-audio-grid">
        <button
          class="mobile-sound-toggle mobile-ambient-toggle"
          id="mobileSoundToggle"
          type="button"
          aria-label="Toggle atmospheric sound"
          title="Atmospheric Sound (Click to pause/play, Double-click to switch track)"
        >
          <span class="sound-icon-wrap" aria-hidden="true">
            <span class="eq-bar bar-1"></span>
            <span class="eq-bar bar-2"></span>
            <span class="eq-bar bar-3"></span>
          </span>
          <span class="sound-label" id="mobileSoundLabel">
            AMB // OFF
          </span>
        </button>
        <button
          class="mobile-sound-toggle mobile-fx-toggle is-active"
          id="mobileFxToggle"
          type="button"
          aria-label="Toggle sound effects (FX)"
          title="Sound Effects: FX [Active] (Click to toggle)"
          aria-pressed="true"
        >
          <span class="fx-icon-wrap" aria-hidden="true">
            <span class="fx-dot"></span>
          </span>
          <span class="fx-badge">FX</span>
          <span class="sound-label" id="mobileFxLabel">
            // ON
          </span>
        </button>
        <button
          class="mobile-sound-toggle mobile-persist-toggle is-active"
          id="mobilePersistToggle"
          type="button"
          aria-label="Toggle background audio persistence across tabs and windows"
          title="Background Audio Persistence: [Active] (Continuous playback across tabs/windows. Click to pause when tab is hidden)"
          aria-pressed="true"
        >
          <span class="persist-icon-wrap" aria-hidden="true">
            <span class="persist-dot"></span>
          </span>
          <span class="persist-badge">FLOW</span>
          <span class="sound-label" id="mobilePersistLabel">
            // ON
          </span>
        </button>
      </div>
    </div>

    <div class="mobile-nav-footer">
      <div class="mobile-nav-status">
        <span>&copy; 2026 BERNARD BIRENDRA DAS</span>
      </div>
      <span class="mobile-sys-status">INSTRUMENT ONLINE</span>
    </div>
  </div>
</div>

<!-- Pomodoro Detailed Telemetry & Statistics Modal -->
<div
  id="pomoStatsModal"
  class="pomo-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pomoModalTitle"
  aria-hidden="true"
  style="display: none;"
>
  <div class="pomo-modal-card">
    <header class="pomo-modal-header">
      <div class="pomo-modal-info">
        <span class="pomo-modal-badge">FLOW // 03</span>
        <span class="pomo-modal-title" id="pomoModalTitle">
          POMODORO FLOW TELEMETRY
        </span>
        <span class="pomo-modal-meta">// LOCAL PERSISTED AUDIT</span>
      </div>
      <button
        type="button"
        id="pomoModalClose"
        class="pomo-modal-close"
        aria-label="Close statistics modal (Escape)"
        title="Close (ESC)"
      >
        &times;
      </button>
    </header>

    <div class="pomo-modal-body">
      <!-- High-Level Metric Cards -->
      <div class="pomo-stats-grid">
        <div class="pomo-stat-card">
          <span class="pomo-stat-label">TOTAL FLOWS</span>
          <span class="pomo-stat-value" id="pomo-stat-total-flows">
            0
          </span>
          <span class="pomo-stat-sub">Completed focus sessions</span>
        </div>
        <div class="pomo-stat-card">
          <span class="pomo-stat-label">TOTAL FOCUS TIME</span>
          <span class="pomo-stat-value" id="pomo-stat-total-focus">
            0m
          </span>
          <span class="pomo-stat-sub">Actual deep work logged</span>
        </div>
        <div class="pomo-stat-card">
          <span class="pomo-stat-label">TOTAL BREAK TIME</span>
          <span class="pomo-stat-value" id="pomo-stat-total-break">
            0m
          </span>
          <span class="pomo-stat-sub">Rest and recovery time</span>
        </div>
        <div class="pomo-stat-card">
          <span class="pomo-stat-label">ACTIVE PRESET</span>
          <span class="pomo-stat-value" id="pomo-stat-active-preset">
            25 / 5
          </span>
          <span class="pomo-stat-sub">Customizable in deck</span>
        </div>
      </div>

      <!-- Time Horizon Breakdown Table -->
      <div class="pomo-table-section">
        <h4 class="pomo-section-title">TIME HORIZON BREAKDOWN</h4>
        <div class="pomo-table-scroll">
          <table class="pomo-telemetry-table">
            <thead>
              <tr>
                <th>PERIOD</th>
                <th>COMPLETED FLOWS</th>
                <th>FOCUS TIME</th>
                <th>BREAK TIME</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="pomo-td-period">TODAY</td>
                <td id="pomo-td-today-flows">0</td>
                <td id="pomo-td-today-focus">0m</td>
                <td id="pomo-td-today-break">0m</td>
              </tr>
              <tr>
                <td class="pomo-td-period">THIS WEEK (7D)</td>
                <td id="pomo-td-week-flows">0</td>
                <td id="pomo-td-week-focus">0m</td>
                <td id="pomo-td-week-break">0m</td>
              </tr>
              <tr>
                <td class="pomo-td-period">THIS MONTH (30D)</td>
                <td id="pomo-td-month-flows">0</td>
                <td id="pomo-td-month-focus">0m</td>
                <td id="pomo-td-month-break">0m</td>
              </tr>
              <tr>
                <td class="pomo-td-period">ALL TIME</td>
                <td id="pomo-td-all-flows">0</td>
                <td id="pomo-td-all-focus">0m</td>
                <td id="pomo-td-all-break">0m</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Completed Sessions Log -->
      <div class="pomo-history-section">
        <h4 class="pomo-section-title">RECENT SESSION AUDIT LOG</h4>
        <div class="pomo-history-list" id="pomo-history-list">
          <div class="pomo-history-empty">
            NO COMPLETED FLOW SESSIONS RECORDED YET. START A FLOW TO LOG TELEMETRY.
          </div>
        </div>
      </div>
    </div>

    <footer class="pomo-modal-footer">
      <button type="button" class="pomo-footer-btn" id="pomoCopyReportBtn">
        COPY TELEMETRY AUDIT
      </button>
      <button type="button" class="pomo-footer-btn pomo-btn-danger" id="pomoResetStatsBtn">
        CLEAR AUDIT DATA
      </button>
      <button type="button" class="pomo-footer-btn pomo-btn-primary" id="pomoCloseModalBtn">
        CLOSE [ESC]
      </button>
    </footer>
  </div>
</div>

<script>
  import '../scripts/age-counter';
  import '../scripts/local-clock';
  import '../scripts/ambient-sound';
  import '../scripts/hard-reload';

  const THEMES = [
    { id: 'dark', label: 'AMBER' },
    { id: 'light', label: 'LIGHT' },
    { id: 'blue', label: 'BLUE' },
    { id: 'white', label: 'WHITE' },
    { id: 'violet', label: 'VIOLET' },
    { id: 'emerald', label: 'EMERALD' },
  ] as const;

  function applyTheme(themeId: string): void {
    const matched = THEMES.find((t) => t.id === themeId) || THEMES[0];
    document.documentElement.setAttribute('data-theme', matched.id);
    localStorage.setItem('theme', matched.id);

    const label = document.getElementById('themeLabel');
    const btn = document.getElementById('themeToggle');
    const mobileThemeLabel = document.getElementById('mobileThemeLabel');
    const curThemeEl = document.getElementById('paletteCurrentTheme');
    const paletteButtons = document.querySelectorAll<HTMLElement>('[data-set-theme]');

    if (label) label.textContent = matched.label;
    if (btn) btn.setAttribute('title', `Color Theme: ${matched.label} (Click to cycle)`);
    if (mobileThemeLabel) mobileThemeLabel.textContent = `THEME: ${matched.label}`;
    if (curThemeEl) curThemeEl.textContent = matched.label;

    paletteButtons.forEach((b) => {
      const isCur = b.getAttribute('data-set-theme') === matched.id;
      b.classList.toggle('active', isCur);
    });

    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: matched.id } }));
  }

  function cycleTheme(): void {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const curIndex = THEMES.findIndex((t) => t.id === current);
    const nextIndex = (curIndex + 1) % THEMES.length;
    applyTheme(THEMES[nextIndex].id);
  }

  function openMobileMenu(): void {
    const drawer = document.getElementById('mobileNavDrawer');
    const toggleBtn = document.getElementById('mobileNavToggle');
    if (!drawer) return;
    drawer.setAttribute('aria-hidden', 'false');
    drawer.classList.add('is-open');
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', 'true');
      const textSpan = toggleBtn.querySelector('.mobile-nav-text');
      if (textSpan) textSpan.textContent = 'CLOSE';
    }
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu(): void {
    const drawer = document.getElementById('mobileNavDrawer');
    const toggleBtn = document.getElementById('mobileNavToggle');
    if (!drawer) return;
    drawer.setAttribute('aria-hidden', 'true');
    drawer.classList.remove('is-open');
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', 'false');
      const textSpan = toggleBtn.querySelector('.mobile-nav-text');
      if (textSpan) textSpan.textContent = 'MENU';
    }
    document.body.style.overflow = '';
  }

  let navEventsBound = false;

  function initNav(): void {
    // Synchronize active theme from storage or DOM attribute
    const initialTheme =
      document.documentElement.getAttribute('data-theme') ||
      localStorage.getItem('theme') ||
      'dark';
    applyTheme(initialTheme);

    // Ensure mobile drawer is closed on route load
    closeMobileMenu();

    if (navEventsBound) return;
    navEventsBound = true;

    // Unified Document Click Delegation for 100% resilient interaction
    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. Mobile Menu Toggle Button
      const toggleBtn = target.closest<HTMLElement>('#mobileNavToggle');
      if (toggleBtn) {
        e.preventDefault();
        e.stopPropagation();
        const drawer = document.getElementById('mobileNavDrawer');
        const isOpen =
          drawer?.getAttribute('aria-hidden') === 'false' || drawer?.classList.contains('is-open');
        if (isOpen) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
        return;
      }

      // 2. Mobile Drawer Close Button or Backdrop
      const closeBtn = target.closest<HTMLElement>('#mobileNavClose, #mobileNavBackdrop');
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();
        closeMobileMenu();
        return;
      }

      // 3. Mobile Nav Drawer Links
      const mobileLink = target.closest<HTMLAnchorElement>('.mobile-nav-item');
      if (mobileLink) {
        const href = mobileLink.getAttribute('href');
        if (!href) return;
        if (href.startsWith('#') || (href.startsWith('/#') && window.location.pathname === '/')) {
          const hash = href.startsWith('/#') ? href.substring(1) : href;
          e.preventDefault();
          closeMobileMenu();
          const targetEl = document.querySelector(hash);
          if (targetEl) {
            const topBarOffset = 44;
            const y = targetEl.getBoundingClientRect().top + window.scrollY - topBarOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
            const contentCol = document.querySelector('.content-col');
            if (contentCol && contentCol.scrollHeight > contentCol.clientHeight) {
              contentCol.scrollTo({ top: y, behavior: 'smooth' });
            }
          }
        } else {
          closeMobileMenu();
        }
        return;
      }

      // 4. Theme Toggle Buttons
      const themeToggle = target.closest<HTMLElement>('#themeToggle, #mobileThemeToggle');
      if (themeToggle) {
        e.preventDefault();
        e.stopPropagation();
        cycleTheme();
        return;
      }

      // 5. Theme Palette Swatches
      const paletteItem = target.closest<HTMLElement>('[data-set-theme]');
      if (paletteItem) {
        const targetTheme = paletteItem.getAttribute('data-set-theme');
        if (targetTheme) {
          e.preventDefault();
          e.stopPropagation();
          applyTheme(targetTheme);
        }
        return;
      }

      // 6. Brand Logo Scroll-to-Top Navigation
      const brand = target.closest<HTMLAnchorElement>('a.brand');
      if (brand) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const contentCol = document.querySelector('.content-col');
        const isScrolled = (contentCol && contentCol.scrollTop > 30) || window.scrollY > 30;

        if (isScrolled) {
          e.preventDefault();
          if (contentCol) {
            contentCol.scrollTo({ top: 0, behavior: 'smooth' });
          }
          window.scrollTo({ top: 0, behavior: 'smooth' });

          if (window.location.hash) {
            history.pushState(null, '', window.location.pathname);
          }
        } else {
          e.preventDefault();
          window.location.href = '/';
        }
        return;
      }

      // 7. Desktop In-Page Hash Links
      const desktopLink = target.closest<HTMLAnchorElement>('.nav-links a');
      if (desktopLink) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const href = desktopLink.getAttribute('href');
        if (!href) return;
        if (href.startsWith('#') || (href.startsWith('/#') && window.location.pathname === '/')) {
          const hash = href.startsWith('/#') ? href.substring(1) : href;
          const targetSection = document.querySelector(hash);
          if (targetSection) {
            e.preventDefault();
            const contentCol = document.querySelector('.content-col');
            if (contentCol) {
              const targetTop = (targetSection as HTMLElement).offsetTop - 60;
              contentCol.scrollTo({ top: Math.max(0, targetTop), behavior: 'smooth' });
            }
            window.scrollTo({
              top: (targetSection as HTMLElement).offsetTop - 60,
              behavior: 'smooth',
            });
            history.pushState(null, '', hash);
          }
        }
      }
    });

    // Escape Key Accessibility
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        const drawer = document.getElementById('mobileNavDrawer');
        if (
          drawer &&
          (drawer.getAttribute('aria-hidden') === 'false' || drawer.classList.contains('is-open'))
        ) {
          closeMobileMenu();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }

  document.addEventListener('astro:page-load', initNav);
</script>
