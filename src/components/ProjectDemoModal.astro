---
/**
 * ProjectDemoModal.astro — Interactive brutalist HUD overlay modal for project demonstrations.
 * Supports Video Walkthroughs, Live Terminal Replays, and System Architecture Blueprints.
 */
import { projects } from '../data/projects';
---

<div
  id="projectDemoOverlay"
  class="demo-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="demoModalTitle"
  aria-hidden="true"
>
  <div class="demo-modal-card" id="demoModalCard">
    <!-- Modal Tactical HUD Top Bar -->
    <header class="demo-modal-bar">
      <div class="demo-modal-info">
        <span class="demo-modal-badge" id="demoModalBadge">
          SYS_01
        </span>
        <span class="demo-modal-title" id="demoModalTitle">
          Project Demonstration
        </span>
        <span class="demo-modal-meta" id="demoModalMetric">
          // TELEMETRY ACTIVE
        </span>
      </div>

      <!-- Tab Switcher -->
      <nav class="demo-modal-tabs" role="tablist" aria-label="Demo view modes">
        <button
          type="button"
          class="demo-tab-btn is-active"
          data-tab="video"
          role="tab"
          aria-selected="true"
          aria-controls="demoTabVideo"
        >
          <span class="tab-indicator">▶</span>
          <span>DEMO</span>
        </button>
        <button
          type="button"
          class="demo-tab-btn"
          data-tab="terminal"
          role="tab"
          aria-selected="false"
          aria-controls="demoTabTerminal"
        >
          <span class="tab-indicator">&gt;_</span>
          <span>TERMINAL</span>
        </button>
        <button
          type="button"
          class="demo-tab-btn"
          data-tab="architecture"
          role="tab"
          aria-selected="false"
          aria-controls="demoTabArchitecture"
        >
          <span class="tab-indicator">☵</span>
          <span>ARCHITECTURE</span>
        </button>
      </nav>

      <div class="demo-modal-actions">
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          id="demoModalGithub"
          class="demo-btn-repo"
          title="Open repository in new tab"
        >
          <span>GITHUB</span>
          <span aria-hidden="true">↗</span>
        </a>
        <button
          type="button"
          id="demoModalClose"
          class="demo-modal-close"
          aria-label="Close demonstration overlay (Escape)"
          title="Close (ESC)"
        >
          ✕
        </button>
      </div>
    </header>

    <!-- Modal Content Panes -->
    <div class="demo-modal-body">
      <!-- ─── TAB 1: VIDEO DEMONSTRATION ──────────────────────────── -->
      <section id="demoTabVideo" class="demo-pane is-active" role="tabpanel">
        <div class="video-container" id="videoContainer">
          <!-- Active video element -->
          <video id="demoVideoPlayer" class="demo-video-player" playsinline preload="metadata">
            Your browser does not support the video tag.
          </video>

          <!-- Fallback Cyber Scanline Canvas when video is pending upload -->
          <div class="video-sim-overlay" id="videoSimOverlay">
            <div class="crt-scanlines" aria-hidden="true"></div>
            <div class="sim-content">
              <div class="sim-radar">
                <span class="radar-sweep"></span>
                <span class="radar-dot dot-1"></span>
                <span class="radar-dot dot-2"></span>
              </div>
              <div class="sim-meta">
                <span class="sim-status">SYSTEM STREAM ACTIVE</span>
                <h4 class="sim-heading" id="simHeading">
                  Video Feed Initialized
                </h4>
                <p class="sim-desc" id="simDesc">
                  High-resolution screencast demo. Drop MP4 in <code>public/videos/projects/</code>{' '}
                  to replace this telemetry preview.
                </p>
                <div class="sim-metrics" id="simMetrics"></div>
              </div>
            </div>
          </div>

          <!-- Custom HUD Video Controls -->
          <div class="video-hud-controls" id="videoHudControls">
            <button
              type="button"
              class="video-hud-btn"
              id="videoPlayPause"
              title="Play/Pause (Space)"
            >
              <span id="videoPlayIcon">▶</span>
            </button>
            <div class="video-progress-wrap">
              <input
                type="range"
                id="videoScrubber"
                class="video-scrubber"
                min="0"
                max="100"
                value="0"
                step="0.1"
                aria-label="Video scrubber"
              />
              <div class="video-progress-bar" id="videoProgressBar"></div>
            </div>
            <span class="video-time-readout" id="videoTimeReadout">
              00:00 / 00:00
            </span>
            <button type="button" class="video-hud-btn" id="videoMute" title="Mute/Unmute (M)">
              <span id="videoMuteIcon">🔊</span>
            </button>
            <button
              type="button"
              class="video-hud-btn video-rate-btn"
              id="videoRate"
              title="Playback speed"
            >
              1.0x
            </button>
            <button type="button" class="video-hud-btn" id="videoFullscreen" title="Fullscreen (F)">
              ⛶
            </button>
          </div>
        </div>
      </section>

      <!-- ─── TAB 2: TERMINAL BENCHMARK REPLAY ────────────────────── -->
      <section id="demoTabTerminal" class="demo-pane" role="tabpanel">
        <div class="terminal-shell">
          <div class="terminal-shell-bar">
            <div class="terminal-dots">
              <span class="t-dot dot-red"></span>
              <span class="t-dot dot-yellow"></span>
              <span class="t-dot dot-green"></span>
            </div>
            <span class="terminal-shell-title" id="terminalShellTitle">
              bash — session@cluster-node-01: ~
            </span>
            <button
              type="button"
              class="terminal-rerun-btn"
              id="terminalRerunBtn"
              title="Re-run simulated live benchmark"
            >
              <span>↻ RE-RUN</span>
            </button>
          </div>
          <div class="terminal-screen" id="terminalScreen">
            <div class="terminal-prompt-line">
              <span class="prompt-user">bernard@cluster</span>:
              <span class="prompt-dir">~/workspace</span>${' '}
              <span class="prompt-cmd" id="terminalCmd">
                python -m run
              </span>
            </div>
            <div class="terminal-output" id="terminalOutput"></div>
            <div class="terminal-cursor-line">
              <span class="terminal-cursor">█</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ─── TAB 3: ARCHITECTURE SPECS ───────────────────────────── -->
      <section id="demoTabArchitecture" class="demo-pane" role="tabpanel">
        <div class="architecture-layout">
          <div class="arch-summary-card">
            <span class="arch-kicker">PIPELINE TOPOLOGY</span>
            <p class="arch-summary-text" id="archSummaryText"></p>
          </div>

          <div class="arch-benchmarks-grid" id="archBenchmarksGrid"></div>

          <div class="arch-two-col">
            <div class="arch-nodes-card">
              <span class="arch-kicker">CORE MICROSERVICES & COMPONENT NODES</span>
              <div class="arch-nodes-list" id="archNodesList"></div>
            </div>

            <div class="arch-pipeline-card">
              <span class="arch-kicker">EXECUTION FLOW SEQUENCE</span>
              <ol class="arch-pipeline-list" id="archPipelineList"></ol>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Modal Tactical HUD Bottom Bar -->
    <footer class="demo-modal-footer">
      <div class="demo-footer-tags" id="demoFooterTags"></div>
      <div class="demo-footer-status">
        <span class="status-pulse-dot"></span>
        <span id="demoFooterStatusText">BENCHMARK VERIFIED // PRODUCTION GRADE</span>
      </div>
    </footer>
  </div>
</div>

<script>
  import { projects, type Project } from '../data/projects';

  function initProjectDemoModal() {
    const overlay = document.getElementById('projectDemoOverlay');
    const closeBtn = document.getElementById('demoModalClose');
    const player = document.getElementById('demoVideoPlayer') as HTMLVideoElement | null;
    const playPauseBtn = document.getElementById('videoPlayPause');
    const playIcon = document.getElementById('videoPlayIcon');
    const muteBtn = document.getElementById('videoMute');
    const muteIcon = document.getElementById('videoMuteIcon');
    const rateBtn = document.getElementById('videoRate');
    const fsBtn = document.getElementById('videoFullscreen');
    const scrubber = document.getElementById('videoScrubber') as HTMLInputElement | null;
    const progressBar = document.getElementById('videoProgressBar');
    const timeReadout = document.getElementById('videoTimeReadout');
    const rerunBtn = document.getElementById('terminalRerunBtn');

    if (!overlay || !closeBtn) return;
    if (overlay.dataset.demoBound === 'true') return;
    overlay.dataset.demoBound = 'true';

    let currentProject: Project | null = null;
    let typingTimer: number | null = null;
    let previousFocus: HTMLElement | null = null;
    const playbackRates = [1.0, 1.5, 2.0];
    let rateIndex = 0;

    // Helper: format seconds to MM:SS
    function fmtTime(sec: number): string {
      if (isNaN(sec) || sec < 0) return '00:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    // Switch Tabs
    function setTab(tabName: string) {
      const tabs = overlay!.querySelectorAll<HTMLElement>('.demo-tab-btn');
      const panes = overlay!.querySelectorAll<HTMLElement>('.demo-pane');

      tabs.forEach((tab) => {
        const isTarget = tab.dataset.tab === tabName;
        tab.classList.toggle('is-active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      panes.forEach((pane) => {
        const isTarget =
          (tabName === 'video' && pane.id === 'demoTabVideo') ||
          (tabName === 'terminal' && pane.id === 'demoTabTerminal') ||
          (tabName === 'architecture' && pane.id === 'demoTabArchitecture');
        pane.classList.toggle('is-active', isTarget);
      });

      if (tabName === 'terminal' && currentProject) {
        startTerminalReplay(currentProject);
      }
    }

    // Load Project Data into Modal
    function loadProject(project: Project) {
      currentProject = project;

      // Header readouts
      const badge = document.getElementById('demoModalBadge');
      const title = document.getElementById('demoModalTitle');
      const metric = document.getElementById('demoModalMetric');
      const githubLink = document.getElementById('demoModalGithub') as HTMLAnchorElement | null;
      if (badge) badge.textContent = project.id;
      if (title) title.textContent = project.name;
      if (metric) metric.textContent = `// ${project.metric}`;
      if (githubLink) githubLink.href = project.githubUrl;

      // Video Feed Setup
      const simOverlay = document.getElementById('videoSimOverlay');
      const simHeading = document.getElementById('simHeading');
      const simDesc = document.getElementById('simDesc');
      const simMetrics = document.getElementById('simMetrics');

      if (simHeading) simHeading.textContent = project.name;
      if (simDesc) simDesc.textContent = project.demo.summary;

      if (simMetrics) {
        simMetrics.innerHTML = project.demo.architecture.benchmarks
          .map(
            (b) => `
          <div class="sim-metric-item">
            <span class="sim-m-val">${b.value}</span>
            <span class="sim-m-lbl">${b.label}</span>
          </div>
        `,
          )
          .join('');
      }

      if (player) {
        if (project.demo.videoSrc) {
          player.src = project.demo.videoSrc;
          player.style.display = 'block';
          if (simOverlay) simOverlay.style.display = 'none';
        } else {
          player.pause();
          player.src = '';
          player.style.display = 'none';
          if (simOverlay) simOverlay.style.display = 'flex';
        }
      }

      // Terminal Setup
      const terminalCmd = document.getElementById('terminalCmd');
      const terminalTitle = document.getElementById('terminalShellTitle');
      if (terminalCmd) terminalCmd.textContent = project.demo.terminalCmd;
      if (terminalTitle)
        terminalTitle.textContent = `bash — cluster-job@${project.id.toLowerCase()}: ~`;

      // Architecture Setup
      const archSummary = document.getElementById('archSummaryText');
      if (archSummary) archSummary.textContent = project.demo.architecture.summary;

      const benchmarksGrid = document.getElementById('archBenchmarksGrid');
      if (benchmarksGrid) {
        benchmarksGrid.innerHTML = project.demo.architecture.benchmarks
          .map(
            (b) => `
          <div class="arch-benchmark-card">
            <span class="b-val">${b.value}</span>
            <span class="b-label">${b.label}</span>
            <span class="b-delta">${b.delta}</span>
          </div>
        `,
          )
          .join('');
      }

      const nodesList = document.getElementById('archNodesList');
      if (nodesList) {
        nodesList.innerHTML = project.demo.architecture.nodes
          .map(
            (node) => `
          <div class="arch-node-item">
            <div class="node-head">
              <span class="node-name">${node.name}</span>
              <span class="node-tech">${node.tech}</span>
            </div>
            <p class="node-role">${node.role}</p>
          </div>
        `,
          )
          .join('');
      }

      const pipelineList = document.getElementById('archPipelineList');
      if (pipelineList) {
        pipelineList.innerHTML = project.demo.architecture.pipeline
          .map((step) => `<li><span>${step}</span></li>`)
          .join('');
      }

      // Footer Tags
      const footerTags = document.getElementById('demoFooterTags');
      if (footerTags) {
        footerTags.innerHTML = project.tags
          .map((tag) => `<span class="demo-tag">${tag}</span>`)
          .join('');
      }

      setTab('video');
    }

    // Terminal Typewriter Streaming
    function startTerminalReplay(project: Project) {
      if (typingTimer !== null) {
        window.clearTimeout(typingTimer);
        typingTimer = null;
      }

      const output = document.getElementById('terminalOutput');
      if (!output) return;
      output.innerHTML = '';

      const logs = project.demo.terminalLogs;
      let logIndex = 0;

      function printNextLog() {
        if (logIndex >= logs.length) return;
        const line = logs[logIndex];
        const logRow = document.createElement('div');
        logRow.className = `terminal-row level-${line.level.toLowerCase()}`;
        logRow.innerHTML = `
          <span class="t-time">[${line.time}]</span>
          <span class="t-badge">${line.level}</span>
          <span class="t-msg">${line.message}</span>
        `;
        output!.appendChild(logRow);
        output!.scrollTop = output!.scrollHeight;

        logIndex++;
        const nextDelay = 180 + Math.random() * 240;
        typingTimer = window.setTimeout(printNextLog, nextDelay);
      }

      printNextLog();
    }

    // Open Modal
    function openModal(projectId: string) {
      const match = projects.find((p) => p.id === projectId) || projects[0];
      previousFocus = document.activeElement as HTMLElement | null;

      loadProject(match);

      overlay!.classList.add('is-active');
      void overlay!.offsetWidth; // force reflow
      overlay!.classList.add('is-visible');
      overlay!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Dispatch event to pause/duck ambient music
      window.dispatchEvent(new CustomEvent('modalopen', { detail: { modal: 'project-demo' } }));

      closeBtn!.focus();
    }

    // Close Modal
    function closeModal() {
      if (player) {
        player.pause();
      }
      if (typingTimer !== null) {
        window.clearTimeout(typingTimer);
        typingTimer = null;
      }

      overlay!.classList.remove('is-visible');
      overlay!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      setTimeout(() => {
        if (!overlay!.classList.contains('is-visible')) {
          overlay!.classList.remove('is-active');
        }
      }, 220);

      // Dispatch event to resume ambient music
      window.dispatchEvent(new CustomEvent('modalclose', { detail: { modal: 'project-demo' } }));

      if (previousFocus && typeof previousFocus.focus === 'function') {
        previousFocus.focus();
      }
    }

    // Tab buttons click
    overlay.querySelectorAll<HTMLElement>('.demo-tab-btn').forEach((tabBtn) => {
      tabBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const tab = tabBtn.dataset.tab;
        if (tab) setTab(tab);
      });
    });

    // Global click listener for demo open buttons
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('[data-open-project-demo]');
      if (target) {
        e.preventDefault();
        const projectId = target.getAttribute('data-open-project-demo') || 'SYS_01';
        openModal(projectId);
      }
    });

    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      closeModal();
    });

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeModal();
      }
    });

    // Terminal Re-run
    rerunBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (currentProject) {
        startTerminalReplay(currentProject);
      }
    });

    // Video Player Custom Controls
    if (player) {
      function togglePlay() {
        if (player!.paused) {
          player!.play();
          if (playIcon) playIcon.textContent = '❚❚';
        } else {
          player!.pause();
          if (playIcon) playIcon.textContent = '▶';
        }
      }

      playPauseBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        togglePlay();
      });

      player.addEventListener('timeupdate', () => {
        const cur = player!.currentTime;
        const dur = player!.duration || 0;
        const pct = dur > 0 ? (cur / dur) * 100 : 0;
        if (scrubber) scrubber.value = String(pct);
        if (progressBar) progressBar.style.width = `${pct}%`;
        if (timeReadout) timeReadout.textContent = `${fmtTime(cur)} / ${fmtTime(dur)}`;
      });

      player.addEventListener('play', () => {
        if (playIcon) playIcon.textContent = '❚❚';
      });

      player.addEventListener('pause', () => {
        if (playIcon) playIcon.textContent = '▶';
      });

      scrubber?.addEventListener('input', (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        if (player!.duration) {
          player!.currentTime = (val / 100) * player!.duration;
        }
      });

      muteBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        player!.muted = !player!.muted;
        if (muteIcon) muteIcon.textContent = player!.muted ? '🔇' : '🔊';
      });

      rateBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        rateIndex = (rateIndex + 1) % playbackRates.length;
        const rate = playbackRates[rateIndex];
        player!.playbackRate = rate;
        if (rateBtn) rateBtn.textContent = `${rate.toFixed(1)}x`;
      });

      fsBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const container = document.getElementById('videoContainer');
        if (!container) return;
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        } else {
          container.requestFullscreen().catch(() => {});
        }
      });
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (!overlay!.classList.contains('is-visible')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === ' ' && (e.target === document.body || e.target === overlay)) {
        e.preventDefault();
        if (player && player.style.display !== 'none') {
          if (player.paused) player.play();
          else player.pause();
        }
      } else if (e.key === '1') {
        setTab('video');
      } else if (e.key === '2') {
        setTab('terminal');
      } else if (e.key === '3') {
        setTab('architecture');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectDemoModal);
  } else {
    initProjectDemoModal();
  }

  document.addEventListener('astro:page-load', initProjectDemoModal);
</script>

<style>
  /* Base Modal Backdrop */
  .demo-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(var(--bg-rgb, 7, 9, 10), 0.78);
    backdrop-filter: var(--glass-blur, blur(16px) saturate(160%));
    -webkit-backdrop-filter: var(--glass-blur, blur(16px) saturate(160%));
    opacity: 0;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .demo-modal-backdrop.is-active {
    display: flex;
  }

  .demo-modal-backdrop.is-visible {
    opacity: 1;
  }

  /* Modal Card Frame */
  .demo-modal-card {
    width: 100%;
    max-width: 980px;
    height: 88vh;
    max-height: 840px;
    background: var(--glass-bg, rgba(7, 9, 10, 0.88));
    backdrop-filter: var(--glass-blur, blur(16px));
    -webkit-backdrop-filter: var(--glass-blur, blur(16px));
    border: 1px solid var(--glass-border, rgba(238, 240, 230, 0.16));
    border-radius: var(--radius, 4px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      var(--glass-specular, inset 0 1px 1px rgba(255, 255, 255, 0.18)),
      0 32px 80px rgba(0, 0, 0, 0.85);
    transform: scale(0.97) translateY(8px);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .demo-modal-backdrop.is-visible .demo-modal-card {
    transform: scale(1) translateY(0);
  }

  /* Header Bar */
  .demo-modal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(var(--bg-rgb, 7, 9, 10), 0.7);
    border-bottom: 1px solid var(--hairline);
    flex-shrink: 0;
  }

  .demo-modal-info {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
  }

  .demo-modal-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 2px 6px;
    border-radius: 2px;
    background: rgba(var(--accent-rgb), 0.18);
    color: var(--accent);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
  }

  .demo-modal-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .demo-modal-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  /* Tabs Navigation */
  .demo-modal-tabs {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.4);
    padding: 2px;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
  }

  .demo-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .demo-tab-btn:hover {
    color: var(--ink);
    border-color: var(--hairline-hover);
  }

  .demo-tab-btn.is-active {
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.14);
    border-color: rgba(var(--accent-rgb), 0.4);
    box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.25);
  }

  .demo-modal-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .demo-btn-repo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--font-mono);
