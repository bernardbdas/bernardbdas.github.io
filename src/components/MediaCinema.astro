---
/**
 * MediaCinema.astro — Curated Cinema & Feature Films Archive
 * Searchable, filterable catalogue by genre, director, cast, and OTT streaming platforms.
 */
import { CURATED_MOVIES, type MovieItem } from '../data/media-curation';

const allGenres = Array.from(new Set(CURATED_MOVIES.flatMap((m) => m.genres))).sort();
const allPlatforms = Array.from(new Set(CURATED_MOVIES.flatMap((m) => m.ottPlatforms))).sort();
---

<div class="media-catalogue-container" id="cinema-catalogue-root">
  <!-- Filter & Search Toolbar -->
  <div class="media-toolbar">
    <div class="media-search-wrap">
      <span class="search-icon" aria-hidden="true">
        ⌕
      </span>
      <input
        type="search"
        id="cinema-search-input"
        class="media-search-input"
        placeholder="SEARCH FILMS, DIRECTORS (NOLAN, VILLENEUVE...), CAST (GOSLING...), OR KEYWORDS..."
        aria-label="Search curated cinema archive"
      />
      <button
        type="button"
        id="cinema-search-clear"
        class="search-clear-btn"
        aria-label="Clear search"
        style="display: none;"
      >
        ✕
      </button>
    </div>

    <!-- Platform Filter Pills -->
    <div class="media-filter-group">
      <span class="filter-group-label">STREAMING PLATFORM:</span>
      <div class="filter-pills-row" id="cinema-platform-pills" role="tablist">
        <button
          type="button"
          class="filter-pill active"
          data-filter-platform="ALL"
          role="tab"
          aria-selected="true"
        >
          ALL ({CURATED_MOVIES.length})
        </button>
        {allPlatforms.map((plat) => {
          const count = CURATED_MOVIES.filter((m) => m.ottPlatforms.includes(plat)).length;
          return (
            <button
              type="button"
              class="filter-pill"
              data-filter-platform={plat}
              role="tab"
              aria-selected="false"
            >
              {plat} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Genre Filter Pills -->
    <div class="media-filter-group">
      <span class="filter-group-label">GENRE FILTER:</span>
      <div class="filter-pills-row" id="cinema-genre-pills" role="tablist">
        <button
          type="button"
          class="filter-pill active"
          data-filter-genre="ALL"
          role="tab"
          aria-selected="true"
        >
          ALL
        </button>
        {allGenres.map((g) => (
          <button
            type="button"
            class="filter-pill"
            data-filter-genre={g}
            role="tab"
            aria-selected="false"
          >
            {g}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Counter Status Row -->
  <div class="catalogue-status-bar">
    <span class="catalogue-count" id="cinema-visible-count">
      INDEX: {CURATED_MOVIES.length} CURATED FEATURE FILMS
    </span>
    <span class="catalogue-telemetry">FILTER_STATUS: OPTIMAL // LIVE QUERY</span>
  </div>

  <!-- Movies Grid -->
  <div class="media-cards-grid" id="cinema-cards-grid" role="list">
    {CURATED_MOVIES.map((movie: MovieItem) => (
      <article
        class="media-item-card"
        id={`movie-${movie.id}`}
        data-title={movie.title.toLowerCase()}
        data-director={movie.director.toLowerCase()}
        data-cast={movie.cast.join(' ').toLowerCase()}
        data-genres={movie.genres.join(',')}
        data-platforms={movie.ottPlatforms.join(',')}
        data-year={movie.year}
        role="listitem"
      >
        <div class="dev-card-corner-tl" aria-hidden="true"></div>
        <div class="dev-card-corner-br" aria-hidden="true"></div>

        <!-- Card Header -->
        <div class="media-card-header">
          <div class="media-title-wrap">
            <h3 class="media-title">{movie.title}</h3>
            <span class="media-year">({movie.year})</span>
          </div>
          <div class="media-rating-badge" title="Bernard's Curated Rating">
            <span class="rating-star">★</span>
            <span class="rating-num">{movie.rating}</span>
          </div>
        </div>

        <!-- Meta Specifications -->
        <div class="media-specs-grid">
          <div class="spec-item">
            <span class="spec-k">DIRECTOR</span>
            <span class="spec-v highlight-director">{movie.director}</span>
          </div>
          <div class="spec-item">
            <span class="spec-k">RUNTIME</span>
            <span class="spec-v">{movie.runtime}</span>
          </div>
          <div class="spec-item spec-span-2">
            <span class="spec-k">KEY CAST</span>
            <span class="spec-v cast-list">{movie.cast.join(' • ')}</span>
          </div>
        </div>

        <!-- Synopsis -->
        <p class="media-synopsis">{movie.synopsis}</p>

        <!-- Bernard's Takeaway Note -->
        <div class="media-takeaway-box">
          <span class="takeaway-label">CURATOR'S ANALYSIS:</span>
          <p class="takeaway-text">{movie.takeaway}</p>
        </div>

        <!-- Footer: Genres & OTT Platforms -->
        <div class="media-card-footer">
          <div class="media-genres-tags">
            {movie.genres.map((g) => (
              <span class="media-genre-chip">{g}</span>
            ))}
          </div>

          <div class="media-ott-badges" aria-label="Available OTT Streaming Services">
            {movie.ottPlatforms.map((plat) => (
              <span class="ott-badge" data-ott={plat}>
                {plat}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Empty Search Results Notice -->
  <div class="media-empty-notice" id="cinema-empty-notice" style="display: none;">
    <span class="status-dot status-warn"></span>
    <span class="empty-title">NO MATCHING CINEMA RECORDS FOUND</span>
    <p class="empty-desc">
      Adjust your genre, platform filter, or search query to match indexed films.
    </p>
    <button type="button" id="cinema-reset-filters-btn" class="dev-btn">
      RESET CINEMA FILTERS
    </button>
  </div>
</div>
