---
import Loader from './Loader.astro';

/**
 * Hero — Main landing section.
 * Focus strip, resume/systems links, and educational experience.
 */
interface WorkEntry {
  period: string;
  duration?: string;
  company: string;
  role: string;
  location?: string;
}

interface EduEntry {
  period: string;
  duration?: string;
  institute: string;
  degree: string;
}

const experience: WorkEntry[] = [
  {
    period: '2023 - 2025',
    duration: '2 years',
    company: 'Simplify3x Software Private Limited',
    role: 'Software Engineer',
    location: 'Bengaluru, Karnataka',
  },
];

const education: EduEntry[] = [
  {
    period: '2024 - Present',
    duration: 'Ongoing',
    institute: 'CHRIST (Deemed-to-be-University), Bangalore, Karnataka',
    degree: 'PhD in Data Science',
  },
  {
    period: '2021 - 2023',
    duration: '2 years',
    institute: 'CHRIST (Deemed-to-be-University), Bangalore, Karnataka',
    degree: 'MCA with Data Analytics',
  },
  {
    period: '2018 - 2021',
    duration: '3 years',
    institute: "St. Xavier's College (Autonomous), Kolkata, West Bengal",
    degree: 'BSc (Honours) Computer Science with Physics and Mathematics',
  },
  {
    period: '2004 - 2018',
    duration: '14 years',
    institute: 'Auxilium Convent School, Barasat, West Bengal',
    degree: 'High School (ISC & ICSE)',
  },
];
---

<section class="section hero anim-hero" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="hero-name">
    <span class="hero-name-wrap" id="heroNameWrap" lang="en">
      <span class="hero-name-first" id="heroNameFirst">
        Bernard
      </span>
      <span class="hero-name-rest" id="heroNameRest">
        {' '}
        Birendra Das
      </span>
    </span>
    <span class="caret" aria-hidden="true"></span>
  </h1>

  <p class="focus-strip">
    Deep Learning <span aria-hidden="true">•</span> LLM Pipelines <span aria-hidden="true">•</span>{' '}
    Distributed MLOps
  </p>

  <div class="hero-links">
    <a
      class="hero-link"
      href="#resume"
      data-open-resume-overlay
      role="button"
      aria-haspopup="dialog"
    >
      View Resume{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
    <a class="hero-link" href="#work">
      Explore AI Systems{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
  </div>

  <div class="hero-work" aria-label="Work Experience">
    <p class="edu-label">
      <Loader />
      WORK EXPERIENCE
    </p>
    <div class="edu-list" role="list">
      {experience.map((item) => (
        <div class="edu-item" role="listitem">
          <div class="edu-period-col">
            <span class="edu-period">{item.period}</span>
            {item.duration && <span class="edu-duration">{item.duration}</span>}
          </div>
          <div class="edu-details">
            <span class="edu-institute">{item.company}</span>
            <span class="edu-degree">
              {item.role}
              {item.location && <span> — {item.location}</span>}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-education" aria-label="Academic Experience">
    <p class="edu-label">ACADEMIC EXPERIENCE</p>
    <div class="edu-list" role="list">
      {education.map((item) => (
        <div class="edu-item" role="listitem">
          <div class="edu-period-col">
            <span class="edu-period">{item.period}</span>
            {item.duration && <span class="edu-duration">{item.duration}</span>}
          </div>
          <div class="edu-details">
            <span class="edu-institute">{item.institute}</span>
            <span class="edu-degree">{item.degree}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  interface Signature {
    first: string;
    rest: string;
    lang: string;
  }

  const SIGNATURES: Signature[] = [
    { first: 'Bernard', rest: ' Birendra Das', lang: 'en' },
    { first: 'बर्नार्ड', rest: ' बीरेंद्र दास', lang: 'hi' },
    { first: 'বার্নার্ড', rest: ' বীরেন্দ্র দাস', lang: 'bn' },
  ];

  let heroTypewriterTimer: number | null = null;
  let currentSigIndex = 0;
  let isErasing = false;
  let currentGraphemeIndex = 0;

  function getGraphemes(str: string): string[] {
    if (typeof Intl !== 'undefined' && 'Segmenter' in Intl) {
      const segmenter = new (Intl as any).Segmenter(undefined, { granularity: 'grapheme' });
      return Array.from(segmenter.segment(str), (s: any) => s.segment);
    }
    return Array.from(str);
  }

  function initHeroTypewriter(): void {
    if (heroTypewriterTimer !== null) {
      clearTimeout(heroTypewriterTimer);
      heroTypewriterTimer = null;
    }

    const wrapEl = document.getElementById('heroNameWrap');
    const firstEl = document.getElementById('heroNameFirst');
    const restEl = document.getElementById('heroNameRest');

    const headerWrapEl = document.getElementById('headerNameWrap');
    const headerFirstEl = document.getElementById('headerNameFirst');
    const headerRestEl = document.getElementById('headerNameRest');

    if (!wrapEl || !firstEl || !restEl) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      firstEl.textContent = SIGNATURES[0].first;
      restEl.textContent = SIGNATURES[0].rest;
      wrapEl.setAttribute('lang', SIGNATURES[0].lang);
      if (headerFirstEl) headerFirstEl.textContent = SIGNATURES[0].first;
      if (headerRestEl) headerRestEl.textContent = SIGNATURES[0].rest;
      if (headerWrapEl) headerWrapEl.setAttribute('lang', SIGNATURES[0].lang);
      return;
    }

    let sigIndex = currentSigIndex;
    let erasing = isErasing;

    function renderGraphemes(sig: Signature, count: number): void {
      const fg = getGraphemes(sig.first);
      const rg = getGraphemes(sig.rest);
      let firstText = '';
      let restText = '';
      if (count <= fg.length) {
        firstText = fg.slice(0, count).join('');
        restText = '';
      } else {
        firstText = fg.join('');
        restText = rg.slice(0, count - fg.length).join('');
      }

      firstEl!.textContent = firstText;
      restEl!.textContent = restText;
      if (headerFirstEl) headerFirstEl.textContent = firstText;
      if (headerRestEl) headerRestEl.textContent = restText;
    }

    const initialSig = SIGNATURES[sigIndex];
    const initialFg = getGraphemes(initialSig.first);
    const initialRg = getGraphemes(initialSig.rest);
    const totalChars = initialFg.length + initialRg.length;
    let charIdx = currentGraphemeIndex > 0 ? currentGraphemeIndex : totalChars;

    function step(): void {
      const currentSig = SIGNATURES[sigIndex];
      const fg = getGraphemes(currentSig.first);
      const rg = getGraphemes(currentSig.rest);
      const maxCount = fg.length + rg.length;

      if (erasing) {
        if (charIdx > 0) {
          charIdx--;
          renderGraphemes(currentSig, charIdx);
          heroTypewriterTimer = window.setTimeout(step, 40);
        } else {
          erasing = false;
          sigIndex = (sigIndex + 1) % SIGNATURES.length;
          currentSigIndex = sigIndex;
          isErasing = false;
          currentGraphemeIndex = 0;
          wrapEl!.setAttribute('lang', SIGNATURES[sigIndex].lang);
          if (headerWrapEl) headerWrapEl.setAttribute('lang', SIGNATURES[sigIndex].lang);
          heroTypewriterTimer = window.setTimeout(step, 400);
        }
      } else {
        if (charIdx < maxCount) {
          charIdx++;
          renderGraphemes(currentSig, charIdx);
          heroTypewriterTimer = window.setTimeout(step, 80);
        } else {
          erasing = true;
          isErasing = true;
          currentGraphemeIndex = charIdx;
          heroTypewriterTimer = window.setTimeout(step, 3000);
        }
      }
    }

    if (firstEl.textContent === initialSig.first && restEl.textContent === initialSig.rest) {
      charIdx = totalChars;
      erasing = true;
      heroTypewriterTimer = window.setTimeout(step, 3200);
    } else {
      step();
    }
  }

  function initHeaderScrollDock(): void {
    const heroHeading = document.getElementById('hero-heading');
    const contentCol = document.querySelector('.content-col');
    const chromeTop = document.querySelector('.chrome-top');
    const html = document.documentElement;
    if (!heroHeading) return;

    function updateDock(): void {
      const rect = heroHeading!.getBoundingClientRect();
      // The fixed header height (~46px).
      // The moment the big hero name touches or moves past the header, dock the name and vanish the big name.
      const headerBottom = chromeTop ? chromeTop.getBoundingClientRect().bottom : 48;
      const shouldDock = rect.top <= headerBottom + 2;

      if (shouldDock) {
        if (!html.classList.contains('header-name-docked')) {
          html.classList.add('header-name-docked');
        }
      } else {
        if (html.classList.contains('header-name-docked')) {
          html.classList.remove('header-name-docked');
        }
      }
    }

    // Instant direct event bindings during active touch drag, inertial scroll, or mouse wheel
    window.addEventListener('scroll', updateDock, { passive: true });
    window.addEventListener('touchmove', updateDock, { passive: true });
    window.addEventListener('wheel', updateDock, { passive: true });
    contentCol?.addEventListener('scroll', updateDock, { passive: true });
    contentCol?.addEventListener('touchmove', updateDock, { passive: true });
    document.addEventListener('scroll', updateDock, { passive: true });
    window.addEventListener('resize', updateDock, { passive: true });

    // IntersectionObserver for compositor-level frame updates
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        () => {
          updateDock();
        },
        { root: null, rootMargin: '-46px 0px 0px 0px', threshold: [0, 0.5, 1] },
      );
      observer.observe(heroHeading);
    }

    // Smooth scroll back to top when clicked on header name
    const headerNameLink = document.querySelector('.header-name-link');
    headerNameLink?.addEventListener('click', (e) => {
      e.preventDefault();
      if (contentCol && contentCol.scrollTop > 0) {
        contentCol.scrollTo({ top: 0, behavior: 'smooth' });
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Run initial check
    updateDock();
  }

  function initAll(): void {
    initHeroTypewriter();
    initHeaderScrollDock();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('astro:page-load', initAll);
</script>
