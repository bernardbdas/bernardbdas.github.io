---
/**
 * Hero — Main landing section.
 * Micro-label, H1 with blinking caret, focus strip, links, and educational journey.
 */
import Loader from './Loader.astro';

interface EduEntry {
  period: string;
  institute: string;
  degree: string;
}

const education: EduEntry[] = [
  {
    period: '2024 – Present',
    institute: 'CHRIST (Deemed-to-be-University), Bangalore',
    degree: 'PhD in Data Science',
  },
  {
    period: '2021 – 2023',
    institute: 'CHRIST (Deemed-to-be-University), Bangalore',
    degree: 'MCA with Data Analytics',
  },
  {
    period: '2018 – 2021',
    institute: "St. Xavier's College (Autonomous), Kolkata",
    degree: 'BSc (Honours) Computer Science',
  },
  {
    period: '2004 – 2018',
    institute: 'Auxilium Convent School, Barasat',
    degree: 'High School (ISC & ICSE)',
  },
];
---

<section class="section hero anim-hero" aria-labelledby="hero-heading">
  <p class="micro-label">
    <Loader />
    AI &amp; Machine Learning Engineer
  </p>

  <h1 id="hero-heading">
    Bernard Birendra Das<span class="caret" aria-hidden="true"></span>
  </h1>

  <p class="focus-strip">
    Deep Learning <span aria-hidden="true">•</span> LLM Pipelines <span aria-hidden="true">•</span>{' '}
    Distributed MLOps
  </p>

  <div class="hero-links">
    <a
      class="hero-link"
      href="/bernard-resume-sourceserifpro.pdf"
      target="_blank"
      rel="noopener noreferrer"
    >
      View Visual Resume{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
    <a class="hero-link" href="#works">
      Explore AI Systems{' '}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
  </div>

  <div class="hero-education" aria-label="Educational Journey">
    <p class="edu-label">EDUCATIONAL JOURNEY</p>
    <div class="edu-list" role="list">
      {education.map((item) => (
        <div class="edu-item" role="listitem">
          <span class="edu-period">{item.period}</span>
          <div class="edu-details">
            <span class="edu-institute">{item.institute}</span>
            <span class="edu-degree">{item.degree}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
