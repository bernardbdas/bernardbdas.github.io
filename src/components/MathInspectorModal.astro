---
/**
 * MathInspectorModal.astro — Interactive Formula Inspector & Variable Decoder
 * Opens when any mathematical expression is clicked on the research page.
 * Reveals a plain-English explanation of how variables interact, complete with
 * KaTeX rendering and an authentic cybernetic terminal reveal effect.
 */
import { MATH_EQUATIONS } from '../data/math-dictionary';
---

<div
  id="math-inspector-overlay"
  class="math-inspector-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="inspector-equation-title"
>
  <div class="math-inspector-modal" id="math-inspector-modal">
    <!-- Brutalist Corner Accents -->
    <div class="dev-card-corner-tl" aria-hidden="true"></div>
    <div class="dev-card-corner-br" aria-hidden="true"></div>

    <!-- Modal Header -->
    <div class="inspector-header">
      <div class="inspector-header-left">
        <span class="inspector-kicker">// MATHEMATICAL EXPRESSION DECODER</span>
        <h2 id="inspector-equation-title" class="inspector-title">
          FORMULA INSPECTION
        </h2>
        <span id="inspector-context-badge" class="inspector-context-badge">
          SYSTEM CONTEXT
        </span>
      </div>
      <button
        type="button"
        id="inspector-close-btn"
        class="inspector-close-btn"
        aria-label="Close formula inspector"
      >
        <span>[ ESC // CLOSE ✕ ]</span>
      </button>
    </div>

    <!-- Animated Scanline Accent -->
    <div class="inspector-scanline-bar" aria-hidden="true"></div>

    <!-- Formula Display Box (KaTeX) -->
    <div class="inspector-formula-box" id="inspector-formula-display">
      <!-- KaTeX rendered equation injected here -->
    </div>

    <!-- Plain-English "How It Works Together" Section -->
    <div class="inspector-how-it-works">
      <div class="section-tag-row">
        <span class="tag-marker">■</span>
        <span class="tag-label">HOW IT WORKS TOGETHER // IN PLAIN ENGLISH</span>
      </div>
      <p id="inspector-layman-text" class="inspector-layman-text">
        <!-- Layperson explanation injected here -->
      </p>
    </div>

    <!-- Variables Breakdown Grid -->
    <div class="inspector-variables-section">
      <div class="section-tag-row">
        <span class="tag-marker">■</span>
        <span class="tag-label">VARIABLE &amp; OPERATOR BREAKDOWN</span>
      </div>
      <div class="inspector-vars-grid" id="inspector-vars-container">
        <!-- Variable breakdown cards dynamically rendered here -->
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="inspector-footer">
      <button type="button" id="inspector-jump-dict-btn" class="inspector-action-btn">
        <span>↓ JUMP TO VARIABLE DICTIONARY</span>
      </button>
      <span class="inspector-hint">PRESS ESC OR CLICK OUTSIDE TO DISMISS</span>
    </div>
  </div>
</div>

<!-- Embedded JSON data for client script -->
<script is:inline define:vars={{ equationsJson: JSON.stringify(MATH_EQUATIONS) }}>
  window.__MATH_EQUATIONS_DATA__ = JSON.parse(equationsJson);
</script>

<script>
  import type { MathEquation } from '../data/math-dictionary';

  declare global {
    interface Window {
      __MATH_EQUATIONS_DATA__?: MathEquation[];
    }
  }

  function initMathInspector() {
    const overlay = document.getElementById('math-inspector-overlay');
    const modal = document.getElementById('math-inspector-modal');
    const closeBtn = document.getElementById('inspector-close-btn');
    const titleEl = document.getElementById('inspector-equation-title');
    const contextEl = document.getElementById('inspector-context-badge');
    const formulaDisplay = document.getElementById('inspector-formula-display');
    const laymanText = document.getElementById('inspector-layman-text');
    const varsContainer = document.getElementById('inspector-vars-container');
    const jumpBtn = document.getElementById('inspector-jump-dict-btn');

    if (!overlay || !modal) return;

    const equations: MathEquation[] = window.__MATH_EQUATIONS_DATA__ || [];

    function openEquation(eqId: string) {
      const eq = equations.find((item) => item.id === eqId);
      if (!eq) return;

      if (titleEl) titleEl.textContent = eq.name;
      if (contextEl) contextEl.textContent = eq.context;
      if (formulaDisplay) formulaDisplay.innerHTML = eq.html;
      if (laymanText) laymanText.textContent = eq.intuitiveSummary;

      if (varsContainer) {
        varsContainer.innerHTML = '';
        eq.variables.forEach((v) => {
          const card = document.createElement('div');
          card.className = 'inspector-var-card';
          card.innerHTML = `
            <div class="iv-top">
              <div class="iv-symbol">${v.symbolHtml}</div>
              <div class="iv-name">${v.name}</div>
            </div>
            <p class="iv-plain"><strong>Role:</strong> ${v.plainRole}</p>
            <p class="iv-tech"><strong>Definition:</strong> ${v.technicalDef}</p>
          `;
          varsContainer.appendChild(card);
        });
      }

      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Play cybernetic reveal effect
      modal.classList.remove('math-reveal-anim');
      void modal.offsetWidth; // Trigger reflow
      modal.classList.add('math-reveal-anim');
    }

    function closeModal() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach listeners to all clickable math triggers across the page
    document.querySelectorAll<HTMLElement>('[data-equation-id]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const eqId = trigger.dataset.equationId;
        if (eqId) {
          openEquation(eqId);
        }
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
        closeModal();
      }
    });

    jumpBtn?.addEventListener('click', () => {
      closeModal();
      const dictSection = document.getElementById('variable-dictionary');
      if (dictSection) {
        dictSection.scrollIntoView({ behavior: 'smooth' });
        dictSection.classList.add('highlight-flash');
        setTimeout(() => {
          dictSection.classList.remove('highlight-flash');
        }, 2000);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMathInspector);
  } else {
    initMathInspector();
  }
</script>
