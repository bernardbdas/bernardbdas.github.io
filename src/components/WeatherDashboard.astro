        </section>

        <!-- Module 6: Environmental Radiance & AQI Spectrum -->
        <section
          class="weather-card span-hero"
          id="card-air-uv"
          draggable="true"
          data-card-id="card-air-uv"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_06 // ENVIRONMENTAL RADIANCE & SPECTRUM</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content spectrum-content-hero">
            <!-- AQI Cockpit Pod -->
            <div class="instrument-glass-pod spectrum-pod">
              <div class="spectrum-top">
                <div class="s-left-meta">
                  <span class="s-label">AIR QUALITY INDEX [AQI]</span>
                  <span class="s-badge" id="weatherAqiCategory">
                    MODERATE
                  </span>
                </div>
                <span class="s-num" id="weatherAqiVal">
                  136
                </span>
              </div>
              <div class="spectrum-track aqi-track">
                <div class="spectrum-pip" id="weatherAqiPip" style="left: 45%;"></div>
              </div>
              <div class="spectrum-sub-telemetry">
                <span class="s-chip">PM2.5: 38 µg/m³</span>
                <span class="s-chip">PM10: 52 µg/m³</span>
                <span class="s-chip">O3: 42 ppb</span>
              </div>
            </div>

            <!-- UV Cockpit Pod -->
            <div class="instrument-glass-pod spectrum-pod">
              <div class="spectrum-top">
                <div class="s-left-meta">
                  <span class="s-label">ULTRAVIOLET RADIATION [UVI]</span>
                  <span class="s-badge" id="weatherUvCategory">
                    VERY HIGH
                  </span>
                </div>
                <span class="s-num" id="weatherUvVal">
                  8
                </span>
              </div>
              <div class="spectrum-track uv-track">
                <div class="spectrum-pip" id="weatherUvPip" style="left: 65%;"></div>
              </div>
              <div class="spectrum-sub-telemetry">
                <span class="s-chip">PEAK: 12:45</span>
                <span class="s-chip">SPF 30+ RECOMMENDED</span>
                <span class="s-chip">RAD: 8.2 MAX</span>
              </div>
