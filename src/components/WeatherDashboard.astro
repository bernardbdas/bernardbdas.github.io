                class="ascii-btn ascii-touch-btn ascii-fire-btn"
                id="asciiBtnFire"
                aria-label="Fire Weapons"
              >
                FIRE CANNONS [SPACE]
              </button>
              <button
                type="button"
                class="ascii-btn ascii-touch-btn ascii-pulse-btn"
                id="asciiBtnPulse"
                aria-label="Discharge Radar EMP"
              >
                RADAR EMP [E]
              </button>
              <button
                type="button"
                class="ascii-btn ascii-touch-btn"
                id="asciiBtnRight"
                aria-label="Steer Probe Right"
              >
                STEER RIGHT [D] &gt;
              </button>
            </div>

            <div class="ascii-action-controls">
              <button
                type="button"
                class="ascii-btn"
                id="asciiBtnRulesBottom"
                title="View flight rules & engagement manual"
              >
                <span>RULES & MANUAL [H]</span>
              </button>
              <button
                type="button"
                class="ascii-btn ascii-retry-loc-btn"
                id="asciiRetryLocBtn"
