---
/**
 * WeatherDashboard.astro — Atmospheric Telemetry Console (Overlay Modal)
 *
 * Tactical neo-brutalist weather instrumentation modal overlay:
 * - Triggered via the WEATHER HUD button in the bottom status bar or keyboard shortcut.
 * - Full-featured, high-contrast, comfortable font sizes (12px–15px body, 44px hero temp) for effortless readability.
 * - 6 tactical telemetry modules in a responsive multi-column dashboard grid.
 * - Dynamic liquid glass specular reflection, hairline brutalist borders, corner bracket accents.
 * - Closes via ESC key, clicking outside modal, or close button.
 */
---

<div
  id="weatherDashboardModal"
  class="weather-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="weatherConsoleTitle"
  aria-hidden="true"
  transition:persist="weather-dashboard"
>
  <div class="weather-modal-card" id="weatherModalCard">
    <!-- Console Tactical Header Bar -->
    <div class="weather-modal-bar">
      <div class="weather-modal-info">
        <span class="weather-status-led" aria-hidden="true"></span>
        <span class="weather-modal-title" id="weatherConsoleTitle">
          METEOROLOGICAL TELEMETRY CONSOLE
        </span>
        <span class="weather-station-tag" id="weatherStationHeaderTag">
          // STATION MET-01 [BENGALURU]
        </span>
      </div>

      <div class="weather-modal-controls">
        <button
          type="button"
          class="weather-modal-btn"
          id="weatherResetLayoutBtn"
          title="Reset telemetry widgets"
          aria-label="Reset telemetry widgets"
        >
          <svg
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M2.5 8a5.5 5.5 0 1 0 5.5-5.5A5.5 5.5 0 0 0 4 4.5L2 2.5" />
            <path d="M2 5.5h3.5V2" />
          </svg>
          <span>RESET</span>
        </button>

        <button
          type="button"
          id="weatherModalClose"
          class="weather-modal-close"
          aria-label="Close weather console (Escape)"
          title="Close (ESC)"
        >
          <svg
            viewBox="0 0 24 24"
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span class="close-key-tag">ESC</span>
        </button>
      </div>
    </div>

    <!-- Console Body (Scrollable Dashboard Grid) -->
    <div class="weather-modal-body">
      <div class="weather-dashboard-grid" id="weatherCardsRail">
        <!-- Module 1: Primary Atmospheric Station Readout -->
        <section
          class="weather-card span-hero"
          id="card-current"
          draggable="true"
          data-card-id="card-current"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_01 // PRIMARY ATMOSPHERIC TELEMETRY</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content current-hero-content">
            <div class="current-hero-main">
              <div class="current-hero-left">
                <div class="station-meta-badge">
                  <span class="badge-dot" aria-hidden="true"></span>
                  <span class="badge-city" id="weatherCity">
                    BENGALURU
                  </span>
                  <span class="badge-coords">[12.97°N, 77.59°E]</span>
                </div>
                <div class="digital-hero-temp">
                  <span class="temp-digit-val" id="weatherBigTemp">
                    25
                  </span>
                  <span class="temp-digit-deg">°</span>
                  <span class="temp-digit-unit">C</span>
                </div>
                <div class="hero-condition-status" id="weatherCondition">
                  [ STATUS: PARTLY CLOUDY ]
                </div>
              </div>

              <div class="current-hero-right">
                <div class="hero-weather-glyph" id="weatherConditionGlyph">
                  <!-- Dynamically populated via controller -->
                </div>
                <div class="hero-extremes-box">
                  <span class="ext-label">DAILY EXTREMES</span>
                  <div class="ext-pills">
                    <span class="ext-high" id="weatherHigh">
                      HIGH 29°C
                    </span>
                    <span class="ext-sep">//</span>
                    <span class="ext-low" id="weatherLow">
                      LOW 19°C
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Hero Telemetry Matrix -->
            <div class="hero-telemetry-matrix">
              <div class="matrix-cell">
                <span class="m-key">APPARENT FEELS</span>
                <span class="m-val" id="weatherFeelsLike">
                  25°C
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">SUSTAINED WIND</span>
                <span class="m-val" id="weatherWindSpeed">
                  7 km/h
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">RELATIVE HUMIDITY</span>
                <span class="m-val" id="weatherHumidity">
                  48%
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">SURFACE PRESSURE</span>
                <span class="m-val" id="weatherPressureVal">
                  758 mmHg
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">CALCULATED DEW POINT</span>
                <span class="m-val" id="weatherDewPointVal">
                  13°C
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">ATMOSPHERIC RISK</span>
                <span class="m-val" id="weatherRiskVal">
                  NOMINAL
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 2: 24-Hour Horizon Tape -->
        <section
          class="weather-card span-half"
          id="card-hourly"
          draggable="true"
          data-card-id="card-hourly"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_02 // 24-HOUR HORIZON</span>
            <div class="card-actions">
              <div class="tactical-tab-strip" role="tablist" aria-label="Hourly telemetry view">
                <button
                  type="button"
                  class="weather-cond-tab active"
                  data-tab="temp"
                  title="Temperature"
                >
                  TEMP
                </button>
                <button
                  type="button"
                  class="weather-cond-tab"
                  data-tab="rain"
                  title="Precipitation"
                >
                  RAIN
                </button>
                <button type="button" class="weather-cond-tab" data-tab="wind" title="Wind">
                  WIND
                </button>
              </div>
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content hourly-content">
            <div
              class="hourly-slider"
              id="hourlySlider"
              role="region"
              aria-label="Hourly forecast scroller"
            >
              <!-- Dynamically populated via controller -->
            </div>

            <!-- Hyper-Realistic Animated ASCII Doppler Radar & Atmospheric Flow Engine -->
            <div class="ascii-radar-bay" id="asciiRadarBay">
              <div class="ascii-radar-header">
                <div class="radar-live-indicator">
                  <span class="radar-ping-dot" aria-hidden="true"></span>
                  <span class="radar-mode-label" id="asciiRadarModeLabel">
                    ASCII RADAR // THERMAL FLUID SPECTRUM
                  </span>
                </div>
                <div class="radar-live-stats">
                  <span class="radar-stat-azimuth" id="asciiRadarAzimuth">
                    AZ: 042°
                  </span>
                  <span class="radar-stat-fps">60 FPS</span>
                </div>
              </div>

              <div class="ascii-radar-viewport">
                <canvas
                  id="asciiRadarCanvas"
                  class="ascii-radar-canvas"
                  width="460"
                  height="135"
                ></canvas>
                <div class="ascii-scanline-fx" aria-hidden="true"></div>
                <div class="ascii-radar-crosshair" aria-hidden="true"></div>
              </div>

              <div class="ascii-radar-footer">
                <span class="rf-cell" id="asciiMetricRange">
                  RANGE: 160 KM
                </span>
                <span class="rf-cell" id="asciiMetricReflectivity">
                  REFLECTIVITY: 42 dBZ
                </span>
                <span class="rf-cell" id="asciiMetricTurbulence">
                  TURBULENCE: NOMINAL
                </span>
                <span class="rf-cell" id="asciiMetricCells">
                  4 CELLS ACTIVE
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 3: 7-Day Synoptic Forecast -->
        <section
          class="weather-card span-half"
          id="card-forecast"
          draggable="true"
          data-card-id="card-forecast"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_03 // 7-DAY SYNOPTIC OUTLOOK</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content forecast-content">
            <div class="forecast-list" id="forecastList" role="list">
              <!-- Dynamically populated via controller -->
            </div>
          </div>
        </section>

        <!-- Module 4: Aerodynamics & Pressure Chamber -->
        <section
          class="weather-card span-half"
          id="card-atmosphere"
          draggable="true"
          data-card-id="card-atmosphere"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_04 // WIND & BAROMETRIC CHAMBER</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content atmosphere-dual-content">
            <!-- Wind Compass Bay -->
            <div class="tactical-gauge-box">
              <div class="compass-dial-wrap">
                <svg class="compass-dial-svg" viewBox="0 0 100 100" width="84" height="84">
                  <circle
                    cx="50"
                    cy="50"
                    r="44"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.8"
                    opacity="0.25"
                  />
                  <line
                    x1="50"
                    y1="6"
                    x2="50"
                    y2="94"
                    stroke="currentColor"
                    stroke-width="0.5"
                    opacity="0.15"
                  />
                  <line
                    x1="6"
                    y1="50"
                    x2="94"
                    y2="50"
                    stroke="currentColor"
                    stroke-width="0.5"
                    opacity="0.15"
                  />
                  <text
                    x="50"
                    y="16"
                    text-anchor="middle"
                    font-size="8"
                    font-family="var(--font-mono)"
                    font-weight="700"
                    fill="currentColor"
                    opacity="0.85"
                  >
                    N
                  </text>
                  <text
                    x="88"
                    y="53"
                    text-anchor="middle"
                    font-size="8"
                    font-family="var(--font-mono)"
                    fill="currentColor"
                    opacity="0.4"
                  >
                    E
                  </text>
                  <text
                    x="50"
                    y="90"
                    text-anchor="middle"
                    font-size="8"
                    font-family="var(--font-mono)"
                    fill="currentColor"
                    opacity="0.4"
                  >
                    S
                  </text>
                  <text
                    x="12"
                    y="53"
                    text-anchor="middle"
                    font-size="8"
                    font-family="var(--font-mono)"
                    fill="currentColor"
                    opacity="0.4"
                  >
                    W
                  </text>
                  <g id="windNeedleGroup" transform="rotate(207 50 50)">
                    <polygon points="50,18 45,50 55,50" fill="var(--accent)" />
                    <polygon points="50,82 45,50 55,50" fill="currentColor" opacity="0.3" />
                    <circle cx="50" cy="50" r="3" fill="var(--accent)" />
                  </g>
                </svg>
              </div>
              <div class="gauge-meta">
                <span class="g-title">AERO VECTOR</span>
                <span class="g-num" id="weatherWindSpeedCard">
                  7 km/h
                </span>
                <span class="g-sub" id="weatherWindDirText">
                  207° SSW
                </span>
                <span class="g-note" id="weatherWindGusts">
                  GUSTS 14 km/h
                </span>
              </div>
            </div>

            <div class="tactical-divider" aria-hidden="true"></div>

            <!-- Pressure Gauge Bay -->
            <div class="tactical-gauge-box">
              <div class="pressure-gauge-wrap">
                <svg class="pressure-svg" viewBox="0 0 100 100" width="84" height="84">
                  <circle
                    cx="50"
                    cy="50"
                    r="42"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-dasharray="190 260"
                    stroke-linecap="round"
                    opacity="0.2"
                    transform="rotate(135 50 50)"
                  />
                  <circle
                    id="pressureArcFill"
                    cx="50"
                    cy="50"
                    r="42"
                    fill="none"
                    stroke="var(--accent)"
                    stroke-width="3"
                    stroke-dasharray="120 260"
                    stroke-linecap="round"
                    transform="rotate(135 50 50)"
                  />
                  <line
                    x1="50"
                    y1="32"
                    x2="50"
                    y2="50"
                    stroke="var(--accent)"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="gauge-meta">
                <span class="g-title">BAROMETRIC TANK</span>
                <span class="g-num" id="weatherPressure">
                  758
                </span>
                <span class="g-sub">mm Hg // 1010 hPa</span>
                <span class="g-note">[ TANK STABLE ↑ ]</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 5: Astronomical Ephemeris -->
        <section
          class="weather-card span-half"
          id="card-solar-lunar"
          draggable="true"
          data-card-id="card-solar-lunar"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_05 // ASTRONOMICAL EPHEMERIS</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content solar-lunar-content">
            <!-- Sun Daylight Arc -->
            <div class="ephemeris-box">
              <div class="solar-arc-svg-wrap">
                <svg viewBox="0 0 140 56" width="110" height="46" class="solar-arc-svg">
                  <path
                    d="M 10 44 Q 70 4 130 44"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-dasharray="2 3"
                    opacity="0.3"
                  />
                  <line
                    x1="10"
                    y1="44"
                    x2="130"
                    y2="44"
                    stroke="currentColor"
                    stroke-width="0.8"
                    opacity="0.25"
                  />
                  <circle id="solarDot" cx="70" cy="18" r="4.5" fill="var(--accent)" />
                </svg>
              </div>
              <div class="ephemeris-readout">
                <div class="e-row">
                  <span class="e-label">DAWN // SUNRISE</span>
                  <span class="e-val" id="weatherSunrise">
                    06:12
                  </span>
                </div>
                <div class="e-row">
                  <span class="e-label">DUSK // SUNSET</span>
                  <span class="e-val" id="weatherSunset">
                    17:53
                  </span>
                </div>
              </div>
            </div>

            <div class="tactical-divider" aria-hidden="true"></div>

            <!-- Photorealistic Vector Moon Phase -->
            <div class="ephemeris-box">
              <div class="moon-render-wrap" id="moonRenderWrap">
                <!-- Dynamically populated with high-fidelity vector moon sphere -->
              </div>
              <div class="ephemeris-readout">
                <div class="e-row">
                  <span class="e-label">LUNAR PHASE</span>
                  <span class="e-val" id="moonPhaseName">
                    WANING CRESCENT
                  </span>
                </div>
                <div class="e-row">
                  <span class="e-label">ILLUMINATION</span>
                  <span class="e-val" id="moonIllumPct">
                    2%
                  </span>
                </div>
                <div class="e-row">
                  <span class="e-label">NEXT PHASE</span>
                  <span class="e-val e-sub-val" id="moonNextPhase">
                    NEW MOON IN 1D
                  </span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 6: Environmental Radiance & AQI Spectrum -->
        <section
          class="weather-card span-half"
          id="card-air-uv"
          draggable="true"
          data-card-id="card-air-uv"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_06 // ENVIRONMENTAL RADIANCE & SPECTRUM</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content spectrum-content">
            <!-- AQI Meter -->
            <div class="spectrum-row">
              <div class="spectrum-top">
                <span class="s-label">AIR QUALITY INDEX [AQI]</span>
                <span class="s-badge" id="weatherAqiCategory">
                  MODERATE
                </span>
                <span class="s-num" id="weatherAqiVal">
                  136
                </span>
              </div>
              <div class="spectrum-track aqi-track">
                <div class="spectrum-pip" id="weatherAqiPip" style="left: 45%;"></div>
              </div>
            </div>

            <!-- UV Meter -->
            <div class="spectrum-row">
              <div class="spectrum-top">
                <span class="s-label">ULTRAVIOLET RADIATION [UVI]</span>
                <span class="s-badge" id="weatherUvCategory">
                  VERY HIGH
                </span>
                <span class="s-num" id="weatherUvVal">
                  8
                </span>
              </div>
              <div class="spectrum-track uv-track">
                <div class="spectrum-pip" id="weatherUvPip" style="left: 65%;"></div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/weather-dashboard';
</script>
