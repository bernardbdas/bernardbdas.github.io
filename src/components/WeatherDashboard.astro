                  height="12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <circle cx="8" cy="8" r="3" />
                  <path d="M8 1v2M8 13v2M1 8h2M13 8h2" />
                </svg>
                <span>RETRY LOCATION DETECTION</span>
              </button>

              <button
                type="button"
                class="ascii-btn"
                id="asciiBtnRestart"
                title="Restart ASCII game mission"
              >
                <span>RE-DEPLOY PROBE</span>
              </button>

              <button
                type="button"
                class="ascii-btn"
                id="asciiBtnPause"
                title="Pause or resume mission"
              >
                <span id="asciiPauseLabel">PAUSE</span>
              </button>

              <button
                type="button"
                class="ascii-btn ascii-telemetry-btn"
                id="asciiReturnTelemetryBtn"
                title="Return to weather telemetry grid"
              >
                <span>VIEW TELEMETRY</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

