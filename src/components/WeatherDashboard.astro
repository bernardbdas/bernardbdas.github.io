---
/**
 * WeatherDashboard.astro — Atmospheric Telemetry Console (Overlay Modal)
 *
 * Tactical neo-brutalist weather instrumentation modal overlay:
 * - Triggered via the WEATHER HUD button in the bottom status bar or keyboard shortcut.
 * - Full-featured, high-contrast, comfortable font sizes (12px–15px body, 44px hero temp) for effortless readability.
 * - 6 tactical telemetry modules in a responsive multi-column dashboard grid.
 * - Dynamic liquid glass specular reflection, hairline brutalist borders, corner bracket accents.
 * - Closes via ESC key, clicking outside modal, or close button.
 */
---

<div
  id="weatherDashboardModal"
  class="weather-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="weatherConsoleTitle"
  aria-hidden="true"
  transition:persist="weather-dashboard"
>
  <div class="weather-modal-card" id="weatherModalCard">
    <!-- Console Tactical Header Bar -->
    <div class="weather-modal-bar">
      <div class="weather-modal-info">
        <span class="weather-status-led" aria-hidden="true"></span>
        <span class="weather-modal-title" id="weatherConsoleTitle">
          METEOROLOGICAL TELEMETRY CONSOLE
        </span>
        <span class="weather-station-tag" id="weatherStationHeaderTag">
          // STATION MET-01 [BENGALURU]
        </span>
      </div>

      <div class="weather-modal-controls">
        <button
          type="button"
          class="weather-modal-btn"
          id="weatherAsciiGameToggleBtn"
          title="Toggle STRATOS Atmospheric Sensor Game"
          aria-label="Toggle STRATOS Game"
        >
          <svg
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <rect x="2" y="3" width="12" height="10" rx="2" />
            <path d="M5 8h2M6 7v2M10 7.5h.01M12 8.5h.01" />
          </svg>
          <span id="weatherAsciiToggleText">STRATOS</span>
        </button>

        <button
          type="button"
          class="weather-modal-btn"
          id="weatherLocateBtn"
          title="Auto-detect current location"
          aria-label="Auto-detect location"
        >
          <svg
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="8" cy="8" r="3" />
            <path d="M8 1v2M8 13v2M1 8h2M13 8h2" />
          </svg>
          <span>LOCATE</span>
        </button>

        <button
          type="button"
          class="weather-modal-btn"
          id="weatherResetLayoutBtn"
          title="Reset telemetry widgets"
          aria-label="Reset telemetry widgets"
        >
          <svg
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M2.5 8a5.5 5.5 0 1 0 5.5-5.5A5.5 5.5 0 0 0 4 4.5L2 2.5" />
            <path d="M2 5.5h3.5V2" />
          </svg>
          <span>RESET</span>
        </button>

        <button
          type="button"
          id="weatherModalClose"
          class="weather-modal-close"
          aria-label="Close weather console (Escape)"
          title="Close (ESC)"
        >
          <svg
            viewBox="0 0 24 24"
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span class="close-key-tag">ESC</span>
        </button>
      </div>
    </div>

    <!-- Console Body (Scrollable Dashboard Grid) -->
    <div class="weather-modal-body">
      <div class="weather-dashboard-grid" id="weatherCardsRail">
        <!-- Module 1: Primary Atmospheric Station Readout -->
        <section
          class="weather-card span-hero"
          id="card-current"
          draggable="true"
          data-card-id="card-current"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_01 // PRIMARY ATMOSPHERIC TELEMETRY</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content current-hero-content">
            <div class="current-hero-main">
              <div class="current-hero-left">
                <div class="station-meta-badge">
                  <span class="badge-dot" aria-hidden="true"></span>
                  <span class="badge-city" id="weatherCity">
                    BENGALURU
                  </span>
                  <span class="badge-coords" id="weatherCoords">
                    [12.97°N, 77.59°E]
                  </span>
                </div>
                <div class="digital-hero-temp">
                  <span class="temp-digit-val" id="weatherBigTemp">
                    25
                  </span>
                  <span class="temp-digit-deg">°</span>
                  <span class="temp-digit-unit">C</span>
                </div>
                <div class="hero-condition-status" id="weatherCondition">
                  [ STATUS: PARTLY CLOUDY ]
                </div>
              </div>

              <div class="current-hero-right">
                <div class="hero-weather-glyph" id="weatherConditionGlyph">
                  <!-- Dynamically populated via controller -->
                </div>
                <div class="hero-extremes-box">
                  <span class="ext-label">DAILY EXTREMES</span>
                  <div class="ext-pills">
                    <span class="ext-high" id="weatherHigh">
                      HIGH 29°C
                    </span>
                    <span class="ext-sep">//</span>
                    <span class="ext-low" id="weatherLow">
                      LOW 19°C
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Hero Telemetry Matrix -->
            <div class="hero-telemetry-matrix">
              <div class="matrix-cell">
                <span class="m-key">APPARENT FEELS</span>
                <span class="m-val" id="weatherFeelsLike">
                  25°C
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">SUSTAINED WIND</span>
                <span class="m-val" id="weatherWindSpeed">
                  7 km/h
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">RELATIVE HUMIDITY</span>
                <span class="m-val" id="weatherHumidity">
                  48%
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">SURFACE PRESSURE</span>
                <span class="m-val" id="weatherPressureVal">
                  758 mmHg
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">CALCULATED DEW POINT</span>
                <span class="m-val" id="weatherDewPointVal">
                  13°C
                </span>
              </div>
              <div class="matrix-cell">
                <span class="m-key">ATMOSPHERIC RISK</span>
                <span class="m-val" id="weatherRiskVal">
                  NOMINAL
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 2: 24-Hour Horizon Tape -->
        <section
          class="weather-card span-half"
          id="card-hourly"
          draggable="true"
          data-card-id="card-hourly"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_02 // 24-HOUR HORIZON</span>
            <div class="card-actions">
              <div class="tactical-tab-strip" role="tablist" aria-label="Hourly telemetry view">
                <button
                  type="button"
                  class="weather-cond-tab active"
                  data-tab="temp"
                  title="Temperature"
                >
                  TEMP
                </button>
                <button
                  type="button"
                  class="weather-cond-tab"
                  data-tab="rain"
                  title="Precipitation"
                >
                  RAIN
                </button>
                <button type="button" class="weather-cond-tab" data-tab="wind" title="Wind">
                  WIND
                </button>
              </div>
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content hourly-content">
            <div
              class="hourly-slider"
              id="hourlySlider"
              role="region"
              aria-label="Hourly forecast scroller"
            >
              <!-- Dynamically populated via controller -->
            </div>

            <!-- Hyper-Realistic Animated ASCII Doppler Radar & Atmospheric Flow Engine -->
            <div class="ascii-radar-bay" id="asciiRadarBay">
              <div class="ascii-radar-header">
                <div class="radar-live-indicator">
                  <span class="radar-ping-dot" aria-hidden="true"></span>
                  <span class="radar-mode-label" id="asciiRadarModeLabel">
                    ASCII RADAR // THERMAL FLUID SPECTRUM
                  </span>
                </div>
                <div class="radar-live-stats">
                  <span class="radar-stat-azimuth" id="asciiRadarAzimuth">
                    AZ: 042°
                  </span>
                  <span class="radar-stat-fps">60 FPS</span>
                </div>
              </div>

              <div class="ascii-radar-viewport">
                <canvas
                  id="asciiRadarCanvas"
                  class="ascii-radar-canvas"
                  width="460"
                  height="135"
                ></canvas>
                <div class="ascii-scanline-fx" aria-hidden="true"></div>
                <div class="ascii-radar-crosshair" aria-hidden="true"></div>
              </div>

              <div class="ascii-radar-footer">
                <span class="rf-cell" id="asciiMetricRange">
                  RANGE: 160 KM
                </span>
                <span class="rf-cell" id="asciiMetricReflectivity">
                  REFLECTIVITY: 42 dBZ
                </span>
                <span class="rf-cell" id="asciiMetricTurbulence">
                  TURBULENCE: NOMINAL
                </span>
                <span class="rf-cell" id="asciiMetricCells">
                  4 CELLS ACTIVE
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 3: 7-Day Synoptic Forecast -->
        <section
          class="weather-card span-half"
          id="card-forecast"
          draggable="true"
          data-card-id="card-forecast"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_03 // 7-DAY SYNOPTIC OUTLOOK</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content forecast-content">
            <div class="forecast-list" id="forecastList" role="list">
              <!-- Dynamically populated via controller -->
            </div>
          </div>
        </section>

        <!-- Module 4: Aerodynamics & Pressure Chamber -->
        <section
          class="weather-card span-half"
          id="card-atmosphere"
          draggable="true"
          data-card-id="card-atmosphere"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_04 // WIND & BAROMETRIC CHAMBER</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 17v5M9 2h6l-1 7h3l-4 8-1-5H8l-1-7h2z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="card-content atmosphere-dual-content">
            <!-- Wind Compass Pod -->
            <div class="instrument-glass-pod">
              <div class="compass-dial-wrap">
                <svg class="compass-dial-svg" viewBox="0 0 100 100" width="64" height="64">
                  <defs>
                    <radialGradient id="compassGlow" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.16" />
                      <stop offset="65%" stop-color="var(--accent)" stop-opacity="0.04" />
                      <stop offset="100%" stop-color="transparent" />
                    </radialGradient>
                    <linearGradient id="needleNorthGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#ffffff" />
                      <stop offset="40%" stop-color="var(--accent)" />
                      <stop offset="100%" stop-color="var(--accent)" />
                    </linearGradient>
                  </defs>
                  <!-- Background Radar Halo -->
                  <circle cx="50" cy="50" r="44" fill="url(#compassGlow)" />
                  <!-- Outer Dial Track & Degree Ticks -->
                  <circle
                    cx="50"
                    cy="50"
                    r="44"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.8"
                    opacity="0.25"
                  />
                  <circle
                    cx="50"
                    cy="50"
                    r="32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.5"
                    stroke-dasharray="2 3"
                    opacity="0.15"
                  />
                  <circle
                    cx="50"
                    cy="50"
                    r="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.5"
                    opacity="0.12"
                  />
                  <!-- Crosshairs -->
                  <line
                    x1="50"
                    y1="8"
                    x2="50"
                    y2="92"
                    stroke="currentColor"
                    stroke-width="0.5"
                    opacity="0.18"
                  />
                  <line
                    x1="8"
                    y1="50"
                    x2="92"
                    y2="50"
                    stroke="currentColor"
                    stroke-width="0.5"
                    opacity="0.18"
                  />
                  <!-- Dial Degree Marks (30 deg ticks) -->
                  <line
                    x1="72"
                    y1="12"
                    x2="70"
                    y2="16"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="88"
                    y1="28"
                    x2="84"
                    y2="30"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="88"
                    y1="72"
                    x2="84"
                    y2="70"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="72"
                    y1="88"
                    x2="70"
                    y2="84"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="28"
                    y1="88"
                    x2="30"
                    y2="84"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="12"
                    y1="72"
                    x2="16"
                    y2="70"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="12"
                    y1="28"
                    x2="16"
                    y2="30"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <line
                    x1="28"
                    y1="12"
                    x2="30"
                    y2="16"
                    stroke="currentColor"
                    stroke-width="0.6"
                    opacity="0.2"
                  />
                  <!-- Cardinal Indicators -->
                  <text
                    x="50"
                    y="16"
                    text-anchor="middle"
                    font-size="7.5"
                    font-family="var(--font-mono)"
                    font-weight="800"
                    fill="var(--accent)"
                  >
                    N
                  </text>
                  <text
                    x="88"
                    y="52.5"
                    text-anchor="middle"
                    font-size="7"
                    font-family="var(--font-mono)"
                    font-weight="700"
                    fill="currentColor"
                    opacity="0.45"
                  >
                    E
                  </text>
                  <text
                    x="50"
                    y="89"
                    text-anchor="middle"
                    font-size="7"
                    font-family="var(--font-mono)"
                    font-weight="700"
                    fill="currentColor"
                    opacity="0.45"
                  >
                    S
                  </text>
                  <text
                    x="12"
                    y="52.5"
                    text-anchor="middle"
                    font-size="7"
                    font-family="var(--font-mono)"
                    font-weight="700"
                    fill="currentColor"
                    opacity="0.45"
                  >
                    W
                  </text>
                  <!-- High-Precision Dual Faceted Aerospace Compass Needle -->
                  <g id="windNeedleGroup" transform="rotate(207 50 50)">
                    <polygon points="50,14 46,50 50,47" fill="url(#needleNorthGrad)" />
                    <polygon points="50,14 50,47 54,50" fill="var(--accent)" opacity="0.85" />
                    <polygon points="50,86 46,50 50,53" fill="currentColor" opacity="0.2" />
                    <polygon points="50,86 50,53 54,50" fill="currentColor" opacity="0.32" />
                    <circle
                      cx="50"
                      cy="50"
                      r="4.2"
                      fill="var(--bg)"
                      stroke="var(--accent)"
                      stroke-width="1.4"
                    />
                    <circle cx="50" cy="50" r="1.8" fill="var(--accent)" />
                  </g>
                </svg>
              </div>
              <div class="gauge-meta">
                <span class="g-title">AERO VECTOR</span>
                <span class="g-num" id="weatherWindSpeedCard">
                  7 km/h
                </span>
                <span class="g-sub" id="weatherWindDirText">
                  207° SSW
                </span>
                <span class="g-note" id="weatherWindGusts">
                  GUSTS 14 km/h
                </span>
              </div>
            </div>

            <!-- Pressure Gauge Pod -->
            <div class="instrument-glass-pod">
              <div class="pressure-gauge-wrap">
                <svg class="pressure-svg" viewBox="0 0 100 100" width="64" height="64">
                  <defs>
                    <radialGradient id="baroGlow" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.14" />
                      <stop offset="60%" stop-color="var(--accent)" stop-opacity="0.03" />
                      <stop offset="100%" stop-color="transparent" />
                    </radialGradient>
                  </defs>
                  <!-- Background Halo -->
                  <circle cx="50" cy="50" r="42" fill="url(#baroGlow)" />
                  <!-- Calibrated Scale Track -->
                  <circle
                    cx="50"
                    cy="50"
                    r="42"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-dasharray="190 260"
                    stroke-linecap="round"
                    opacity="0.15"
                    transform="rotate(135 50 50)"
                  />
                  <!-- Inner Track Line -->
                  <circle
                    cx="50"
                    cy="50"
                    r="34"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.5"
                    stroke-dasharray="2 3"
                    opacity="0.12"
                  />
                  <!-- Active Gradient Pressure Arc Fill -->
                  <circle
                    id="pressureArcFill"
                    cx="50"
                    cy="50"
                    r="42"
                    fill="none"
                    stroke="var(--accent)"
                    stroke-width="3.5"
                    stroke-dasharray="120 260"
                    stroke-linecap="round"
                    transform="rotate(135 50 50)"
                  />
                  <!-- Center Manometer Pivot & Needle -->
                  <line
                    x1="50"
                    y1="30"
                    x2="50"
                    y2="50"
                    stroke="var(--accent)"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <circle
                    cx="50"
                    cy="50"
                    r="3.5"
                    fill="var(--bg)"
                    stroke="var(--accent)"
                    stroke-width="1.4"
                  />
                  <circle cx="50" cy="50" r="1.5" fill="var(--accent)" />
                </svg>
              </div>
              <div class="gauge-meta">
                <span class="g-title">BAROMETRIC TANK</span>
                <div class="g-num-row">
                  <span class="g-num" id="weatherPressure">
                    758
                  </span>
                  <span class="g-unit">mmHg</span>
                </div>
                <span class="g-sub">1010 hPa</span>
                <span class="g-note g-trend-pill">
                  <span class="trend-pip"></span>STABLE ↑
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- Module 5: Astronomical Ephemeris -->
        <section
          class="weather-card span-half"
          id="card-solar-lunar"
          draggable="true"
          data-card-id="card-solar-lunar"
        >
          <div class="card-header">
            <div class="card-drag-handle" title="Drag to reorder module" aria-label="Drag handle">
              <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <circle cx="5" cy="5" r="1.2" />
                <circle cx="11" cy="5" r="1.2" />
                <circle cx="5" cy="11" r="1.2" />
                <circle cx="11" cy="11" r="1.2" />
              </svg>
            </div>
            <span class="card-title">SYS_05 // ASTRONOMICAL EPHEMERIS</span>
            <div class="card-actions">
              <button
                type="button"
                class="card-action-btn widget-pin-btn"
                title="Pin module"
                aria-label="Pin module"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="11"
                  height="11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
