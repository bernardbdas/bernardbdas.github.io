                  </span>
                </div>
                <div class="e-row">
                  <span class="e-label">DAYLIGHT</span>
                  <span class="e-val e-sub-val">11H 41M</span>
                </div>
              </div>
            </div>

            <!-- Photorealistic Vector Moon Phase Pod -->
            <div class="instrument-glass-pod">
              <div class="moon-render-wrap" id="moonRenderWrap">
