---
/**
 * About — Who am I ? overview with chips.
 */
import Loader from './Loader.astro';

const chips: string[] = ['2+ Years Work Experience', 'Backend Microservices', 'AI & ML Systems'];
---

<section class="section anim-s1" id="about" aria-labelledby="about-heading">
  <p class="micro-label">
    <Loader />
    About
  </p>

  <h2 class="section-heading" id="about-heading">
    What I do ?
  </h2>

  <p class="bio">
    I am a Software Engineer turned into Machine Learning Engineer with 2+ years of enterprise
    experience. I specialize in high-throughput backend services and machine learning
    infrastructure.
    <br />I enjoy working on problems that sit at the intersection of AI research and production
    systems.
  </p>

  <div class="chips">
    {chips.map((chip) => (
      <span class="chip">{chip}</span>
    ))}
  </div>
</section>
