---
/**
 * About — Who I do? overview with chips.
 */
import Loader from './Loader.astro';

const chips: string[] = [
  'Federated Learning',
  'Foundation Models',
  'Healthcare AI',
  'Computer Vision',
  'Signal Processing',
  'Regional Language Models',
];
---

<section class="section anim-s1" id="about" aria-labelledby="about-heading">
  <p class="micro-label">
    <Loader />
    About
  </p>

  <h2 class="section-heading" id="about-heading">
    What I do?
  </h2>

  <p class="bio">I am a Software Engineer with 2+ years of enterprise experience.</p>

  <p class="bio">
    I enjoy working on problems at the intersection of AI research and production systems. I
    specialize in high-throughput backend services and machine learning infrastructure.
  </p>

  <div class="chips">
    {chips.map((chip) => (
      <span class="chip">{chip}</span>
    ))}
  </div>
</section>
