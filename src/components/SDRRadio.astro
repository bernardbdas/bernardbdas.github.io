---
/**
 * SDRRadio.astro — Software Defined Radio (SDR) & Radio Shack
 * Tactical brutalist wideband FM receiver with interactive waterfall spectrogram,
 * YouTube IFrame live stream playback engine, frequency tuner, and genre matrix.
 */
import Loader from './Loader.astro';
import {
  RADIO_STATIONS,
  CLASSICAL_SUBGENRES,
  JAZZ_SUBGENRES,
  ROCK_SUBGENRES,
  HIPHOP_SUBGENRES,
  HOUSE_SUBGENRES,
  ELECTRONIC_SUBGENRES,
  LOFI_SUBGENRES,
  AMBIENT_SUBGENRES,
  SEASONAL_SUBGENRES,
  SDR_PLAYLISTS,
  type FMStation,
  type SDRPlaylist,
  type PlaylistTrack,
} from '../data/radio-stations';

const genres = [
  'ALL',
  'Classical',
  'Jazz',
  'Rock',
  'Hip Hop',
  'House Music',
  'Electronic Music',
  'Lo-Fi',
  'Ambient',
  'Seasonal',
];

const SUBGENRE_MAP: Record<string, readonly string[]> = {
  Classical: CLASSICAL_SUBGENRES,
  Jazz: JAZZ_SUBGENRES,
  Rock: ROCK_SUBGENRES,
  'Hip Hop': HIPHOP_SUBGENRES,
  'House Music': HOUSE_SUBGENRES,
  'Electronic Music': ELECTRONIC_SUBGENRES,
  'Lo-Fi': LOFI_SUBGENRES,
  Ambient: AMBIENT_SUBGENRES,
  Seasonal: SEASONAL_SUBGENRES,
};

// Initial default station
const defaultStation: FMStation = RADIO_STATIONS[0];
---

<div class="subpage-breadcrumb">
  <a href="/" class="breadcrumb-link" aria-label="Return to homepage">
    <span class="breadcrumb-arrow">←</span>
    <span>INDEX // CORE SYSTEMS</span>
  </a>
  <span class="breadcrumb-sep">//</span>
  <span class="breadcrumb-current">MODULE: RADIO SHACK (SDR)</span>
</div>

<section class="section sdr-hero anim-hero" aria-labelledby="sdr-heading">
  <div class="sdr-header-row">
    <div>
      <p class="micro-label">
        <Loader />
        RF TELEMETRY // 88.0 – 108.0 MHz // WFM BROADBAND
      </p>
      <h1 id="sdr-heading" class="subpage-title">
        Radio Shack // SDR<span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="focus-strip">
        Software Defined Radio • Curated Live Broadcasts • 24/7 Global Audio Streams
      </p>
    </div>

    <div class="sdr-header-status-pill">
      <span class="status-dot sdr-live-dot" id="sdr-main-dot"></span>
      <span class="sdr-header-status-text" id="sdr-main-status-text">
        RECEIVER STANDBY
      </span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       SDR TUNER & WATERFALL INSTRUMENT DECK
       ══════════════════════════════════════════════════════════ -->
  <div class="sdr-deck-wrap" id="sdr-deck-wrap">
    <!-- Ambient Stage & Lightning Rig (Active for House & Electronic Music) -->
    <div class="sdr-ambient-rig" id="sdr-ambient-rig" aria-hidden="true">
      <div class="ambient-glow-aura"></div>
      <div class="ambient-strobe-halo"></div>
    </div>
    <div class="ambient-lightning-flash" id="ambient-lightning-flash" aria-hidden="true"></div>

    <div
      class="sdr-deck"
      id="sdr-main-deck"
      role="region"
      aria-label="Software Defined Radio Tuning Console"
    >
      <div class="dev-card-corner-tl" aria-hidden="true"></div>
      <div class="dev-card-corner-br" aria-hidden="true"></div>

      <!-- Top Tuning VFD Display -->
      <div class="sdr-vfd-display">
        <div class="vfd-left">
          <div class="vfd-freq-cluster">
            <span class="vfd-freq-digits" id="vfd-freq-val">
              {defaultStation.freqNum.toFixed(1)}
            </span>
            <div class="vfd-freq-units">
              <span class="vfd-unit-mhz" id="vfd-freq-unit">
                MHz
              </span>
              <span class="vfd-modulation" id="vfd-modulation">
                WFM / STEREO
              </span>
            </div>
          </div>

          <div class="vfd-station-info">
            <div class="vfd-station-name-row">
              <span class="vfd-station-title" id="vfd-station-title">
                {defaultStation.name}
              </span>
              <span class="vfd-genre-badge" id="vfd-genre-badge">
                {defaultStation.genre}
              </span>
              <span
                class:list={[
                  'vfd-stream-type-badge',
                  defaultStation.streamType === 'live' ? 'is-live' : 'is-recorded',
                ]}
                id="vfd-stream-type-badge"
              >
                {defaultStation.streamType === 'live' ? '● 24/7 LIVE' : 'PRE-RECORDED ARCHIVE'}
              </span>
              <span class="vfd-club-sync-badge" id="vfd-club-sync" style="display: none;">
                <span class="club-pulse-led" aria-hidden="true"></span>
                <span>SYNC: 126 BPM // RAVE LIGHTING</span>
              </span>
            </div>
            <p class="vfd-station-desc" id="vfd-station-desc">
              {defaultStation.desc}
            </p>

            <!-- Timeline Scrubber & 24/7 Real-Time Live Status -->
            <div class="sdr-timeline-panel" id="sdr-timeline-panel">
              <div
                class="sdr-timeline-track-wrap"
                id="sdr-timeline-track-wrap"
                style={defaultStation.streamType === 'live' ? 'display: none;' : 'display: flex;'}
              >
                <span class="sdr-time-code" id="sdr-time-current">
                  00:00
                </span>
                <div
                  class="sdr-timeline-track"
                  id="sdr-timeline-track"
                  role="slider"
                  aria-label="Playback track scrubber"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                  tabindex="0"
                >
                  <div class="sdr-timeline-fill" id="sdr-timeline-fill" style="width: 0%;"></div>
                  <div class="sdr-timeline-thumb" id="sdr-timeline-thumb" style="left: 0%;"></div>
                </div>
                <span class="sdr-time-code" id="sdr-time-total">
                  --:--
                </span>
              </div>
              <div
                class="sdr-timeline-live-notice"
                id="sdr-timeline-live-notice"
                style={
                  defaultStation.streamType === 'live' ? 'display: inline-flex;' : 'display: none;'
                }
              >
                <span class="stream-pulse-dot" aria-hidden="true"></span>
                <span>24/7 REAL-TIME CONTINUOUS BROADCAST // DIRECT SATELLITE &amp; RF STREAM</span>
              </div>
            </div>
          </div>
        </div>

        <div class="vfd-right">
          <div class="sdr-meter-row">
            <span class="meter-label">RSSI SIGNAL</span>
            <span class="meter-val" id="sdr-rssi-val">
              -52 dBm
            </span>
            <div class="signal-bar-wrap" aria-hidden="true">
              <div class="signal-bar-fill" id="signal-bar-fill" style="width: 82%;"></div>
            </div>
          </div>

          <div class="sdr-telemetry-micro">
            <div class="telemetry-micro-item">
              <span class="tm-k">SNR</span>
              <span class="tm-v" id="sdr-snr-val">
                34.8 dB
              </span>
            </div>
            <div class="telemetry-micro-item">
              <span class="tm-k">CODEC</span>
              <span class="tm-v" id="sdr-bitrate-val">
                {defaultStation.bitrate}
              </span>
            </div>
            <div class="telemetry-micro-item">
              <span class="tm-k">RECEIVER</span>
              <span class="tm-v" id="sdr-lock-val">
                RTL-SDR v4
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- SDR Multi-Mode Interactive Visualizer Deck -->
      <div class="sdr-visualizer-deck">
        <div class="sdr-viz-toolbar">
          <div class="sdr-viz-modes-tabs" role="tablist" aria-label="Visualizer Display Modes">
            <button
              type="button"
              class="sdr-viz-tab is-active"
              data-mode="waterfall"
              role="tab"
              aria-selected="true"
              title="Wideband RF FFT Spectrum & Waterfall Spectrogram"
            >
              <span class="viz-tab-dot" aria-hidden="true"></span>
              <span>WATERFALL</span>
            </button>
            <button
              type="button"
              class="sdr-viz-tab"
              data-mode="oscilloscope"
              role="tab"
              aria-selected="false"
              title="Analog CRT Phosphor Oscilloscope Waveform"
            >
              <span class="viz-tab-dot" aria-hidden="true"></span>
              <span>OSCILLOSCOPE</span>
            </button>
            <button
              type="button"
              class="sdr-viz-tab"
              data-mode="particles"
              role="tab"
              aria-selected="false"
              title="Audio-Reactive Frequency Particle Constellation"
            >
              <span class="viz-tab-dot" aria-hidden="true"></span>
              <span>PARTICLES</span>
            </button>
            <button
              type="button"
              class="sdr-viz-tab"
              data-mode="bars"
              role="tab"
              aria-selected="false"
              title="32-Band VFD Graphic Equalizer & Peak Meter"
            >
              <span class="viz-tab-dot" aria-hidden="true"></span>
              <span>SPECTRUM BARS</span>
            </button>
          </div>

          <div class="sdr-viz-telemetry">
            <span class="viz-tel-tag" id="viz-active-mode-tag">
              DSP: WATERFALL FFT
            </span>
            <span class="viz-tel-sep">//</span>
            <span class="viz-tel-tag">60 FPS REALTIME</span>
          </div>
        </div>

        <div class="sdr-waterfall-container">
          <div class="waterfall-scale-header" id="waterfall-scale-header" aria-hidden="true">
            <span>88.0 MHz</span>
            <span>92.0</span>
            <span>96.0</span>
            <span>100.0</span>
            <span>104.0</span>
            <span>108.0 MHz</span>
          </div>
          <canvas
            id="sdr-waterfall-canvas"
            class="sdr-waterfall-canvas"
            title="Interactive SDR Visualizer (Click or drag anywhere to tune frequency)"
            tabindex="0"
            role="slider"
            aria-label="SDR Waterfall Spectrum Frequency Tuner"
            aria-valuemin="88.0"
            aria-valuemax="108.0"
            aria-valuenow={defaultStation.freqNum}
          ></canvas>
          <div class="waterfall-overlay-hint" id="waterfall-overlay-hint">
            <span id="viz-hint-text">
              [SPECTRUM FFT &amp; WATERFALL ANALYZER — CLICK OR DRAG TO TUNE]
            </span>
          </div>
        </div>
      </div>

      <!-- Master SDR Control Bar -->
      <div class="sdr-controls-bar">
        <div class="sdr-primary-controls">
          <button
            type="button"
            class="sdr-btn sdr-power-btn"
            id="sdr-power-btn"
            aria-label="Initialize or Power SDR Receiver"
            title="Initialize SDR Receiver / Play / Pause"
          >
            <span class="sdr-power-led" aria-hidden="true"></span>
            <span class="sdr-power-label" id="sdr-power-label">
              POWER ON
            </span>
          </button>

          <button
            type="button"
            class="sdr-btn sdr-nav-btn"
            id="sdr-prev-btn"
            aria-label="Previous Station"
            title="Tune to Previous Station"
          >
            <span>◀◀ PREV</span>
          </button>

          <button
            type="button"
            class="sdr-btn sdr-step-btn"
            id="sdr-step-down"
            aria-label="Step down 0.1 MHz"
            title="Fine Tune -0.1 MHz"
          >
            <span>-0.1</span>
          </button>

          <button
            type="button"
            class="sdr-btn sdr-step-btn"
            id="sdr-step-up"
            aria-label="Step up 0.1 MHz"
            title="Fine Tune +0.1 MHz"
          >
            <span>+0.1</span>
          </button>

          <button
            type="button"
            class="sdr-btn sdr-nav-btn"
            id="sdr-next-btn"
            aria-label="Next Station"
            title="Tune to Next Station"
          >
            <span>NEXT ▶▶</span>
          </button>

          <!-- Dedicated Track & Seek Controls (Active for Pre-Recorded Tracks) -->
          <div class="sdr-track-controls" id="sdr-track-controls">
            <span class="sdr-controls-divider" aria-hidden="true">
              |
            </span>

            <button
              type="button"
              class:list={[
                'sdr-btn sdr-media-btn',
                { 'is-disabled': defaultStation.streamType === 'live' },
              ]}
              id="sdr-rewind-btn"
              aria-label="Rewind 15 seconds"
              title="Rewind 15 seconds (Pre-Recorded Tracks)"
              aria-disabled={defaultStation.streamType === 'live' ? 'true' : 'false'}
            >
              <span>↺ -15S</span>
            </button>

            <button
              type="button"
              class:list={[
                'sdr-btn sdr-media-btn',
                { 'is-disabled': defaultStation.streamType === 'live' },
              ]}
              id="sdr-forward-btn"
              aria-label="Forward 15 seconds"
              title="Forward 15 seconds (Pre-Recorded Tracks)"
              aria-disabled={defaultStation.streamType === 'live' ? 'true' : 'false'}
            >
              <span>↻ +15S</span>
            </button>

            <button
              type="button"
              class="sdr-btn sdr-media-btn sdr-playlist-ctrl-btn"
              id="sdr-track-prev-btn"
              aria-label="Previous Track in Playlist"
              title="Previous Track in Playlist"
              style="display: none;"
            >
              <span>⏮ PREV TRK</span>
            </button>

            <button
              type="button"
              class="sdr-btn sdr-media-btn sdr-playlist-ctrl-btn"
              id="sdr-track-next-btn"
              aria-label="Next Track in Playlist"
              title="Next Track in Playlist"
              style="display: none;"
            >
              <span>NEXT TRK ⏭</span>
            </button>
          </div>
        </div>

        <div class="sdr-volume-controls">
          <div class="sdr-vol-wrap">
            <span class="vol-label" id="vol-display-label">
              VOL: 80%
            </span>
            <input
              type="range"
              id="sdr-volume-slider"
              class="sdr-slider"
              min="0"
              max="100"
              value="80"
              aria-label="Radio Volume Control"
            />
          </div>

          <button
            type="button"
            class="sdr-btn sdr-btn-mini"
            id="sdr-mute-btn"
            aria-label="Mute or Unmute"
            title="Toggle Mute"
          >
            <span id="sdr-mute-label">MUTE</span>
          </button>

          <button
            type="button"
            class="sdr-btn sdr-btn-mini sdr-route-ambient-btn"
            id="sdr-route-ambient-btn"
            aria-label="Pipe currently tuned radio stream into background ambient sound"
            title="Route this live radio stream to persistent background ambient sound"
          >
            <span class="ambient-route-dot" aria-hidden="true"></span>
            <span id="sdr-route-ambient-label">PIPE TO AMBIENT</span>
          </button>

          <button
            type="button"
            class="sdr-btn sdr-btn-mini sdr-light-rig-btn"
            id="sdr-light-rig-btn"
            style="display: none;"
            aria-label="Toggle Ambient Lightning & Club Sync"
            title="Toggle Ambient Lighting & Sync FX"
          >
            <span class="club-btn-led" id="sdr-light-rig-led" aria-hidden="true"></span>
            <span id="sdr-light-rig-label">LIGHT RIG: ON</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       GENRE FILTER MATRIX
       ══════════════════════════════════════════════════════════ -->
  <div class="sdr-genre-section">
    <div class="sdr-section-title-row">
      <h2 class="sdr-section-title">FREQUENCY PRESETS // GENRE MATRIX</h2>
      <span class="sdr-station-count-badge" id="sdr-station-count">
        {RADIO_STATIONS.length} STATIONS INDEXED
      </span>
    </div>

    <div class="sdr-genre-pills" role="tablist" aria-label="Filter stations by genre">
      {genres.map((genre) => (
        <button
          type="button"
          class:list={['sdr-genre-pill', { active: genre === 'ALL' }]}
          data-genre={genre}
          role="tab"
          aria-selected={genre === 'ALL' ? 'true' : 'false'}
        >
          <span>{genre.toUpperCase()}</span>
          <span class="genre-count">
            (
            {genre === 'ALL'
              ? RADIO_STATIONS.length
              : RADIO_STATIONS.filter((s) => s.genre === genre).length}
            )
          </span>
        </button>
      ))}
    </div>

    <!-- Sub-Genre Matrix Strip (Curated sub-genres across all primitive genres) -->
    <div class="sdr-subgenre-wrapper" id="sdr-subgenre-wrapper" aria-label="Sub-Genre Selection">
      <div class="sdr-subgenre-label">
        <span class="subgenre-bracket">[</span>
        <span class="subgenre-title">SUB-GENRE // SELECTION</span>
        <span class="subgenre-bracket">]</span>
      </div>

      {Object.entries(SUBGENRE_MAP).map(([pGenre, sublist]) => (
        <div
          class="sdr-subgenre-pills"
          id={`sdr-subgenre-pills-${pGenre.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          data-parent-genre={pGenre}
          role="tablist"
          aria-label={`Filter ${pGenre} stations by sub-genre`}
          style="display: none;"
        >
          {sublist.map((subgenre) => {
            const isAll = subgenre.startsWith('ALL');
            const count = isAll
              ? RADIO_STATIONS.filter((s) => s.genre === pGenre).length
              : RADIO_STATIONS.filter((s) => s.genre === pGenre && s.subgenre === subgenre).length;
            return (
              <button
                type="button"
                class:list={['sdr-subgenre-pill', { active: isAll }]}
                data-genre={pGenre}
                data-subgenre={subgenre}
                role="tab"
                aria-selected={isAll ? 'true' : 'false'}
              >
                <span class="subgenre-name">{subgenre.toUpperCase()}</span>
                <span class="subgenre-count">({count})</span>
              </button>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       CURATED PLAYLIST ARCHIVES (GENRES & SUB-GENRES)
       ══════════════════════════════════════════════════════════ -->
  <div class="sdr-playlists-shelf" id="sdr-playlists-shelf">
    <div class="sdr-section-title-row">
      <div class="sdr-playlists-title-group">
        <span class="subgenre-bracket">[</span>
        <h2 class="sdr-playlists-title">CURATED PLAYLISTS // TRACK ARCHIVES</h2>
        <span class="subgenre-bracket">]</span>
      </div>
      <span class="sdr-playlists-count-badge" id="sdr-playlists-count">
        {SDR_PLAYLISTS.length} PLAYLISTS INDEXED
      </span>
    </div>

    <div class="sdr-playlists-grid" id="sdr-playlists-grid">
      {SDR_PLAYLISTS.map((pl) => (
        <div
          class="sdr-playlist-card"
          id={`playlist-card-${pl.id}`}
          data-playlist-id={pl.id}
          data-genre={pl.genre}
          data-subgenre={pl.subgenre || ''}
          tabindex="0"
          role="button"
          aria-label={`Open playlist: ${pl.name}`}
        >
          <div class="playlist-card-top">
            <span class="playlist-tag">PLAYLIST</span>
            <span class="playlist-track-badge">{pl.tracks.length} TRACKS</span>
            {pl.subgenre && <span class="playlist-subgenre-tag">{pl.subgenre}</span>}
          </div>
          <h3 class="playlist-title">{pl.name}</h3>
          <p class="playlist-desc">{pl.desc}</p>
          <div class="playlist-card-bottom">
            <span class="playlist-genre-label">{pl.genre}</span>
            <span class="playlist-open-cta">QUEUE PLAYLIST →</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Active Playlist Queue Drawer -->
    <div class="sdr-queue-drawer" id="sdr-queue-drawer" style="display: none;">
      <div class="queue-drawer-header">
        <div class="queue-drawer-info">
          <span class="queue-status-tag">ACTIVE PLAYLIST QUEUE</span>
          <h4 class="queue-playlist-title" id="queue-playlist-title">
            ...
          </h4>
        </div>
        <button
          type="button"
          class="queue-close-btn"
          id="queue-close-btn"
          aria-label="Exit playlist queue"
          title="Exit Playlist Mode"
        >
          <span>✕ EXIT PLAYLIST</span>
        </button>
      </div>
      <div class="queue-tracks-list" id="queue-tracks-list" role="list">
        <!-- Injected dynamically via SDRController -->
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════
       RADIO SHACK STATION RACK
       ══════════════════════════════════════════════════════════ -->
  <div class="sdr-stations-grid" id="sdr-stations-grid" role="list">
    {RADIO_STATIONS.slice()
      .sort((a, b) => a.freqNum - b.freqNum)
      .map((station) => (
        <div
          class:list={['sdr-station-card', { 'is-active': station.id === defaultStation.id }]}
          id={`station-card-${station.id}`}
          data-station-id={station.id}
          data-yt-id={station.ytId}
          data-freq-num={station.freqNum}
          data-freq-str={station.freq}
          data-name={station.name}
          data-desc={station.desc}
          data-genre={station.genre}
          data-subgenre={station.subgenre || ''}
          data-bitrate={station.bitrate || '256 kbps WFM'}
          data-origin={station.origin || 'Broadcast'}
          role="listitem"
          tabindex="0"
        >
          <div class="station-card-top">
            <div class="station-top-left">
              <div class="station-freq-badge">
                <span class="freq-tag">{station.freq}</span>
              </div>
              <span
                class:list={[
                  'stream-type-tag',
                  station.streamType === 'live' ? 'is-live' : 'is-recorded',
                ]}
              >
                {station.streamType === 'live' ? (
                  <>
                    <span class="stream-pulse-dot" aria-hidden="true"></span>
                    <span>24/7 LIVE</span>
                  </>
                ) : (
                  <span>PRE-RECORDED</span>
                )}
              </span>
            </div>

            <div class="station-top-right">
              {station.subgenre && (
                <span class="station-subgenre-tag" title={station.subgenre}>
                  {station.subgenre}
                </span>
              )}
              <div class="station-live-eq" aria-hidden="true">
                <span class="eq-bar"></span>
                <span class="eq-bar"></span>
                <span class="eq-bar"></span>
              </div>
            </div>
          </div>

          <div class="station-card-body">
            <h3 class="station-name">{station.name}</h3>
            <p class="station-desc">{station.desc}</p>
          </div>

          <div class="station-card-meta">
            <span
              class="station-genre-tag"
              title={station.subgenre ? `${station.genre} // ${station.subgenre}` : station.genre}
            >
              {station.subgenre ? `${station.genre} // ${station.subgenre}` : station.genre}
            </span>
            <div class="station-meta-actions">
              <button
                type="button"
                class="station-ambient-pipe-btn"
                data-action="make-ambient"
                data-station-id={station.id}
                title={`Set ${station.name} as background ambient sound`}
                aria-label={`Set ${station.name} as background ambient sound`}
              >
                <span>AMBIENT</span>
              </button>
              <span class="station-tune-label">TUNE&nbsp;IN&nbsp;→</span>
            </div>
          </div>
        </div>
      ))}
  </div>

  <!-- Headless YouTube Audio Player -->
  <div class="sdr-hidden-player" aria-hidden="true">
    <div id="youtube-sdr-frame"></div>
  </div>
</section>

<!-- Client Script for SDR & YouTube Engine -->
<script>
  import {
    RADIO_STATIONS,
    SDR_PLAYLISTS,
    type FMStation,
    type SDRPlaylist,
  } from '../data/radio-stations';

  declare global {
    interface Window {
      YT: any;
      onYouTubeIframeAPIReady: () => void;
    }
  }

  class SDRController {
    private stations: FMStation[] = RADIO_STATIONS.slice().sort((a, b) => a.freqNum - b.freqNum);
    private currentStation: FMStation = RADIO_STATIONS[0];
    private isPoweredOn = false;
    private isPlaying = false;
    private volume = 80;
    private isMuted = false;
    private currentGenre = 'ALL';
    private currentSubgenre = '';

    private ytPlayer: any = null;
    private ytApiReady = false;
    private isPiping = false;

    // Timeline Scrubber & Playlist Engine
    private scrubberTimer: any = null;
    private activePlaylist: SDRPlaylist | null = null;
    private activeTrackIndex = 0;

    // Club Stage & Ambient Lightning FX
    private isClubLighting = false;
    private lightRigEnabled = true;
    private lightningTimer: any = null;

    // Visualizer modes and canvas state
    private vizMode: 'waterfall' | 'oscilloscope' | 'particles' | 'bars' = 'waterfall';
    private canvas: HTMLCanvasElement | null = null;
    private ctx: CanvasRenderingContext2D | null = null;
    private animFrameId: number | null = null;
    private waterfallLines: number[][] = [];
    private maxWaterfallLines = 60;
    private particles: {
      x: number;
      y: number;
      vx: number;
      vy: number;
      baseFreq: number;
      radius: number;
      phase: number;
    }[] = [];
    private barPeaks: number[] = new Array(32).fill(0);
    private barPeakDelays: number[] = new Array(32).fill(0);

    constructor() {
      this.initDom();
      this.initCanvas();
      this.initYouTube();
      this.attachEvents();
      this.updateDisplay();
    }

    private initDom() {
      this.canvas = document.getElementById('sdr-waterfall-canvas') as HTMLCanvasElement | null;
      if (this.canvas) {
        this.ctx = this.canvas.getContext('2d');
      }
    }

    private initYouTube() {
      // Load YouTube IFrame Player API if not already present
      if (!window.YT) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        const firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag?.parentNode?.insertBefore(tag, firstScriptTag);

        const prevReady = window.onYouTubeIframeAPIReady;
        window.onYouTubeIframeAPIReady = () => {
          if (typeof prevReady === 'function') prevReady();
          this.ytApiReady = true;
          this.createPlayer();
        };
      } else if (window.YT && window.YT.Player) {
        this.ytApiReady = true;
        this.createPlayer();
      }
    }

    private saveStationPosition() {
      if (
        this.ytPlayer &&
        typeof this.ytPlayer.getCurrentTime === 'function' &&
        this.currentStation
      ) {
        try {
          const t = this.ytPlayer.getCurrentTime();
          if (typeof t === 'number' && t > 0) {
            sessionStorage.setItem(`sdr_time_${this.currentStation.id}`, String(t));
          }
        } catch {}
      }
    }

    private createPlayer(startTime = 0) {
      try {
        const startSec = startTime > 0 ? Math.floor(startTime) : 0;
        this.ytPlayer = new window.YT.Player('youtube-sdr-frame', {
          height: '100',
          width: '100',
          videoId: this.currentStation.ytId,
          playerVars: {
            playsinline: 1,
            controls: 0,
            disablekb: 1,
            enablejsapi: 1,
            origin: window.location.origin,
            rel: 0,
            autoplay: 0,
            start: startSec > 0 ? startSec : undefined,
            modestbranding: 1,
            iv_load_policy: 3,
            fs: 0,
            widget_referrer: window.location.href,
          },
          events: {
            onReady: () => {
              this.ytPlayer.setVolume(this.volume);
              if (startSec > 0) {
                try {
                  this.ytPlayer.seekTo(startSec, true);
                } catch {}
              }
              if (this.isPoweredOn && this.isPlaying) {
                this.ytPlayer.playVideo();
              }
            },
            onStateChange: (event: any) => {
              this.handlePlayerState(event.data);
            },
            onError: () => {
              this.setStatusText('SIGNAL LOST // RETUNING');
            },
          },
        });
      } catch {
        // fallback
      }
    }

    private handlePlayerState(state: number) {
      // 1: PLAYING, 2: PAUSED, 3: BUFFERING, 0: ENDED, 5: CUED
      const mainDot = document.getElementById('sdr-main-dot');
      const powerLabel = document.getElementById('sdr-power-label');
      const powerBtn = document.getElementById('sdr-power-btn');

      if (state === 1) {
        // Playing
        this.isPlaying = true;
        this.isPoweredOn = true;
        this.setStatusText(this.activePlaylist ? 'PLAYING PLAYLIST TRACK' : 'LIVE // BROADCASTING');
        mainDot?.classList.add('is-transmitting');
        powerBtn?.classList.add('is-active');
        if (powerLabel) powerLabel.textContent = 'MUTE / PAUSE';
        this.updateActiveCard();
        this.updateClubLightingState();
        this.startScrubberTimer();
        window.dispatchEvent(new CustomEvent('sdr-radio-play'));
      } else if (state === 3) {
        // Buffering
        this.setStatusText('TUNING // ACQUIRING SIGNAL');
        if (powerLabel) powerLabel.textContent = 'BUFFERING...';
      } else if (state === 2) {
        // Paused
        this.saveStationPosition();
        this.isPlaying = false;
        mainDot?.classList.remove('is-transmitting');
        powerBtn?.classList.remove('is-active');
        if (powerLabel) powerLabel.textContent = 'RESUME AUDIO';
        this.setStatusText('RECEIVER PAUSED');
        this.updateClubLightingState();
        if (!this.isPiping) {
          window.dispatchEvent(new CustomEvent('sdr-radio-stop'));
        }
      } else if (state === 0) {
        // Ended
        if (this.activePlaylist) {
          this.playNextPlaylistTrack();
        } else {
          this.saveStationPosition();
          this.isPlaying = false;
          mainDot?.classList.remove('is-transmitting');
          powerBtn?.classList.remove('is-active');
          if (powerLabel) powerLabel.textContent = 'RESUME AUDIO';
          this.setStatusText('TRACK COMPLETE');
          this.updateClubLightingState();
          if (!this.isPiping) {
            window.dispatchEvent(new CustomEvent('sdr-radio-stop'));
          }
        }
      }
    }

    // ── Timeline Scrubber & Duration Formatter ────────────────
    private startScrubberTimer() {
      if (this.scrubberTimer) clearInterval(this.scrubberTimer);
      this.scrubberTimer = setInterval(() => {
        if (!this.ytPlayer || !this.isPlaying) return;
        if (!this.activePlaylist && this.currentStation.streamType === 'live') return;
        try {
          const cur = this.ytPlayer.getCurrentTime?.() || 0;
          const dur = this.ytPlayer.getDuration?.() || 0;
          this.updateScrubberDisplay(cur, dur);
        } catch {}
      }, 400);
    }

    private formatTime(sec: number): string {
      if (!sec || isNaN(sec) || sec < 0) return '00:00';
      const totalSec = Math.floor(sec);
      const m = Math.floor(totalSec / 60);
      const s = totalSec % 60;
      const h = Math.floor(m / 60);
      if (h > 0) {
        const remM = m % 60;
        return `${h}:${remM < 10 ? '0' : ''}${remM}:${s < 10 ? '0' : ''}${s}`;
      }
      return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
    }

    private updateScrubberDisplay(cur: number, dur: number) {
      const curEl = document.getElementById('sdr-time-current');
      const totalEl = document.getElementById('sdr-time-total');
      const fillEl = document.getElementById('sdr-timeline-fill');
      const thumbEl = document.getElementById('sdr-timeline-thumb');
      const trackEl = document.getElementById('sdr-timeline-track');

      if (curEl) curEl.textContent = this.formatTime(cur);
      if (totalEl) totalEl.textContent = dur > 0 ? this.formatTime(dur) : '--:--';

      const pct = dur > 0 ? Math.min(100, Math.max(0, (cur / dur) * 100)) : 0;
      if (fillEl) fillEl.style.width = `${pct}%`;
      if (thumbEl) thumbEl.style.left = `${pct}%`;
      if (trackEl) trackEl.setAttribute('aria-valuenow', pct.toFixed(0));
    }

    private seekDelta(delta: number) {
      if (!this.ytPlayer || typeof this.ytPlayer.getCurrentTime !== 'function') return;
      if (!this.activePlaylist && this.currentStation.streamType === 'live') return;
      try {
        const cur = this.ytPlayer.getCurrentTime() || 0;
        const dur = this.ytPlayer.getDuration() || 0;
        const target = Math.max(0, dur > 0 ? Math.min(dur, cur + delta) : cur + delta);
        this.ytPlayer.seekTo(target, true);
        this.updateScrubberDisplay(target, dur);
      } catch {}
    }

    // ── Playlist Engine ───────────────────────────────────────
    private playPlaylist(playlistId: string, trackIndex = 0) {
      const pl = SDR_PLAYLISTS.find((p) => p.id === playlistId);
      if (!pl || !pl.tracks.length) return;
      this.activePlaylist = pl;
      this.activeTrackIndex = Math.max(0, Math.min(pl.tracks.length - 1, trackIndex));
      this.renderPlaylistQueue();
      this.loadCurrentPlaylistTrack();
    }

    private renderPlaylistQueue() {
      const drawer = document.getElementById('sdr-queue-drawer');
      const titleEl = document.getElementById('queue-playlist-title');
      const listEl = document.getElementById('queue-tracks-list');
      const prevTrk = document.getElementById('sdr-track-prev-btn');
      const nextTrk = document.getElementById('sdr-track-next-btn');

      if (drawer) drawer.style.display = 'flex';
      if (titleEl && this.activePlaylist) titleEl.textContent = this.activePlaylist.name;
      if (prevTrk) prevTrk.style.display = 'inline-flex';
      if (nextTrk) nextTrk.style.display = 'inline-flex';

      if (listEl && this.activePlaylist) {
        listEl.innerHTML = this.activePlaylist.tracks
          .map(
            (t, idx) => `
            <div class="queue-track-item ${idx === this.activeTrackIndex ? 'is-current' : ''}" data-track-idx="${idx}" role="listitem" tabindex="0">
              <div class="track-item-left">
                <span class="track-num">${idx + 1 < 10 ? '0' : ''}${idx + 1}</span>
                <div style="display:flex; flex-direction:column; min-width:0;">
                  <span class="track-meta-title">${t.title}</span>
                  <span class="track-meta-artist">${t.artist}</span>
                </div>
              </div>
              <div class="track-item-right">
                ${t.year ? `<span class="track-year-tag">[${t.year}]</span>` : ''}
                ${idx === this.activeTrackIndex ? '<span class="track-play-indicator">NOW PLAYING</span>' : '<span class="track-play-indicator" style="opacity:0.5;">PLAY →</span>'}
              </div>
            </div>
          `,
          )
          .join('');

        listEl.querySelectorAll<HTMLElement>('.queue-track-item').forEach((item) => {
          item.addEventListener('click', () => {
            const idx = parseInt(item.getAttribute('data-track-idx') || '0', 10);
            this.activeTrackIndex = idx;
            this.renderPlaylistQueue();
            this.loadCurrentPlaylistTrack();
          });
        });
      }
    }

    private loadCurrentPlaylistTrack() {
      if (!this.activePlaylist) return;
      const track = this.activePlaylist.tracks[this.activeTrackIndex];
      if (!track) return;

      if (!this.isPoweredOn) {
        this.isPoweredOn = true;
      }
      this.isPlaying = true;

      // Update VFD for playlist track
      const plFreq = this.activePlaylist.freqNum || 90.5;
      const freqVal = document.getElementById('vfd-freq-val');
      const freqUnit = document.getElementById('vfd-freq-unit');
      const modulation = document.getElementById('vfd-modulation');
      const stationTitle = document.getElementById('vfd-station-title');
      const stationDesc = document.getElementById('vfd-station-desc');
      const genreBadge = document.getElementById('vfd-genre-badge');
      const streamBadge = document.getElementById('vfd-stream-type-badge');

      if (freqVal) freqVal.textContent = plFreq.toFixed(1);
      if (freqUnit) freqUnit.textContent = 'MHz';
      if (modulation) modulation.textContent = 'ARCHIVE // TAPE';
      if (stationTitle) stationTitle.textContent = `${track.artist} — ${track.title}`;
      if (stationDesc)
        stationDesc.textContent = track.desc
          ? `${track.year ? `[${track.year}] ` : ''}${track.desc}`
          : this.activePlaylist.desc;
      if (genreBadge)
        genreBadge.textContent = this.activePlaylist.subgenre
          ? `${this.activePlaylist.genre} // ${this.activePlaylist.subgenre}`
          : this.activePlaylist.genre;
      if (streamBadge) {
        streamBadge.className = 'vfd-stream-type-badge is-recorded';
        streamBadge.textContent = `PLAYLIST // TRK ${this.activeTrackIndex + 1} OF ${this.activePlaylist.tracks.length}`;
      }

      this.currentStation = {
        id: `pl-${this.activePlaylist.id}-${track.id}`,
        ytId: track.ytId,
        freq: `${plFreq.toFixed(1)} FM`,
        freqNum: plFreq,
        name: `${track.artist} — ${track.title}`,
        desc: track.desc || '',
        genre: this.activePlaylist.genre,
        subgenre: this.activePlaylist.subgenre,
        streamType: 'recorded',
        bitrate: '320 kbps WFM',
        origin: 'Master Tape Archive',
      };

      const trackWrap = document.getElementById('sdr-timeline-track-wrap');
      const liveNotice = document.getElementById('sdr-timeline-live-notice');
      if (trackWrap) trackWrap.style.display = 'flex';
      if (liveNotice) liveNotice.style.display = 'none';

      const rBtn = document.getElementById('sdr-rewind-btn');
      const fBtn = document.getElementById('sdr-forward-btn');
      rBtn?.classList.remove('is-disabled');
      fBtn?.classList.remove('is-disabled');
      rBtn?.removeAttribute('aria-disabled');
      fBtn?.removeAttribute('aria-disabled');

      if (this.ytPlayer && typeof this.ytPlayer.loadVideoById === 'function') {
        this.setStatusText(`PLAYLIST // [${track.title.toUpperCase()}]`);
        this.ytPlayer.loadVideoById(track.ytId);
        this.ytPlayer.playVideo();
      } else {
        this.currentStation = {
          ...this.currentStation,
          ytId: track.ytId,
          name: `${track.artist} — ${track.title}`,
          desc: track.desc || '',
          streamType: 'recorded',
        };
        this.createPlayer();
      }
      this.startScrubberTimer();
    }

    private playNextPlaylistTrack() {
      if (!this.activePlaylist) return;
      this.activeTrackIndex = (this.activeTrackIndex + 1) % this.activePlaylist.tracks.length;
      this.renderPlaylistQueue();
      this.loadCurrentPlaylistTrack();
    }

    private playPrevPlaylistTrack() {
      if (!this.activePlaylist) return;
      this.activeTrackIndex =
        this.activeTrackIndex <= 0
          ? this.activePlaylist.tracks.length - 1
          : this.activeTrackIndex - 1;
      this.renderPlaylistQueue();
      this.loadCurrentPlaylistTrack();
    }

    private exitPlaylistMode() {
      this.activePlaylist = null;
      const drawer = document.getElementById('sdr-queue-drawer');
      const prevTrk = document.getElementById('sdr-track-prev-btn');
      const nextTrk = document.getElementById('sdr-track-next-btn');
      if (drawer) drawer.style.display = 'none';
      if (prevTrk) prevTrk.style.display = 'none';
      if (nextTrk) nextTrk.style.display = 'none';
      this.updateDisplay();
    }

    private attachEvents() {
      // Power / Play button
      const powerBtn = document.getElementById('sdr-power-btn');
      powerBtn?.addEventListener('click', () => this.togglePower());

      // Club Stage & Ambient Lightning Rig Toggle Button
      const lightBtn = document.getElementById('sdr-light-rig-btn');
      lightBtn?.addEventListener('click', () => this.toggleLightRig());

      // Prev / Next station buttons
      const prevBtn = document.getElementById('sdr-prev-btn');
      const nextBtn = document.getElementById('sdr-next-btn');
      prevBtn?.addEventListener('click', () => this.tunePrevStation());
      nextBtn?.addEventListener('click', () => this.tuneNextStation());

      // Step tuning ±0.1 MHz
      const stepDownBtn = document.getElementById('sdr-step-down');
      const stepUpBtn = document.getElementById('sdr-step-up');
      stepDownBtn?.addEventListener('click', () => {
        this.exitPlaylistMode();
        this.stepTune(-0.1);
      });
      stepUpBtn?.addEventListener('click', () => {
        this.exitPlaylistMode();
        this.stepTune(0.1);
      });

      // Rewind / Forward controls (-15s / +15s)
      const rewindBtn = document.getElementById('sdr-rewind-btn');
      const forwardBtn = document.getElementById('sdr-forward-btn');
      rewindBtn?.addEventListener('click', () => this.seekDelta(-15));
      forwardBtn?.addEventListener('click', () => this.seekDelta(15));

      // Playlist track navigation
      const prevTrackBtn = document.getElementById('sdr-track-prev-btn');
      const nextTrackBtn = document.getElementById('sdr-track-next-btn');
      prevTrackBtn?.addEventListener('click', () => this.playPrevPlaylistTrack());
      nextTrackBtn?.addEventListener('click', () => this.playNextPlaylistTrack());

      // Close playlist queue drawer
      const closeDrawerBtn = document.getElementById('queue-close-btn');
      closeDrawerBtn?.addEventListener('click', () => this.exitPlaylistMode());

      // Interactive timeline track scrub
      const timelineTrack = document.getElementById('sdr-timeline-track');
      if (timelineTrack) {
        timelineTrack.addEventListener('click', (e: MouseEvent) => {
          if (!this.ytPlayer || typeof this.ytPlayer.getDuration !== 'function') return;
          if (!this.activePlaylist && this.currentStation.streamType === 'live') return;
          const rect = timelineTrack.getBoundingClientRect();
          const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
          const dur = this.ytPlayer.getDuration() || 0;
          if (dur > 0) {
            const target = ratio * dur;
            this.ytPlayer.seekTo(target, true);
            this.updateScrubberDisplay(target, dur);
          }
        });
      }

      // Volume slider
      const volSlider = document.getElementById('sdr-volume-slider') as HTMLInputElement | null;
      volSlider?.addEventListener('input', (e) => {
        const val = parseInt((e.target as HTMLInputElement).value, 10);
        this.setVolume(val);
      });

      // Mute toggle
      const muteBtn = document.getElementById('sdr-mute-btn');
      muteBtn?.addEventListener('click', () => this.toggleMute());

      // Route currently tuned station to background ambient sound
      const routeAmbientBtn = document.getElementById('sdr-route-ambient-btn');
      routeAmbientBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.routeStationToAmbient(this.currentStation);
      });

      // Ambient pipe click on individual station cards
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest<HTMLElement>(
          '[data-action="make-ambient"]',
        );
        if (!target) return;
        e.stopPropagation();
        e.preventDefault();
        const stationId = target.getAttribute('data-station-id');
        const station = RADIO_STATIONS.find((s) => s.id === stationId);
        if (station) {
          this.routeStationToAmbient(station);
          const span = target.querySelector('span');
          if (span) {
            const originalText = span.textContent;
            span.textContent = 'ACTIVE';
            setTimeout(() => {
              if (span) span.textContent = originalText;
            }, 2500);
          }
        }
      });

      // Playlist cards click
      const playlistCards = document.querySelectorAll<HTMLElement>('.sdr-playlist-card');
      playlistCards.forEach((card) => {
        card.addEventListener('click', () => {
          const plId = card.getAttribute('data-playlist-id');
          if (plId) {
            this.playPlaylist(plId);
          }
        });
      });

      // Genre filter tabs
      const genrePills = document.querySelectorAll<HTMLButtonElement>('.sdr-genre-pill');
      genrePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const genre = pill.getAttribute('data-genre') || 'ALL';
          this.filterGenre(genre);
        });
      });

      // Sub-Genre filter tabs
      const subgenrePills = document.querySelectorAll<HTMLButtonElement>('.sdr-subgenre-pill');
      subgenrePills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const subgenre = pill.getAttribute('data-subgenre') || '';
          this.filterSubgenre(subgenre);
        });
      });

      // Station preset cards click
      const stationCards = document.querySelectorAll<HTMLElement>('.sdr-station-card');
      stationCards.forEach((card) => {
        card.addEventListener('click', () => {
          const stationId = card.getAttribute('data-station-id');
          if (stationId) {
            this.exitPlaylistMode();
            this.tuneToStationById(stationId);
          }
        });
        card.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const stationId = card.getAttribute('data-station-id');
            if (stationId) {
              this.exitPlaylistMode();
              this.tuneToStationById(stationId);
            }
          }
        });
      });

      // Canvas click & drag to tune
      if (this.canvas) {
        let isDragging = false;
        const handleTune = (e: MouseEvent) => {
          const rect = this.canvas!.getBoundingClientRect();
          const x = Math.max(0, Math.min(e.clientX - rect.left, rect.width));
          const freq = 88.0 + (x / rect.width) * (108.0 - 88.0);
          this.exitPlaylistMode();
          this.tuneToClosestStation(freq);
        };

        this.canvas.addEventListener('mousedown', (e) => {
          isDragging = true;
          handleTune(e);
        });
        window.addEventListener('mousemove', (e) => {
          if (isDragging) handleTune(e);
        });
        window.addEventListener('mouseup', () => {
          isDragging = false;
        });

        // Touch support for mobile spectrum tuning
        this.canvas.addEventListener(
          'touchstart',
          (e) => {
            if (e.touches.length > 0) {
              const rect = this.canvas!.getBoundingClientRect();
              const x = Math.max(0, Math.min(e.touches[0].clientX - rect.left, rect.width));
              const freq = 88.0 + (x / rect.width) * (108.0 - 88.0);
              this.exitPlaylistMode();
              this.tuneToClosestStation(freq);
            }
          },
          { passive: true },
        );
      }

      // Visualizer mode switcher tabs
      const vizTabs = document.querySelectorAll<HTMLButtonElement>('.sdr-viz-tab');
      vizTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const mode = (tab.getAttribute('data-mode') || 'waterfall') as any;
          this.setVizMode(mode);
        });
      });

      // Restore saved visualizer mode
      try {
        const savedMode = localStorage.getItem('sdr_viz_mode') as any;
        if (savedMode && ['waterfall', 'oscilloscope', 'particles', 'bars'].includes(savedMode)) {
          this.setVizMode(savedMode);
        }
      } catch {}

      // Keyboard navigation (Left / Right arrow to tune, Space to play/pause)
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        // Only if not focused on text input
        if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;

        if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.exitPlaylistMode();
          this.tuneNextStation();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.exitPlaylistMode();
          this.tunePrevStation();
        } else if (e.key === ' ') {
          if (
            document.activeElement === document.body ||
            document.activeElement?.classList.contains('sdr-deck')
          ) {
            e.preventDefault();
            this.togglePower();
          }
        }
      });
    }

    private togglePower() {
      if (!this.isPoweredOn) {
        this.isPoweredOn = true;
        this.isPlaying = true;
        this.setStatusText('STARTING RF RECEIVER...');

        let resumeTime = 0;
        const ambientYtId = sessionStorage.getItem('ambient_stream_ytid');
        if (ambientYtId === this.currentStation.ytId) {
          const ambTime = parseFloat(sessionStorage.getItem('ambient_stream_time') || '0');
          if (ambTime > 0) resumeTime = ambTime;
        }
        if (resumeTime <= 0) {
          const saved = parseFloat(
            sessionStorage.getItem(`sdr_time_${this.currentStation.id}`) || '0',
          );
          if (saved > 0) resumeTime = saved;
        }

        if (this.ytPlayer && typeof this.ytPlayer.playVideo === 'function') {
          if (resumeTime > 0) {
            try {
              const cur = this.ytPlayer.getCurrentTime?.() || 0;
              if (Math.abs(cur - resumeTime) > 3) {
                this.ytPlayer.seekTo(resumeTime, true);
              }
            } catch {}
          }
          this.ytPlayer.playVideo();
        } else {
          this.createPlayer(resumeTime);
        }
      } else {
        if (this.isPlaying) {
          this.saveStationPosition();
          if (this.ytPlayer && typeof this.ytPlayer.pauseVideo === 'function') {
            this.ytPlayer.pauseVideo();
          }
          this.isPlaying = false;
        } else {
          if (this.ytPlayer && typeof this.ytPlayer.playVideo === 'function') {
            this.ytPlayer.playVideo();
          }
          this.isPlaying = true;
        }
      }
      this.updateDisplay();
      this.updateClubLightingState();
    }

    private routeStationToAmbient(station: FMStation) {
      let currentTime = 0;
      if (
        this.ytPlayer &&
        typeof this.ytPlayer.getCurrentTime === 'function' &&
        this.currentStation.id === station.id
      ) {
        try {
          currentTime = this.ytPlayer.getCurrentTime() || 0;
        } catch {}
      }
      if (currentTime <= 0) {
        const saved = parseFloat(sessionStorage.getItem(`sdr_time_${station.id}`) || '0');
        if (saved > 0) currentTime = saved;
      }

      if (currentTime > 0) {
        sessionStorage.setItem(`sdr_time_${station.id}`, String(currentTime));
      }

      this.isPiping = true;
      if (this.ytPlayer && typeof this.ytPlayer.pauseVideo === 'function') {
        try {
          this.ytPlayer.pauseVideo();
        } catch {}
      }
      this.isPlaying = false;
      this.updateDisplay();
      this.updateClubLightingState();
      setTimeout(() => {
        this.isPiping = false;
      }, 600);

      this.setStatusText(`PIPED [${station.name.toUpperCase()}] → BACKGROUND AMBIENT`);

      let code = 'SDR';
      const idLower = station.id.toLowerCase();
      if (idLower.includes('piano')) code = 'PIANO';
      else if (idLower.includes('rain')) code = 'RAIN';
      else if (idLower.includes('fire')) code = 'HEARTH';
      else if (idLower.includes('lofi')) code = 'LOFI';
      else if (idLower.includes('mozart')) code = 'MOZART';
      else if (idLower.includes('beethoven')) code = 'BEETHOVEN';
      else if (idLower.includes('chopin')) code = 'CHOPIN';
      else if (idLower.includes('rock')) code = 'ROCK';
      else if (idLower.includes('house') || idLower.includes('dance')) code = 'HOUSE';
      else if (idLower.includes('queen')) code = 'QUEEN';
      else if (station.code) code = station.code;
      else if (station.name) code = station.name.split(' ')[0].toUpperCase();

      window.dispatchEvent(
        new CustomEvent('set-ambient-sound', {
          detail: {
            id: station.id,
            name: station.name,
            ytId: station.ytId,
            code,
            isPipedFromRadio: true,
            startTime: currentTime,
          },
        }),
      );

      const label = document.getElementById('sdr-route-ambient-label');
      if (label) {
        label.textContent = 'AMBIENT ACTIVE';
        setTimeout(() => {
          if (label) label.textContent = 'PIPE TO AMBIENT';
        }, 2500);
      }
    }

    private tuneToStation(station: FMStation) {
      this.saveStationPosition();
      this.currentStation = station;
      this.updateDisplay();
      this.updateClubLightingState();

      let resumeTime = 0;
      const ambientYtId = sessionStorage.getItem('ambient_stream_ytid');
      if (ambientYtId === station.ytId) {
        const ambTime = parseFloat(sessionStorage.getItem('ambient_stream_time') || '0');
        if (ambTime > 0) resumeTime = ambTime;
      }
      if (resumeTime <= 0) {
        const saved = parseFloat(sessionStorage.getItem(`sdr_time_${station.id}`) || '0');
        if (saved > 0) resumeTime = saved;
      }

      if (this.ytPlayer && typeof this.ytPlayer.loadVideoById === 'function') {
        this.setStatusText('TUNING // ACQUIRING CARRIER...');
        if (resumeTime > 0) {
          this.ytPlayer.loadVideoById({
            videoId: station.ytId,
            startSeconds: Math.floor(resumeTime),
          });
        } else {
          this.ytPlayer.loadVideoById(station.ytId);
        }
        if (this.isPoweredOn) {
          this.ytPlayer.playVideo();
          this.isPlaying = true;
          this.updateClubLightingState();
        }
      } else {
        this.createPlayer(resumeTime);
      }
    }

    public tuneToStationById(id: string) {
      const station = this.stations.find((s) => s.id === id);
      if (station) {
        if (!this.isPoweredOn) {
          this.isPoweredOn = true;
          this.isPlaying = true;
        }
        this.tuneToStation(station);
      }
    }

    private tunePrevStation() {
      const currentList = this.getFilteredStations();
      const currentIndex = currentList.findIndex((s) => s.id === this.currentStation.id);
      const prevIndex = currentIndex <= 0 ? currentList.length - 1 : currentIndex - 1;
      this.tuneToStation(currentList[prevIndex]);
    }

    private tuneNextStation() {
      const currentList = this.getFilteredStations();
      const currentIndex = currentList.findIndex((s) => s.id === this.currentStation.id);
      const nextIndex = currentIndex >= currentList.length - 1 ? 0 : currentIndex + 1;
      this.tuneToStation(currentList[nextIndex]);
    }

    private stepTune(delta: number) {
      const targetFreq = parseFloat((this.currentStation.freqNum + delta).toFixed(1));
      this.tuneToClosestStation(targetFreq);
    }

    private tuneToClosestStation(freq: number) {
      const clampedFreq = Math.max(88.0, Math.min(108.0, freq));
      // Find the closest station
      let closest = this.stations[0];
      let minDiff = Math.abs(closest.freqNum - clampedFreq);

      for (const s of this.stations) {
        const diff = Math.abs(s.freqNum - clampedFreq);
        if (diff < minDiff) {
          minDiff = diff;
          closest = s;
        }
      }

      this.tuneToStation(closest);
    }

    private setVolume(val: number) {
      this.volume = val;
      const volLabel = document.getElementById('vol-display-label');
      if (volLabel) volLabel.textContent = `VOL: ${val}%`;

      if (this.ytPlayer && typeof this.ytPlayer.setVolume === 'function') {
        this.ytPlayer.setVolume(val);
      }
    }

    private toggleMute() {
      this.isMuted = !this.isMuted;
      const muteLabel = document.getElementById('sdr-mute-label');
      if (muteLabel) muteLabel.textContent = this.isMuted ? 'UNMUTE' : 'MUTE';

      if (this.ytPlayer) {
        if (this.isMuted) {
          this.ytPlayer.mute?.();
        } else {
          this.ytPlayer.unMute?.();
        }
      }
    }

    private filterGenre(genre: string) {
      this.currentGenre = genre;
      this.currentSubgenre = '';

      // Update pills active state
      document.querySelectorAll('.sdr-genre-pill').forEach((pill) => {
        const pGenre = pill.getAttribute('data-genre');
        if (pGenre === genre) {
          pill.classList.add('active');
          pill.setAttribute('aria-selected', 'true');
        } else {
          pill.classList.remove('active');
          pill.setAttribute('aria-selected', 'false');
        }
      });

      // Toggle sub-genre matrix bar visibility when selected genre has curated sub-genres
      const subgenreWrapper = document.getElementById('sdr-subgenre-wrapper');
      const allSubgenreContainers = document.querySelectorAll<HTMLElement>('.sdr-subgenre-pills');
      allSubgenreContainers.forEach((container) => {
        container.style.display = 'none';
      });

      let activePillGroup: HTMLElement | null = null;
      let allSubgenreName = '';

      if (genre !== 'ALL') {
        activePillGroup = document.querySelector<HTMLElement>(
          `.sdr-subgenre-pills[data-parent-genre="${genre}"]`,
        );
        if (activePillGroup) {
          const firstPill = activePillGroup.querySelector<HTMLButtonElement>('.sdr-subgenre-pill');
          allSubgenreName =
            firstPill?.getAttribute('data-subgenre') || `ALL ${genre.toUpperCase()}`;
        }
      }

      if (subgenreWrapper) {
        if (activePillGroup) {
          subgenreWrapper.classList.add('is-visible');
          activePillGroup.style.display = 'flex';
          this.currentSubgenre = allSubgenreName;

          // Reset sub-genre pills active state in this group
          activePillGroup.querySelectorAll('.sdr-subgenre-pill').forEach((pill) => {
            const isAll = pill.getAttribute('data-subgenre') === allSubgenreName;
            pill.classList.toggle('active', isAll);
            pill.setAttribute('aria-selected', isAll ? 'true' : 'false');
          });
        } else {
          subgenreWrapper.classList.remove('is-visible');
          this.currentSubgenre = '';
        }
      }

      // Filter station cards
      const cards = document.querySelectorAll<HTMLElement>('.sdr-station-card');
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardGenre = card.getAttribute('data-genre');
        if (genre === 'ALL' || cardGenre === genre) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      const countBadge = document.getElementById('sdr-station-count');
      if (countBadge) {
        countBadge.textContent = `${visibleCount} STATIONS VISIBLE`;
      }

      // Filter playlist cards
      const plCards = document.querySelectorAll<HTMLElement>('.sdr-playlist-card');
      let plCount = 0;
      plCards.forEach((card) => {
        const cardGenre = card.getAttribute('data-genre');
        if (genre === 'ALL' || cardGenre === genre) {
          card.style.display = 'flex';
          plCount++;
        } else {
          card.style.display = 'none';
        }
      });
      const plCountBadge = document.getElementById('sdr-playlists-count');
      if (plCountBadge) {
        plCountBadge.textContent = `${plCount} PLAYLISTS VISIBLE`;
      }
    }

    private filterSubgenre(subgenre: string) {
      this.currentSubgenre = subgenre;

      // Update sub-genre pills active state in current genre's subgenre container
      const isAllSub = subgenre.startsWith('ALL');
      document
        .querySelectorAll(`.sdr-subgenre-pill[data-genre="${this.currentGenre}"]`)
        .forEach((pill) => {
          const pSub = pill.getAttribute('data-subgenre');
          const isActive = pSub === subgenre;
          pill.classList.toggle('active', isActive);
          pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

      // Filter station cards by subgenre within currentGenre
      const cards = document.querySelectorAll<HTMLElement>('.sdr-station-card');
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardGenre = card.getAttribute('data-genre');
        const cardSubgenre = card.getAttribute('data-subgenre');
        if (cardGenre === this.currentGenre && (isAllSub || cardSubgenre === subgenre)) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      const countBadge = document.getElementById('sdr-station-count');
      if (countBadge) {
        countBadge.textContent = `${visibleCount} STATIONS VISIBLE`;
      }

      // Filter playlist cards by subgenre within currentGenre
      const plCards = document.querySelectorAll<HTMLElement>('.sdr-playlist-card');
      let plCount = 0;
      plCards.forEach((card) => {
        const cardGenre = card.getAttribute('data-genre');
        const cardSubgenre = card.getAttribute('data-subgenre');
        const matchGenre = this.currentGenre === 'ALL' || cardGenre === this.currentGenre;
        const matchSub = isAllSub || cardSubgenre === subgenre;
        if (matchGenre && matchSub) {
          card.style.display = 'flex';
          plCount++;
        } else {
          card.style.display = 'none';
        }
      });
      const plCountBadge = document.getElementById('sdr-playlists-count');
      if (plCountBadge) {
        plCountBadge.textContent = `${plCount} PLAYLISTS VISIBLE`;
      }
    }

    private getFilteredStations(): FMStation[] {
      if (this.currentGenre === 'ALL') return this.stations;
      if (this.currentSubgenre && !this.currentSubgenre.startsWith('ALL')) {
        return this.stations.filter(
          (s) => s.genre === this.currentGenre && s.subgenre === this.currentSubgenre,
        );
      }
      return this.stations.filter((s) => s.genre === this.currentGenre);
    }

    private updateDisplay() {
      // VFD frequency and title
      const freqVal = document.getElementById('vfd-freq-val');
      const freqUnit = document.getElementById('vfd-freq-unit');
      const modulation = document.getElementById('vfd-modulation');
      const stationTitle = document.getElementById('vfd-station-title');
      const stationDesc = document.getElementById('vfd-station-desc');
      const genreBadge = document.getElementById('vfd-genre-badge');
      const bitrateVal = document.getElementById('sdr-bitrate-val');
      const streamBadge = document.getElementById('vfd-stream-type-badge');

      if (freqVal) freqVal.textContent = this.currentStation.freqNum.toFixed(1);
      if (freqUnit) freqUnit.textContent = 'MHz';
      if (stationTitle) stationTitle.textContent = this.currentStation.name;
      if (stationDesc) stationDesc.textContent = this.currentStation.desc;
      if (genreBadge) {
        genreBadge.textContent = this.currentStation.subgenre
          ? `${this.currentStation.genre} // ${this.currentStation.subgenre}`
          : this.currentStation.genre;
      }
      if (bitrateVal) bitrateVal.textContent = this.currentStation.bitrate || '256 kbps WFM';

      const isLiveStation = this.currentStation.streamType === 'live';
      if (modulation) {
        modulation.textContent = isLiveStation ? 'WFM / STEREO' : 'PRE-REC / STEREO';
      }
      if (streamBadge) {
        streamBadge.className = `vfd-stream-type-badge ${isLiveStation ? 'is-live' : 'is-recorded'}`;
        streamBadge.textContent = isLiveStation ? '● 24/7 LIVE' : 'PRE-RECORDED ARCHIVE';
      }

      // Toggle timeline scrubber vs live real-time notice
      const trackWrap = document.getElementById('sdr-timeline-track-wrap');
      const liveNotice = document.getElementById('sdr-timeline-live-notice');
      if (trackWrap) trackWrap.style.display = isLiveStation ? 'none' : 'flex';
      if (liveNotice) liveNotice.style.display = isLiveStation ? 'inline-flex' : 'none';

      // Toggle seek buttons disabled state
      const rewindBtn = document.getElementById('sdr-rewind-btn');
      const forwardBtn = document.getElementById('sdr-forward-btn');
      if (rewindBtn) {
        rewindBtn.classList.toggle('is-disabled', isLiveStation);
        rewindBtn.setAttribute('aria-disabled', isLiveStation ? 'true' : 'false');
      }
      if (forwardBtn) {
        forwardBtn.classList.toggle('is-disabled', isLiveStation);
        forwardBtn.setAttribute('aria-disabled', isLiveStation ? 'true' : 'false');
      }

      // Update RSSI based on frequency (simulated RF field)
      const rssiVal = document.getElementById('sdr-rssi-val');
      const snrVal = document.getElementById('sdr-snr-val');
      const barFill = document.getElementById('signal-bar-fill');

      const simRssi = -48 - Math.floor(Math.sin(this.currentStation.freqNum * 3) * 14);
      const simSnr = (30 + Math.cos(this.currentStation.freqNum * 2) * 8).toFixed(1);

      if (rssiVal) rssiVal.textContent = `${simRssi} dBm`;
      if (snrVal) snrVal.textContent = `${simSnr} dB`;
      if (barFill) barFill.style.width = `${Math.min(98, Math.max(45, 100 + simRssi * 0.8))}%`;

      // Update card active classes
      this.updateActiveCard();

      // Update slider accessibility
      if (this.canvas) {
        this.canvas.setAttribute('aria-valuenow', this.currentStation.freqNum.toString());
      }
    }

    private updateActiveCard() {
      document.querySelectorAll('.sdr-station-card').forEach((card) => {
        const id = card.getAttribute('data-station-id');
        if (id === this.currentStation.id) {
          card.classList.add('is-active');
          if (this.isPlaying) {
            card.classList.add('is-playing');
          } else {
            card.classList.remove('is-playing');
          }
        } else {
          card.classList.remove('is-active', 'is-playing');
        }
      });
    }

    private setStatusText(text: string) {
      const statusText = document.getElementById('sdr-main-status-text');
      if (statusText) statusText.textContent = text;
    }

    // ── Club Stage & Ambient Lightning FX (House & Electronic Music Only) ──
    private updateClubLightingState() {
      const isClubMusic =
        this.currentStation.genre === 'House Music' ||
        this.currentStation.genre === 'Electronic Music';
      const isRaving = isClubMusic && this.isPlaying && this.isPoweredOn;
      this.isClubLighting = isRaving && this.lightRigEnabled;

      const deckWrap = document.getElementById('sdr-deck-wrap');
      const mainDeck = document.getElementById('sdr-main-deck');
      const syncBadge = document.getElementById('vfd-club-sync');
      const lightBtn = document.getElementById('sdr-light-rig-btn');
      const lightLed = document.getElementById('sdr-light-rig-led');
      const lightLabel = document.getElementById('sdr-light-rig-label');

      if (lightBtn) {
        if (isRaving) {
          lightBtn.style.display = 'inline-flex';
          if (this.lightRigEnabled) {
            lightBtn.classList.add('is-active');
            if (lightLed) lightLed.style.background = 'var(--accent)';
            if (lightLabel) lightLabel.textContent = 'LIGHT RIG: ON';
          } else {
            lightBtn.classList.remove('is-active');
            if (lightLed) lightLed.style.background = 'var(--ink-dim)';
            if (lightLabel) lightLabel.textContent = 'LIGHT RIG: OFF';
          }
        } else {
          lightBtn.style.display = 'none';
        }
      }

      if (this.isClubLighting) {
        deckWrap?.classList.add('club-lighting-active');
        mainDeck?.classList.add('club-deck-active');
        if (syncBadge) syncBadge.style.display = 'inline-flex';
        this.startLightningScheduler();
      } else {
        deckWrap?.classList.remove('club-lighting-active');
        mainDeck?.classList.remove('club-deck-active');
        if (syncBadge) syncBadge.style.display = 'none';
        this.stopLightningScheduler();
      }
    }

    private toggleLightRig() {
      this.lightRigEnabled = !this.lightRigEnabled;
      this.updateClubLightingState();
    }

    private startLightningScheduler() {
      if (this.lightningTimer) return;
      const scheduleNext = () => {
        // Trigger ambient lightning burst every 4 to 8 seconds
        const delay = 4000 + Math.random() * 4000;
        this.lightningTimer = setTimeout(() => {
          if (this.isClubLighting) {
            this.triggerLightningFlash();
            scheduleNext();
          }
        }, delay);
      };
      scheduleNext();
    }

    private stopLightningScheduler() {
      if (this.lightningTimer) {
        clearTimeout(this.lightningTimer);
        this.lightningTimer = null;
      }
      const flashEl = document.getElementById('ambient-lightning-flash');
      flashEl?.classList.remove('is-striking', 'is-striking-after');
    }

    private triggerLightningFlash() {
      if (!this.isClubLighting) return;
      const flashEl = document.getElementById('ambient-lightning-flash');
      if (!flashEl) return;

      // Strobe strike
      flashEl.classList.add('is-striking');
      setTimeout(() => {
        flashEl.classList.remove('is-striking');
        // Secondary aftershock strike
        setTimeout(() => {
          if (!this.isClubLighting) return;
          flashEl.classList.add('is-striking-after');
          setTimeout(() => {
            flashEl.classList.remove('is-striking-after');
          }, 80);
        }, 100);
      }, 120);
    }

    // ── Multi-Mode Visualizer Canvas Engine ───────────────────
    public setVizMode(mode: 'waterfall' | 'oscilloscope' | 'particles' | 'bars') {
      this.vizMode = mode;
      try {
        localStorage.setItem('sdr_viz_mode', mode);
      } catch {}

      // Update mode switcher buttons
      document.querySelectorAll<HTMLButtonElement>('.sdr-viz-tab').forEach((tab) => {
        const tMode = tab.getAttribute('data-mode');
        const isActive = tMode === mode;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      const modeTag = document.getElementById('viz-active-mode-tag');
      const hintText = document.getElementById('viz-hint-text');
      const scaleHeader = document.getElementById('waterfall-scale-header');

      if (mode === 'waterfall') {
        if (modeTag) modeTag.textContent = 'DSP: WATERFALL FFT';
        if (hintText)
          hintText.textContent = '[SPECTRUM FFT & WATERFALL ANALYZER — CLICK OR DRAG TO TUNE]';
        if (scaleHeader) scaleHeader.style.visibility = 'visible';
      } else if (mode === 'oscilloscope') {
        if (modeTag) modeTag.textContent = 'DSP: CRT OSCILLOSCOPE';
        if (hintText)
          hintText.textContent = '[CRT PHOSPHOR VECTOR SCOPE — CH1 RF TIME-DOMAIN WAVEFORM]';
        if (scaleHeader) scaleHeader.style.visibility = 'hidden';
      } else if (mode === 'particles') {
        if (modeTag) modeTag.textContent = 'DSP: PARTICLE CONSTELLATION';
        if (hintText)
          hintText.textContent = '[QUANTUM FREQUENCY PARTICLES — CLICK TO SHIFT ATTRACTOR FIELD]';
        if (scaleHeader) scaleHeader.style.visibility = 'visible';
      } else if (mode === 'bars') {
        if (modeTag) modeTag.textContent = 'DSP: 32-BAND VFD EQUALIZER';
        if (hintText)
          hintText.textContent = '[32-BAND STEREO GRAPHIC EQUALIZER & PEAK-HOLD METERS]';
        if (scaleHeader) scaleHeader.style.visibility = 'hidden';
      }
    }

    private initCanvas() {
      if (!this.canvas || !this.ctx) return;

      const resize = () => {
        const dpr = window.devicePixelRatio || 1;
        const rect = this.canvas!.getBoundingClientRect();
        this.canvas!.width = Math.floor(rect.width * dpr);
        this.canvas!.height = Math.floor(rect.height * dpr);
        this.ctx!.scale(dpr, dpr);
      };

      resize();
      window.addEventListener('resize', resize);

      this.renderCanvas();
    }

    private initParticles(w: number, h: number) {
      this.particles = [];
      const count = 110;
      for (let i = 0; i < count; i++) {
        this.particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.8,
          vy: (Math.random() - 0.5) * 0.8,
          baseFreq: 88.0 + Math.random() * 20.0,
          radius: 1.2 + Math.random() * 2.2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    private renderCanvas = () => {
      if (!this.canvas || !this.ctx) return;
      const rect = this.canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      const isClub = this.isClubLighting;
      const now = performance.now();
      const beatPeriod = 476.19; // 126 BPM
      const beatPhase = (now % beatPeriod) / beatPeriod;
      const kickEnvelope = isClub ? Math.pow(Math.max(0, 1 - beatPhase * 2.5), 2.5) : 0;

      const computed = window.getComputedStyle(document.documentElement);
      const accent = computed.getPropertyValue('--accent').trim() || '#f29559';
      const accentRgb = computed.getPropertyValue('--accent-rgb').trim() || '242, 149, 89';

      if (this.vizMode === 'waterfall') {
        this.renderWaterfallMode(w, h, accent, accentRgb, isClub, kickEnvelope, now);
      } else if (this.vizMode === 'oscilloscope') {
        this.renderOscilloscopeMode(w, h, accent, accentRgb, isClub, kickEnvelope, now);
      } else if (this.vizMode === 'particles') {
        this.renderParticlesMode(w, h, accent, accentRgb, isClub, kickEnvelope, now);
      } else if (this.vizMode === 'bars') {
        this.renderBarsMode(w, h, accent, accentRgb, isClub, kickEnvelope, now);
      }

      this.animFrameId = requestAnimationFrame(this.renderCanvas);
    };

    // ── Mode 1: Waterfall Spectrogram & Smooth Non-Clipping FFT ──
    private renderWaterfallMode(
      w: number,
      h: number,
      accent: string,
      accentRgb: string,
      isClub: boolean,
      kickEnvelope: number,
      now: number,
    ) {
      const ctx = this.ctx!;
      ctx.clearRect(0, 0, w, h);

      const spectrumH = h * 0.44;
      const waterfallH = h * 0.56;
      const waterfallY = spectrumH;

      const points = 140;
      const spectrumData: number[] = new Array(points).fill(0);
      const minFreq = 88.0;
      const maxFreq = 108.0;
      const timeSec = now * 0.001;

      // Ambient dynamic RF noise floor with gentle micro-fluctuations
      for (let i = 0; i < points; i++) {
        const f = minFreq + (i / (points - 1)) * (maxFreq - minFreq);
        const flutter = Math.sin(timeSec * 3 + f * 5) * 1.5 + Math.cos(timeSec * 7 - f * 2) * 1.0;
        spectrumData[i] = 4 + flutter + Math.random() * 3.5;
      }

      // Add Gaussian spectral peaks for all radio stations
      this.stations.forEach((st) => {
        const freqRatio = (st.freqNum - minFreq) / (maxFreq - minFreq);
        const centerIdx = Math.floor(freqRatio * points);
        const isCurrent = st.id === this.currentStation.id;

        const peakAmp = isCurrent
          ? this.isPlaying
            ? isClub
              ? 38 + kickEnvelope * 30 + Math.random() * 5
              : 34 + Math.sin(timeSec * 6) * 6 + Math.random() * 5
            : 22
          : 12 + Math.random() * 2;

        for (let offset = -4; offset <= 4; offset++) {
          const idx = centerIdx + offset;
          if (idx >= 0 && idx < points) {
            const bell = Math.exp(-(offset * offset) / 3.4);
            spectrumData[idx] += bell * peakAmp;
          }
        }
      });

      // Subtle RF reference grid lines (-20, -40, -60, -80 dBm)
      ctx.save();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 4]);
      for (let db = 1; db <= 3; db++) {
        const gridY = 16 + (db / 4) * (spectrumH - 20);
        ctx.beginPath();
        ctx.moveTo(0, gridY);
        ctx.lineTo(w, gridY);
        ctx.stroke();
      }
      ctx.restore();

      // Soft-knee compression: bounds peak to ALWAYS leave at least 15px safe headroom!
      // Guarantees waveform is NEVER cut on the top
      const topHeadroom = 15;
      const usableHeight = spectrumH - topHeadroom - 4;
      const coords: { x: number; y: number }[] = [];

      for (let i = 0; i < points; i++) {
        const x = (i / (points - 1)) * w;
        const compressed = Math.tanh(spectrumData[i] / 56);
        const y = topHeadroom + (1 - compressed) * usableHeight;
        coords.push({ x, y });
      }

      // Draw smooth quadratic curve through spectrum points
      ctx.beginPath();
      ctx.moveTo(coords[0].x, coords[0].y);
      for (let i = 0; i < coords.length - 1; i++) {
        const midX = (coords[i].x + coords[i + 1].x) / 2;
        const midY = (coords[i].y + coords[i + 1].y) / 2;
        ctx.quadraticCurveTo(coords[i].x, coords[i].y, midX, midY);
      }
      ctx.lineTo(coords[coords.length - 1].x, coords[coords.length - 1].y);

      if (isClub) {
        const lineGrad = ctx.createLinearGradient(0, 0, w, 0);
        lineGrad.addColorStop(0, accent);
        lineGrad.addColorStop(0.5, '#ffffff');
        lineGrad.addColorStop(1, accent);
        ctx.strokeStyle = lineGrad;
        ctx.lineWidth = 1.8 + kickEnvelope * 1.2;
      } else {
        ctx.strokeStyle = accent;
        ctx.lineWidth = 1.6;
      }
      ctx.stroke();

      // Gradient area under curve
      ctx.lineTo(w, spectrumH);
      ctx.lineTo(0, spectrumH);
      ctx.closePath();
      const areaGrad = ctx.createLinearGradient(0, topHeadroom, 0, spectrumH);
      if (isClub) {
        areaGrad.addColorStop(0, `rgba(${accentRgb}, ${0.45 + kickEnvelope * 0.25})`);
        areaGrad.addColorStop(0.6, `rgba(${accentRgb}, ${0.15 + kickEnvelope * 0.15})`);
        areaGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      } else {
        areaGrad.addColorStop(0, `rgba(${accentRgb}, 0.32)`);
        areaGrad.addColorStop(0.7, `rgba(${accentRgb}, 0.08)`);
        areaGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      }
      ctx.fillStyle = areaGrad;
      ctx.fill();

      // Active carrier cursor (vertical reticle line)
      const currentRatio = (this.currentStation.freqNum - minFreq) / (maxFreq - minFreq);
      const curX = currentRatio * w;

      if (isClub) {
        ctx.save();
        ctx.shadowColor = accent;
        ctx.shadowBlur = 12 + kickEnvelope * 16;
        ctx.beginPath();
        ctx.strokeStyle = `rgba(${accentRgb}, ${0.85 + kickEnvelope * 0.15})`;
        ctx.lineWidth = 2 + kickEnvelope * 2;
        ctx.moveTo(curX, 0);
        ctx.lineTo(curX, h);
        ctx.stroke();
        ctx.restore();
      } else {
        ctx.beginPath();
        ctx.setLineDash([2, 2]);
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.2;
        ctx.moveTo(curX, 0);
        ctx.lineTo(curX, h);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // Marker pointer arrow at top
      ctx.fillStyle = accent;
      ctx.beginPath();
      ctx.moveTo(curX - 4, 0);
      ctx.lineTo(curX + 4, 0);
      ctx.lineTo(curX, 7);
      ctx.closePath();
      ctx.fill();

      // Waterfall Spectrogram rolling history
      const newSlice: number[] = new Array(points);
      for (let i = 0; i < points; i++) {
        newSlice[i] = spectrumData[i];
      }
      this.waterfallLines.unshift(newSlice);
      if (this.waterfallLines.length > this.maxWaterfallLines) {
        this.waterfallLines.pop();
      }

      const sliceH = waterfallH / this.maxWaterfallLines;
      const colW = w / points;

      for (let row = 0; row < this.waterfallLines.length; row++) {
        const y = waterfallY + row * sliceH;
        const rowData = this.waterfallLines[row];

        for (let col = 0; col < points; col++) {
          const x = col * colW;
          const val = rowData[col];
          const intensity = Math.min(1, Math.max(0, (val - 5) / 40));

          if (intensity > 0.08) {
            if (intensity > 0.75) {
              ctx.fillStyle = '#ffffff';
            } else if (intensity > 0.5) {
              ctx.fillStyle = `rgba(${accentRgb}, ${0.85 + intensity * 0.15})`;
            } else if (intensity > 0.28) {
              ctx.fillStyle = `rgba(${accentRgb}, ${intensity * 0.8})`;
            } else {
              ctx.fillStyle = `rgba(18, 55, 85, ${intensity * 1.5})`;
            }
            ctx.fillRect(x, y, colW + 0.6, sliceH + 0.6);
          }
        }
      }

      // Spectrum / waterfall divider
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      this.ctx.moveTo(0, waterfallY);
      this.ctx.lineTo(w, waterfallY);
      this.ctx.stroke();
    }

    // ── Mode 2: Retro Phosphor CRT Vector Oscilloscope ────────
    private renderOscilloscopeMode(
      w: number,
      h: number,
      accent: string,
      accentRgb: string,
      isClub: boolean,
      kickEnvelope: number,
      now: number,
    ) {
      const ctx = this.ctx!;

      // Dark CRT phosphor glass tint
      ctx.fillStyle = '#020704';
      ctx.fillRect(0, 0, w, h);

      // CRT phosphor grid (8 rows x 10 cols)
      ctx.save();
      ctx.strokeStyle = 'rgba(0, 255, 120, 0.07)';
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 4]);

      const cols = 10;
      const rows = 8;
      for (let c = 1; c < cols; c++) {
        const gx = (c / cols) * w;
        ctx.beginPath();
        ctx.moveTo(gx, 0);
        ctx.lineTo(gx, h);
        ctx.stroke();
      }
      for (let r = 1; r < rows; r++) {
        const gy = (r / rows) * h;
        ctx.beginPath();
        ctx.moveTo(0, gy);
        ctx.lineTo(w, gy);
        ctx.stroke();
      }

      // Center crosshair with division tick marks
      ctx.strokeStyle = 'rgba(0, 255, 120, 0.22)';
      ctx.setLineDash([]);
      const midX = w / 2;
      const midY = h / 2;
      ctx.beginPath();
      ctx.moveTo(0, midY);
      ctx.lineTo(w, midY);
      ctx.moveTo(midX, 0);
      ctx.lineTo(midX, h);
      ctx.stroke();

      for (let t = -4; t <= 4; t++) {
        const tx = midX + t * (w / 10);
        ctx.beginPath();
        ctx.moveTo(tx, midY - 3);
        ctx.lineTo(tx, midY + 3);
        ctx.stroke();
        const ty = midY + t * (h / 8);
        ctx.beginPath();
        ctx.moveTo(midX - 3, ty);
        ctx.lineTo(midX + 3, ty);
        ctx.stroke();
      }
      ctx.restore();

      // Real-time time-domain waveform synthesis
      const centerY = h / 2;
      const maxAmp = h / 2 - 18; // Guaranteed 18px top and bottom headroom
      const timeSec = now * 0.001;
      const isPlaying = this.isPlaying;

      const fRatio = (this.currentStation.freqNum - 88.0) / 20.0;
      const fundamentalFreq = 2.5 + fRatio * 3.5;
      const ampBase = isPlaying ? (isClub ? 0.75 + kickEnvelope * 0.2 : 0.65) : 0.15;

      const points = 180;
      const wavePoints: { x: number; y: number }[] = [];

      for (let i = 0; i < points; i++) {
        const x = (i / (points - 1)) * w;
        const phase = (x / w) * Math.PI * 4 * fundamentalFreq;

        const s1 = Math.sin(phase - timeSec * 12);
        const s2 = isPlaying ? Math.sin(phase * 2.01 + timeSec * 16) * 0.35 : 0;
        const s3 = isPlaying ? Math.sin(phase * 3.03 - timeSec * 22) * 0.15 : 0;
        const noise = (Math.random() - 0.5) * (isPlaying ? 0.08 : 0.05);

        const combined = (s1 + s2 + s3 + noise) * ampBase;
        const clamped = Math.max(-0.95, Math.min(0.95, combined));
        const y = centerY - clamped * maxAmp;
        wavePoints.push({ x, y });
      }

      // Pass 1: Phosphor beam glow bloom
      ctx.save();
      ctx.shadowColor = isClub ? accent : '#00ff88';
      ctx.shadowBlur = 12;
      ctx.strokeStyle = isClub ? `rgba(${accentRgb}, 0.55)` : 'rgba(0, 255, 136, 0.55)';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(wavePoints[0].x, wavePoints[0].y);
      for (let i = 1; i < wavePoints.length; i++) {
        ctx.lineTo(wavePoints[i].x, wavePoints[i].y);
      }
      ctx.stroke();

      // Pass 2: High-intensity sharp core electron beam
      ctx.shadowBlur = 4;
      ctx.shadowColor = '#ffffff';
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.3;
      ctx.stroke();
      ctx.restore();

      // CRT telemetry readout in corners
      ctx.save();
      ctx.font = '8px monospace';
      ctx.fillStyle = 'rgba(0, 255, 120, 0.7)';
      ctx.fillText('CH1: 50mV/DIV', 10, 16);
      ctx.fillText('TIME: 2.0ms/DIV', 10, 28);
      ctx.textAlign = 'right';
      ctx.fillText(`TRIG: AUTO // ${this.currentStation.freq}`, w - 10, 16);
      ctx.fillText(isPlaying ? 'SIG: ACQUIRED' : 'SIG: STANDBY', w - 10, 28);
      ctx.restore();
    }

    // ── Mode 3: Quantum Frequency Particle Constellation ───────
    private renderParticlesMode(
      w: number,
      h: number,
      accent: string,
      accentRgb: string,
      isClub: boolean,
      kickEnvelope: number,
      now: number,
    ) {
      const ctx = this.ctx!;

      if (this.particles.length === 0) {
        this.initParticles(w, h);
      }

      // Semi-transparent trailing fade for smooth particle comet trails
      ctx.fillStyle = 'rgba(3, 6, 12, 0.3)';
      ctx.fillRect(0, 0, w, h);

      const targetX = ((this.currentStation.freqNum - 88.0) / 20.0) * w;
      const centerY = h / 2;
      const isPlaying = this.isPlaying;

      // Center frequency orbital beacon
      ctx.save();
      ctx.beginPath();
      ctx.arc(targetX, centerY, 4 + kickEnvelope * 6, 0, Math.PI * 2);
      ctx.fillStyle = accent;
      ctx.shadowColor = accent;
      ctx.shadowBlur = 12 + kickEnvelope * 14;
      ctx.fill();

      // Outer ripple ring
      ctx.beginPath();
      const ringRadius = 16 + ((now * 0.04) % 35);
      ctx.arc(targetX, centerY, ringRadius, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(${accentRgb}, ${Math.max(0, 1 - ringRadius / 50)})`;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.restore();

      // Update and draw particles
      const pCount = this.particles.length;
      for (let i = 0; i < pCount; i++) {
        const p = this.particles[i];

        // Gravitational pull toward tuned carrier frequency
        const dx = targetX - p.x;
        const dy = centerY - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        const force = Math.min(0.12, 40 / (dist + 50));
        p.vx += (dx / dist) * force * 0.08;
        p.vy += (dy / dist) * force * 0.08;

        if (isPlaying && kickEnvelope > 0.4) {
          const angle = Math.atan2(dy, dx);
          p.vx -= Math.cos(angle) * kickEnvelope * 0.6;
          p.vy -= Math.sin(angle) * kickEnvelope * 0.6;
        }

        p.vx += (Math.random() - 0.5) * 0.15;
        p.vy += (Math.random() - 0.5) * 0.15;

        p.vx *= 0.96;
        p.vy *= 0.96;

        p.x += p.vx;
        p.y += p.vy;

        // Bounce / clamp within safe bounds with 12px headroom
        if (p.x < 8) {
          p.x = 8;
          p.vx *= -1;
        }
        if (p.x > w - 8) {
          p.x = w - 8;
          p.vx *= -1;
        }
        if (p.y < 14) {
          p.y = 14;
          p.vy *= -1;
        }
        if (p.y > h - 14) {
          p.y = h - 14;
          p.vy *= -1;
        }

        ctx.beginPath();
        const curR = p.radius * (isPlaying ? 1 + kickEnvelope * 0.5 : 1);
        ctx.arc(p.x, p.y, curR, 0, Math.PI * 2);
        ctx.fillStyle = dist < 70 ? accent : 'rgba(255, 255, 255, 0.7)';
        ctx.fill();

        // Connect nearby particles with constellation filaments
        for (let j = i + 1; j < pCount; j++) {
          const p2 = this.particles[j];
          const cdx = p.x - p2.x;
          const cdy = p.y - p2.y;
          const cdist = Math.sqrt(cdx * cdx + cdy * cdy);
          if (cdist < 40) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            const lineAlpha = (1 - cdist / 40) * 0.25;
            ctx.strokeStyle = `rgba(${accentRgb}, ${lineAlpha})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      ctx.save();
      ctx.font = '8px monospace';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.fillText(`FIELD: QUANTUM NODES // 110`, 10, 16);
      ctx.textAlign = 'right';
      ctx.fillText(`CENTER: ${this.currentStation.freq}`, w - 10, 16);
      ctx.restore();
    }

    // ── Mode 4: 32-Band VFD Equalizer & Peak-Hold Meters ───────
    private renderBarsMode(
      w: number,
      h: number,
      accent: string,
      accentRgb: string,
      isClub: boolean,
      kickEnvelope: number,
      now: number,
    ) {
      const ctx = this.ctx!;
      ctx.clearRect(0, 0, w, h);

      ctx.fillStyle = '#05070a';
      ctx.fillRect(0, 0, w, h);

      const numBars = 32;
      const barPadding = 3;
      const barWidth = (w - (numBars + 1) * barPadding) / numBars;
      const topSafeY = 16; // 16px reserved top headroom
      const maxBarH = h - 34;
      const isPlaying = this.isPlaying;
      const timeSec = now * 0.001;

      const fLabels: { [key: number]: string } = {
        0: '32',
        4: '64',
        8: '125',
        12: '250',
        16: '500',
        20: '1k',
        24: '4k',
        28: '10k',
        31: '16k',
      };

      for (let i = 0; i < numBars; i++) {
        const x = barPadding + i * (barWidth + barPadding);

        let targetEnergy = 0.08;
        if (isPlaying) {
          const bassBoost = i < 8 ? (isClub ? 0.9 * kickEnvelope : 0.6) : 0;
          const midPresence = i >= 8 && i < 22 ? Math.sin(timeSec * 8 + i * 0.4) * 0.35 + 0.45 : 0;
          const highAir = i >= 22 ? Math.sin(timeSec * 14 - i * 0.6) * 0.25 + 0.35 : 0;
          targetEnergy = Math.max(
            0.08,
            Math.min(0.96, bassBoost + midPresence + highAir + Math.random() * 0.15),
          );
        } else {
          targetEnergy = 0.06 + Math.sin(timeSec * 2 + i * 0.3) * 0.04;
        }

        if (targetEnergy > this.barPeaks[i]) {
          this.barPeaks[i] = targetEnergy;
          this.barPeakDelays[i] = 12;
        } else {
          if (this.barPeakDelays[i] > 0) {
            this.barPeakDelays[i]--;
          } else {
            this.barPeaks[i] = Math.max(0.06, this.barPeaks[i] - 0.02);
          }
        }

        const segments = 14;
        const segGap = 1.5;
        const segH = (maxBarH - (segments - 1) * segGap) / segments;
        const litSegments = Math.round(targetEnergy * segments);

        for (let s = 0; s < segments; s++) {
          const segY = topSafeY + maxBarH - (s + 1) * (segH + segGap);
          const isLit = s < litSegments;

          if (isLit) {
            if (s >= 12) {
              ctx.fillStyle = '#ff4d4d';
            } else if (s >= 9) {
              ctx.fillStyle = accent;
            } else {
              ctx.fillStyle = isClub ? `rgba(${accentRgb}, 0.9)` : '#00c3a5';
            }
          } else {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.04)';
          }

          ctx.fillRect(x, segY, barWidth, segH);
        }

        // Floating Peak-Hold cap
        const peakSegY = topSafeY + maxBarH - this.barPeaks[i] * maxBarH;
        ctx.fillStyle = this.barPeaks[i] > 0.85 ? '#ff4d4d' : '#ffffff';
        ctx.fillRect(x, peakSegY, barWidth, 2);

        if (fLabels[i]) {
          ctx.font = '7.5px monospace';
          ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
          ctx.textAlign = 'center';
          ctx.fillText(fLabels[i], x + barWidth / 2, topSafeY + maxBarH + 12);
        }
      }

      ctx.save();
      ctx.font = '8px monospace';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
      ctx.textAlign = 'left';
      ctx.fillText('32-BAND ISO GRAPHIC EQ', 10, topSafeY - 4);
      ctx.textAlign = 'right';
      ctx.fillText(isPlaying ? 'PEAK: 0 dB' : 'MUTED', w - 10, topSafeY - 4);
      ctx.restore();
    }

    public destroy() {
      this.saveStationPosition();
      this.stopLightningScheduler();
      if (this.scrubberTimer) {
        clearInterval(this.scrubberTimer);
        this.scrubberTimer = null;
      }
      if (this.animFrameId) {
        cancelAnimationFrame(this.animFrameId);
      }
      if (this.isPlaying && !this.isPiping) {
        this.isPlaying = false;
        window.dispatchEvent(new CustomEvent('sdr-radio-stop'));
      }
      if (this.ytPlayer && typeof this.ytPlayer.destroy === 'function') {
        try {
          this.ytPlayer.destroy();
        } catch {}
      }
    }
  }

  // Initialize on load
  let sdrInstance: SDRController | null = null;
  function initSDR() {
    const canvas = document.getElementById('sdr-waterfall-canvas');
    if (!canvas) {
      if (sdrInstance) {
        sdrInstance.destroy();
        sdrInstance = null;
      }
      return;
    }

    if (sdrInstance) {
      sdrInstance.destroy();
      sdrInstance = null;
    }
    sdrInstance = new SDRController();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSDR);
  } else {
    initSDR();
  }

  document.addEventListener('astro:page-load', initSDR);
  document.addEventListener('astro:before-swap', () => {
    if (sdrInstance) {
      sdrInstance.destroy();
      sdrInstance = null;
    }
  });
</script>
