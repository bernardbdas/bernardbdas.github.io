---
/**
 * ResearchArchitecture.astro — Core Theoretical & System Modules
 * Minimalist brutalist specifications for FedM3, Continuous Memory (CMS-TTT), and HOPE-FL.
 * Renders mathematical expressions with KaTeX and provides click-to-decode triggers.
 */
import { renderMath } from '../data/math-dictionary';

const mathFedM3 = renderMath('\\Delta W_{\\text{orth}} = \\text{NS}_5(M_t) \\cdot \\eta', true);
const mathCMS = renderMath(
  'W_t^{(\\text{mem})} = W_{t-1}^{(\\text{mem})} - \\eta_{\\text{inner}} \\nabla L_{\\text{self}}(x_t; W_{t-1}^{(\\text{mem})})',
  true,
);
const mathNorm = renderMath('\\|\\Delta W\\|_2 \\le 1');
const mathDP = renderMath('(\\epsilon = 1.2, \\; \\delta = 10^{-5})');
---

<section class="section research-architecture-section" aria-labelledby="arch-heading">
  <div class="sdr-section-title-row">
    <div>
      <h2 id="arch-heading" class="sdr-section-title">
        SYSTEM MODULES // ARCHITECTURAL SPECIFICATION
      </h2>
      <p class="section-micro-desc">
        Tripartite distributed framework resolving catastrophic forgetting, gradient explosion, and
        bandwidth bottlenecks
      </p>
    </div>
    <span class="sdr-station-count-badge">3 SYSTEM CORES</span>
  </div>

  <div class="modules-stack">
    <!-- ── MODULE 01 ─────────────────────────────────────────── -->
    <div class="module-card">
      <div class="dev-card-corner-tl" aria-hidden="true"></div>
      <div class="dev-card-corner-br" aria-hidden="true"></div>

      <div class="module-header">
        <div class="module-meta">
          <span class="module-number">CORE #01</span>
          <span class="module-badge">ADAPTIVE AGGREGATION</span>
        </div>
        <h3 class="module-name">FedM3: Polar-Orthogonalized Muon Optimizer</h3>
        <p class="module-lead">
          Dynamic matrix orthogonalization replacing coordinate-wise heuristic updates with quintic
          Newton-Schulz iterations.
        </p>
      </div>

      <div class="module-body-grid">
        <div class="module-feature-col">
          <h4 class="feature-title">THEORETICAL MECHANISM</h4>
          <p class="feature-text">
            Standard optimizers (Adam) require transmitting full momentum buffers, doubling
            communication cost. FedM3 bounds updates directly by their spectral norm using a 5-step
            quintic polynomial:
          </p>
          <div class="module-formula-wrap">
            <button
              type="button"
              class="clickable-math-box"
              data-equation-id="eq-fedm3"
              title="Click to inspect FedM3 formula, variables, and plain-English breakdown"
              aria-label="Inspect FedM3 Polar-Orthogonalized Muon Update equation"
            >
              <div class="cm-cue-bar">
                <span class="cm-cue-tag">[ CLICK TO DECODE FORMULA ]</span>
                <span class="cm-cue-icon">⌕</span>
              </div>
              <div class="cm-math-render">
                <Fragment set:html={mathFedM3} />
              </div>
              <span class="formula-caption">
                Quintic Newton-Schulz iteration computing the matrix sign function. Click to decode.
              </span>
            </button>
          </div>
        </div>

        <div class="module-feature-col">
          <h4 class="feature-title">SYSTEM PROPERTIES</h4>
          <ul class="module-bullet-list">
            <li>
              <strong>Bounded Spectral Updates:</strong> Enforces <Fragment set:html={mathNorm} />,
              preventing gradient explosion under extreme distribution skew.
            </li>
            <li>
              <strong>Zero Payload Doubling:</strong> Operates entirely on client gradient buffers
              without transmitting second-moment accumulators.
            </li>
            <li>
              <strong>SMPC Compatibility:</strong> Outperforms FedMedian without requiring sorting
              primitives under secure multi-party computation.
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── MODULE 02 ─────────────────────────────────────────── -->
    <div class="module-card">
      <div class="dev-card-corner-tl" aria-hidden="true"></div>
      <div class="dev-card-corner-br" aria-hidden="true"></div>

      <div class="module-header">
        <div class="module-meta">
          <span class="module-number">CORE #02</span>
          <span class="module-badge">CONTINUAL MEMORY</span>
        </div>
        <h3 class="module-name">Continuous Memory System (CMS) via Test-Time Training</h3>
        <p class="module-lead">
          Treating historical context retention as an online self-supervised meta-learning task
          rather than parameter freezing.
        </p>
      </div>

      <div class="module-body-grid">
        <div class="module-feature-col">
          <h4 class="feature-title">RETENTION MECHANISM</h4>
          <p class="feature-text">
            Eliminates multi-gigabyte Fisher Information matrices by formulating retention as an
            internal online gradient loop:
          </p>
          <div class="module-formula-wrap">
            <button
              type="button"
              class="clickable-math-box"
              data-equation-id="eq-cms-ttt"
              title="Click to inspect CMS-TTT formula, variables, and plain-English breakdown"
              aria-label="Inspect Continuous Memory System test-time update equation"
            >
              <div class="cm-cue-bar">
                <span class="cm-cue-tag">[ CLICK TO DECODE FORMULA ]</span>
                <span class="cm-cue-icon">⌕</span>
              </div>
              <div class="cm-math-render">
                <Fragment set:html={mathCMS} />
              </div>
              <span class="formula-caption">
                Compresses streaming context into synaptic states without storing raw past data.
                Click to decode.
              </span>
            </button>
          </div>
        </div>

        <div class="module-feature-col">
          <h4 class="feature-title">SYSTEM PROPERTIES</h4>
          <ul class="module-bullet-list">
            <li>
              <strong>Sliding Polynomial Mapping:</strong> Prevents overwriting of representations
              during continuous fine-tuning.
            </li>
            <li>
              <strong>Zero Raw Data Caching:</strong> Functional memory conforming to privacy
              mandates (GDPR "Right to be Forgotten").
            </li>
            <li>
              <strong>Dynamic Node Onboarding:</strong> Enables new edge devices to join without
              re-evaluating historic checkpoints.
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ── MODULE 03 ─────────────────────────────────────────── -->
    <div class="module-card">
      <div class="dev-card-corner-tl" aria-hidden="true"></div>
      <div class="dev-card-corner-br" aria-hidden="true"></div>

      <div class="module-header">
        <div class="module-meta">
          <span class="module-number">CORE #03</span>
          <span class="module-badge">NESTED TOPOLOGY</span>
        </div>
        <h3 class="module-name">HOPE-FL: Nested Hierarchical Edge-to-Cloud Routing</h3>
        <p class="module-lead">
          Multi-tier hierarchy routing model updates through regional cluster centroids to eliminate
          bottlenecks.
        </p>
      </div>

      <div class="module-body-grid">
        <div class="module-feature-col">
          <h4 class="feature-title">MULTI-TIER TOPOLOGY</h4>
          <p class="feature-text">
            Avoids flat bottlenecking across hundreds of edge clients communicating directly with a
            single coordinator:
          </p>
          <div class="topology-diagram-box">
            <div class="tier-level">
              <span class="tier-tag">TIER 1</span>
              <span class="tier-name">EDGE CLIENTS (Local CMS-TTT Adaptation)</span>
            </div>
            <div class="tier-arrow">&darr; Representation embedding alignment</div>
            <div class="tier-level">
              <span class="tier-tag">TIER 2</span>
              <span class="tier-name">REGIONAL CENTROIDS (Intermediate FedM3 Aggregation)</span>
            </div>
            <div class="tier-arrow">&darr; Differential privacy encrypted synchronization</div>
            <div class="tier-level">
              <span class="tier-tag">TIER 3</span>
              <span class="tier-name">GLOBAL COORDINATOR (Consensus Broadcast)</span>
            </div>
          </div>
        </div>

        <div class="module-feature-col">
          <h4 class="feature-title">PERFORMANCE &amp; PRIVACY</h4>
          <ul class="module-bullet-list">
            <li>
              <strong>Straggler Immunity:</strong> Asynchronous tier updates allow fast nodes to
              proceed without waiting for dropped links.
            </li>
            <li>
              <strong>Decathlon Benchmark:</strong> Validated across 10 3D volumetric segmentation
              tasks with 0.884 Mean Dice.
            </li>
            <li>
              <strong>Differential Privacy:</strong>
              <button
                type="button"
                class="clickable-inline-math"
                data-equation-id="eq-dp-guarantee"
                title="Click to inspect Differential Privacy guarantee"
              >
                Guaranteed bound at <Fragment set:html={mathDP} />
                <span class="inline-inspect-cue">⌕</span>
              </button>
              with zero-knowledge accounting.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
