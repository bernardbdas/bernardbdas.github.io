---
/**
 * ResearchHero.astro — De-identified Research & Publications Header
 * Minimalist brutalist HUD overview of distributed systems research,
 * citations, key metrics, and architectural focus.
 */
import Loader from './Loader.astro';
---

<div class="subpage-breadcrumb">
  <a href="/" class="breadcrumb-link" aria-label="Return to homepage">
    <span class="breadcrumb-arrow">←</span>
    <span>INDEX // CORE SYSTEMS</span>
  </a>
  <span class="breadcrumb-sep">//</span>
  <span class="breadcrumb-current">MODULE: RESEARCH &amp; PREPRINTS</span>
</div>

<section class="section research-hero anim-hero" aria-labelledby="research-heading">
  <div class="research-header-top">
    <div>
      <p class="micro-label">
        <Loader />
        RESEARCH ARCHIVE // DISTRIBUTED SYSTEMS &amp; NEURAL OPTIMIZATION
      </p>
      <h1 id="research-heading" class="subpage-title">
        Research &amp; Preprints<span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="focus-strip">
        Decentralized Learning • Continual Memory Systems • Polar Gradient Optimization
      </p>
    </div>

    <div class="rac-badge-wrap">
      <div class="rac-pill">
        <span class="status-dot is-transmitting"></span>
        <span class="rac-label">ACTIVE R&amp;D // OPEN SOURCE</span>
      </div>
      <span class="rac-date">REVISED OCT 2026</span>
    </div>
  </div>

  <!-- Minimalist Brutalist Research HUD Card -->
  <div class="research-dissertation-card">
    <div class="dev-card-corner-tl" aria-hidden="true"></div>
    <div class="dev-card-corner-br" aria-hidden="true"></div>

    <div class="dissertation-meta-grid">
      <div class="dissertation-main-info">
        <span class="dissertation-kicker">CORE FOCUS // DISTRIBUTED FOUNDATION MODELS</span>
        <h2 class="dissertation-title">
          Continual Neural Optimization, Polar Orthogonalization &amp; Privacy-Preserving
          Distributed Systems
        </h2>
        <p class="dissertation-summary">
          Addressing the fundamental trade-offs between parameter retention, non-IID client drift,
          and communication overhead in decentralized networks through matrix polar
          orthogonalization and test-time training memory systems.
        </p>

        <!-- Brutalist Architecture Pillars -->
        <div class="research-pillars-strip">
          <div class="pillar-chip">
            <span class="pillar-tag">[01]</span>
            <span class="pillar-name">POLAR OPTIMIZATION (Muon NS-5)</span>
          </div>
          <div class="pillar-chip">
            <span class="pillar-tag">[02]</span>
            <span class="pillar-name">CONTINUAL TTT MEMORY</span>
          </div>
          <div class="pillar-chip">
            <span class="pillar-tag">[03]</span>
            <span class="pillar-name">DIFFERENTIAL PRIVACY GUARANTEES</span>
          </div>
        </div>
      </div>

      <!-- Research Telemetry Numbers -->
      <div class="research-telemetry-col">
        <div class="telemetry-stat-box">
          <span class="stat-num">388+</span>
          <span class="stat-lbl">TOTAL CITATIONS</span>
        </div>
        <div class="telemetry-stat-box">
          <span class="stat-num">5</span>
          <span class="stat-lbl">INDEXED PAPERS</span>
        </div>
        <div class="telemetry-stat-box">
          <span class="stat-num">+14.8%</span>
          <span class="stat-lbl">ACCURACY GAIN</span>
        </div>
        <div class="telemetry-stat-box">
          <span class="stat-num">0.884</span>
          <span class="stat-lbl">DICE SEGMENTATION</span>
        </div>
      </div>
    </div>
  </div>
</section>
