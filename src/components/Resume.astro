---
/**
 * Resume — Curriculum Vitae with numbered terminal-style rows and
 * single-action interactive overlay modal on the home page.
 */
import Loader from './Loader.astro';

interface ResumeEntry {
  idx: string;
  title: string;
  desc: string;
}

const entries: ResumeEntry[] = [
  {
    idx: '01',
    title: 'Software Engineering',
    desc: 'Resilient backend architectures, automated workflows, microservices.',
  },
  {
    idx: '02',
    title: 'Enterprise Systems',
    desc: 'Production engineering at Simplify3x, distributed execution pipelines.',
  },
  {
    idx: '03',
    title: 'Modern AI & MLOps',
    desc: 'Fine-tuning LLMs, agentic RAG systems, GCP feature stores.',
  },
];
---

<section class="section anim-s2" id="resume" aria-labelledby="resume-heading">
  <p class="micro-label">
    <Loader />
    Curriculum Vitae
  </p>

  <h2 class="section-heading" id="resume-heading">
    Resume
  </h2>

  <div role="list">
    {entries.map((entry) => (
      <div class="resume-row" role="listitem">
        <span class="resume-idx">{entry.idx}</span>
        <div>
          <div class="resume-title">{entry.title}</div>
          <p class="resume-desc">{entry.desc}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Single Action Button to trigger the Resume Overlay -->
  <div class="resume-actions">
    <button
      type="button"
      class="resume-action"
      id="resumeOverlayTrigger"
      data-open-resume-overlay
      aria-haspopup="dialog"
      aria-controls="resumeModalOverlay"
      aria-expanded="false"
    >
      View Visual Resume{' '}
      <span class="arrow" aria-hidden="true">
        ↗
      </span>
    </button>
  </div>
</section>

<!-- ─── BRUTALIST RESUME OVERLAY MODAL ───────────────────────── -->
<div
  id="resumeModalOverlay"
  class="resume-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="resumeModalTitle"
  aria-hidden="true"
>
  <div class="resume-modal-card" id="resumeModalCard">
    <div class="resume-modal-bar">
      <div class="resume-modal-info">
        <span class="resume-modal-badge">PDF</span>
        <span class="resume-modal-filename" id="resumeModalTitle">
          bernard-resume-sourceserifpro.pdf
        </span>
        <span class="resume-modal-edition">// SOURCE SERIF PRO EDITION</span>
      </div>

      <div class="resume-modal-controls">
        <a
          href="/bernard-resume-sourceserifpro.pdf"
          download="Bernard_Birendra_Das_Resume.pdf"
          class="resume-modal-btn"
          title="Download PDF"
        >
          Download <span aria-hidden="true">↓</span>
        </a>
        <a
          href="/bernard-resume-sourceserifpro.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="resume-modal-btn"
          title="Open raw PDF in new browser tab"
        >
          Raw PDF <span aria-hidden="true">↗</span>
        </a>
        <button
          type="button"
          id="resumeModalClose"
          class="resume-modal-close"
          aria-label="Close resume overlay (Escape)"
          title="Close (ESC)"
        >
          ✕
        </button>
      </div>
    </div>

    <div class="resume-modal-body">
      <!-- Native PDF Viewer Embed -->
      <object
        data="/bernard-resume-sourceserifpro.pdf#view=FitH"
        type="application/pdf"
        class="resume-pdf-embed"
        title="Bernard Birendra Das Visual Resume"
      >
        <div class="resume-pdf-fallback">
          <img
            src="/bernard-resume-preview.png"
            alt="Bernard Birendra Das Visual Resume — Source Serif Pro Edition"
            class="resume-fallback-img"
            loading="lazy"
            decoding="async"
          />
          <div class="resume-fallback-actions">
            <a
              href="/bernard-resume-sourceserifpro.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="resume-action"
            >
              Open Raw PDF ↗
            </a>
            <a
              href="/bernard-resume-sourceserifpro.pdf"
              download="Bernard_Birendra_Das_Resume.pdf"
              class="resume-action"
            >
              Download PDF ↓
            </a>
          </div>
        </div>
      </object>
    </div>
  </div>
</div>

<style>
  /* Single button cursor & focus styling */
  .resume-action {
    cursor: pointer;
    font-family: inherit;
    background: transparent;
  }

  /* ══════════════════════════════════════════════════════════════
     RESUME MODAL OVERLAY (Brutalist Tactical HUD)
     ══════════════════════════════════════════════════════════════ */
  .resume-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(5, 7, 10, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .resume-modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .resume-modal-card {
    width: 100%;
    max-width: 920px;
    height: 90vh;
    max-height: 960px;
    background: rgba(var(--bg-rgb), 0.98);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      0 24px 64px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(0, 0, 0, 0.5);
    transform: scale(0.97) translateY(8px);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .resume-modal-backdrop.is-open .resume-modal-card {
    transform: scale(1) translateY(0);
  }

  .resume-modal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: rgba(var(--bg-rgb), 0.95);
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono);
    flex-shrink: 0;
    gap: 12px;
  }

  .resume-modal-info {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .resume-modal-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: var(--radius);
    background: rgba(var(--accent-rgb, 242, 149, 89), 0.15);
    color: var(--accent);
    border: 1px solid rgba(var(--accent-rgb, 242, 149, 89), 0.3);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .resume-modal-filename {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .resume-modal-edition {
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 0.04em;
  }

  .resume-modal-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .resume-modal-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-dim);
    padding: 4px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .resume-modal-btn:hover {
    color: var(--accent);
    border-color: var(--hairline-hover);
    background: rgba(var(--bg-rgb), 0.5);
  }

  .resume-modal-close {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-dim);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .resume-modal-close:hover {
    color: var(--accent);
    border-color: var(--hairline-hover);
    background: rgba(var(--bg-rgb), 0.5);
  }

  .resume-modal-body {
    flex: 1;
    width: 100%;
    height: calc(100% - 50px);
    background: #14171c;
    overflow: hidden;
    position: relative;
  }

  .resume-pdf-embed {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .resume-pdf-fallback {
    width: 100%;
    height: 100%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    overflow-y: auto;
  }

  .resume-fallback-img {
    max-width: 100%;
    max-height: 70vh;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--hairline);
  }

  .resume-fallback-actions {
    display: flex;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .resume-modal-card {
      height: 94vh;
      max-height: 98vh;
    }

    .resume-modal-edition {
      display: none;
    }

    .resume-modal-bar {
      padding: 8px 10px;
    }
  }
</style>

<script>
  function setupResumeOverlay() {
    const overlay = document.getElementById('resumeModalOverlay');
    const closeBtn = document.getElementById('resumeModalClose');
    const triggers = document.querySelectorAll('[data-open-resume-overlay]');

    if (!overlay || !closeBtn) return;

    let previousActiveElement: HTMLElement | null = null;

    const openModal = () => {
      previousActiveElement = document.activeElement as HTMLElement | null;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      triggers.forEach((t) => t.setAttribute('aria-expanded', 'true'));
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const closeModal = () => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
      document.body.style.overflow = '';
      if (previousActiveElement && typeof previousActiveElement.focus === 'function') {
        previousActiveElement.focus();
      }
    };

    triggers.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn.addEventListener('click', closeModal);

    // Close on clicking backdrop outside card
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeModal();
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
        closeModal();
      }
    });
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupResumeOverlay);
  } else {
    setupResumeOverlay();
  }
</script>
