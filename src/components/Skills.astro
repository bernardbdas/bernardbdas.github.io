---
/**
 * Skills — Comprehensive AI/ML & Systems Engineering Core Competencies.
 * Covers Foundations, Generative AI, Distributed Systems, Inference, MLOps, Data & Low-Level Craft.
 */
import Loader from './Loader.astro';

interface SkillGroup {
  id: string;
  label: string;
  category: string;
  highlightItems: string[];
  items: string[];
}

const groups: SkillGroup[] = [
  {
    id: '01',
    label: 'Deep Learning & Neural Foundations',
    category: 'CORE DL',
    highlightItems: ['PyTorch', 'JAX / Flax', 'FlashAttention-2/3', 'Transformer Internals'],
    items: [
      'TensorFlow / Keras 3',
      'Mixture of Experts (MoE)',
      'State-Space Models (Mamba)',
      'Autograd & Gradient Dynamics',
      'Self-Supervised Learning',
      'Reinforcement Learning (PPO, DPO)',
      'NumPy & SciPy',
    ],
  },
  {
    id: '02',
    label: 'Generative AI, LLMs & Alignment',
    category: 'GEN AI',
    highlightItems: [
      'LLM Pre-training & SFT',
      'PEFT (LoRA, QLoRA, DoRA)',
      'Direct Preference Optimization (DPO)',
    ],
    items: [
      'Hugging Face (Transformers, TRL)',
      'Vision-Language Models (VLMs)',
      'Diffusion Models (Stable Diffusion)',
      'RLHF & Reward Modeling',
      'Tokenization & Vocabulary Curation',
      'Model Merging (MergeKit)',
    ],
  },
  {
    id: '03',
    label: 'Agentic Frameworks, Reasoning & RAG',
    category: 'AGENTS & RAG',
    highlightItems: ['LangGraph', 'LlamaIndex', 'DSPy', 'GraphRAG (Neo4j)'],
    items: [
      'AutoGen & Multi-Agent Teams',
      'Hybrid RAG (ColBERT, SPLADE, BM25)',
      'Cross-Encoder Reranking',
      'Structured Outputs (Outlines, Instructor)',
      'Self-Correcting Query Decomposition',
      'Tool Use & Function Calling',
    ],
  },
  {
    id: '04',
    label: 'Distributed Training & High-Performance Compute',
    category: 'DISTRIBUTED HPC',
    highlightItems: ['PyTorch FSDP', 'DeepSpeed (ZeRO-1/2/3)', 'Megatron-LM', '3D Parallelism'],
    items: [
      'Tensor & Pipeline Parallelism (TP/PP)',
      'Ray Train & Ray Core',
      'NCCL & InfiniBand Tuning',
      'Slurm Cluster Scheduling',
      'GPUDirect RDMA & RoCE',
      'Activation Checkpointing & Profiling',
    ],
  },
  {
    id: '05',
    label: 'Inference Acceleration & Custom Kernels',
    category: 'SERVING & ACCEL',
    highlightItems: [
      'vLLM (PagedAttention)',
      'TensorRT-LLM',
      'OpenAI Triton Kernels',
      'Speculative Decoding',
    ],
    items: [
      'Triton Inference Server',
      'SGLang Runtime Engine',
      'Quantization (AWQ, GPTQ, FP8)',
      'Continuous Batching & Chunked Prefill',
      'TorchInductor & TorchDynamo',
      'ONNX Runtime & TensorRT',
    ],
  },
  {
    id: '06',
    label: 'Production MLOps, Orchestration & Cloud',
    category: 'MLOPS & CLOUD',
    highlightItems: [
      'Kubernetes (K8s, KServe, KubeRay)',
      'AWS (SageMaker, Trn1/Inf2/p5)',
      'GCP (Vertex AI, Cloud TPU)',
    ],
    items: [
      'Docker & Container Microservices',
      'MLflow & Weights & Biases (W&B)',
      'Argo Workflows & Airflow',
      'Data Drift & Quality (Evidently AI)',
      'LLM Observability (Langfuse, TruLens)',
      'Prometheus, Grafana & OpenTelemetry',
    ],
  },
  {
    id: '07',
    label: 'Vector Search, Streaming & Data Infrastructure',
    category: 'DATA & STORAGE',
    highlightItems: ['Qdrant', 'Milvus', 'pgvector', 'Apache Kafka', 'Apache Spark'],
    items: [
      'Pinecone & Weaviate',
      'Apache Flink & Real-Time Streams',
      'Ray Data & Distributed Ingestion',
      'DuckDB & Embedded Analytics',
      'Apache Iceberg & Delta Lake',
      'Redis (Semantic Caching & Buffers)',
    ],
  },
  {
    id: '08',
    label: 'Languages, Systems & Software Engineering',
    category: 'LANGUAGES & SYS',
    highlightItems: [
      'Python (Async, CPython Internals)',
      'Modern C++ (C++17/20)',
      'CUDA C/C++',
      'Rust',
    ],
    items: [
      'SQL (Analytics & Window Functions)',
      'Linux Kernel & POSIX Internals',
      'Bash & Infrastructure Scripting',
      'Git, GitHub Actions & Enterprise CI/CD',
      'TypeScript & Modern Systems APIs',
      'High-Performance Multi-Threading',
    ],
  },
];
---

<section class="section anim-s4" id="skills" aria-labelledby="skills-heading">
  <p class="micro-label" id="skills-heading">
    <Loader />
    Skills
  </p>

  <div class="skills-grid">
    {groups.map((group) => (
      <div class="skill-card">
        <div class="skill-group-header">
          <span class="skill-idx">{group.id}</span>
          <span class="skill-cat-tag">{group.category}</span>
          <h3 class="skill-group-name">{group.label}</h3>
        </div>

        <div class="card-wordy-content">
          <div class="card-wordy-inner">
            <div class="skill-badges-wrap">
              {/* Flagship Skills Highlighted */}
              {group.highlightItems.map((hItem) => (
                <span class="skill-pill highlight" title="Flagship Production Skill">
                  <span class="skill-dot"></span>
                  {hItem}
                </span>
              ))}

              {/* Standard Items */}
              {group.items.map((item) => (
                <span class="skill-pill">{item}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
