---
/**
 * ResearchDictionary.astro — Compact Variable & Operator Dictionary
 * A plain-English reference guide translating advanced mathematical symbols,
 * optimization parameters, and privacy metrics for laypersons and researchers alike.
 */
import { MATH_VARIABLES, type MathVariable } from '../data/math-dictionary';

const categories = [
  { id: 'ALL', label: 'ALL VARIABLES' },
  { id: 'OPTIMIZATION', label: 'OPTIMIZATION & STEPS' },
  { id: 'MODEL_STATE', label: 'MODEL & MEMORY' },
  { id: 'PRIVACY_SECURITY', label: 'PRIVACY & SECURITY' },
  { id: 'DISTRIBUTION', label: 'DISTRIBUTION & SKEW' },
];
---

<section
  class="section research-dictionary-section"
  id="variable-dictionary"
  aria-labelledby="dict-heading"
>
  <div class="sdr-section-title-row">
    <div>
      <h2 id="dict-heading" class="sdr-section-title">
        VARIABLE &amp; OPERATOR DICTIONARY // LAYPERSON GUIDE
      </h2>
      <p class="section-micro-desc">
        Plain-English translation of mathematical symbols, optimization parameters, and privacy
        metrics
      </p>
    </div>
    <span class="sdr-station-count-badge" id="dict-count-badge">
      {MATH_VARIABLES.length} SYMBOLS INDEXED
    </span>
  </div>

  <!-- Dictionary Controls: Category Filters & Search -->
  <div class="dict-toolbar">
    <div class="dict-filter-pills" role="tablist" aria-label="Filter dictionary by category">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class:list={['dict-pill', { active: idx === 0 }]}
          data-category={cat.id}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          <span>{cat.label}</span>
          <span class="cat-count">
            (
            {cat.id === 'ALL'
              ? MATH_VARIABLES.length
              : MATH_VARIABLES.filter((v) => v.category === cat.id).length}
            )
          </span>
        </button>
      ))}
    </div>

    <div class="dict-search-wrap">
      <input
        type="text"
        id="dict-search-input"
        class="dict-search-input"
        placeholder="Search by symbol, term, or keyword (e.g. learning rate, privacy)..."
        aria-label="Filter variables in dictionary"
      />
    </div>
  </div>

  <!-- Compact Variable Cards Grid -->
  <div class="dict-grid" id="dict-cards-container">
    {MATH_VARIABLES.map((v: MathVariable) => (
      <article
        class="dict-card"
        id={`var-${v.id}`}
        data-category={v.category}
        data-keywords={`${v.name} ${v.symbol} ${v.laymanMeaning} ${v.formalMeaning} ${v.category}`}
      >
        <div class="dev-card-corner-tl" aria-hidden="true"></div>
        <div class="dev-card-corner-br" aria-hidden="true"></div>

        <div class="dict-card-header">
          <div class="dict-symbol-box" aria-label={`Symbol for ${v.name}`}>
            <Fragment set:html={v.symbolHtml} />
          </div>
          <div class="dict-title-cluster">
            <span class="dict-cat-pill">{v.category.replace('_', ' ')}</span>
            <h3 class="dict-var-name">{v.name}</h3>
          </div>
        </div>

        <div class="dict-body">
          <!-- Plain English Analogy -->
          <div class="dict-layman-box">
            <span class="dict-box-kicker">PLAIN-ENGLISH TRANSLATION:</span>
            <p class="dict-layman-text">{v.laymanMeaning}</p>
          </div>

          <!-- Formal Definition -->
          <div class="dict-formal-box">
            <span class="dict-box-kicker">FORMAL DEFINITION:</span>
            <p class="dict-formal-text">{v.formalMeaning}</p>
          </div>
        </div>

        <div class="dict-card-footer">
          <span class="dict-values-tag">TYPICAL VALUES:</span>
          <code class="dict-values-code">{v.typicalValues}</code>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  function initResearchDictionary() {
    const searchInput = document.getElementById('dict-search-input') as HTMLInputElement | null;
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.dict-pill');
    const cards = document.querySelectorAll<HTMLElement>('.dict-card');
    const countBadge = document.getElementById('dict-count-badge');

    let currentCategory = 'ALL';
    let searchQuery = '';

    function filterCards() {
      let visible = 0;
      cards.forEach((card) => {
        const cardCat = card.dataset.category || '';
        const keywords = (card.dataset.keywords || '').toLowerCase();

        const matchCat = currentCategory === 'ALL' || cardCat === currentCategory;
        const matchSearch = !searchQuery || keywords.includes(searchQuery);

        if (matchCat && matchSearch) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countBadge) {
        countBadge.textContent = `${visible} SYMBOLS VISIBLE`;
      }
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');
        currentCategory = pill.dataset.category || 'ALL';
        filterCards();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterCards();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initResearchDictionary);
  } else {
    initResearchDictionary();
  }
</script>
