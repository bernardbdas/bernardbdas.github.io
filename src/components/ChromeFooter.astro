---
/** ChromeFooter — Fixed bottom status bar with copyright, client telemetry, live age counter, and vitals readout. */
const currentYear = new Date().getFullYear();
---

<footer class="chrome-bottom anim-chrome">
  <div class="chrome-bottom-left">
    <button
      type="button"
      class="footer-copyright-btn"
      id="footerCopyright"
      title={`\u00a9 ${currentYear} Bernard Birendra Das (Click 7 times quickly to toggle hidden telemetry HUD)`}
      aria-label={`Copyright ${currentYear} Bernard Birendra Das`}
    >
      <span class="copyright-symbol">&copy;</span>
      <span class="copyright-year" id="copyrightYear">
        {currentYear}
      </span>
      <span class="author-name">Bernard Birendra Das</span>
    </button>
    <span class="hud-sep footer-extra" aria-hidden="true">
      //
    </span>
    <div
      class="client-telemetry footer-extra"
      id="client-telemetry"
      title="Client Telemetry (Click any item to copy)"
    >
      <span
        class="telemetry-pill"
        id="telemetry-loc-pill"
        role="button"
        tabindex="0"
        aria-label="Copy location to clipboard"
        title="Click to copy Location"
      >
        <span class="pill-dot" aria-hidden="true"></span>
        <span class="pill-label">LOC</span>
        <span class="pill-val telemetry-loc-val" id="telemetry-loc">
          DETECTING...
        </span>
      </span>
      <span
        class="telemetry-pill telemetry-ipv4-container"
        id="telemetry-ipv4-pill"
        role="button"
        tabindex="0"
        aria-label="Copy IPv4 address to clipboard"
        title="Click to copy IPv4 address"
      >
        <span class="pill-label">IPv4</span>
        <span class="pill-val telemetry-ipv4-val" id="telemetry-ipv4">
          DETECTING...
        </span>
      </span>
      <span
        class="telemetry-pill telemetry-ipv6-container"
        id="telemetry-ipv6-pill"
        role="button"
        tabindex="0"
        aria-label="Copy IPv6 address to clipboard"
        title="Click to copy IPv6 address"
        style="display: none;"
      >
        <span class="pill-label">IPv6</span>
        <span class="pill-val telemetry-ipv6-val" id="telemetry-ipv6">
          ---
        </span>
      </span>
    </div>
  </div>

  <div class="chrome-bottom-right">
    <div class="footer-hud-controls footer-extra" role="group" aria-label="HUD Feature Toggles">
      <button
        type="button"
        class="telemetry-pill footer-toggle-pill is-active"
        id="seasonalFxToggle"
        role="switch"
        aria-checked="true"
        aria-label="Toggle seasonal effects"
        title="Toggle seasonal holiday visual effects (Christmas & New Year)"
        style="display: none;"
      >
        <span class="pill-dot pill-dot-season" aria-hidden="true"></span>
        <span class="pill-label">SEASON FX</span>
        <span class="pill-val" id="seasonalFxStatus">
          ON
        </span>
      </button>

      <button
        type="button"
        class="telemetry-pill footer-toggle-pill is-active"
        id="weatherHudToggle"
        role="switch"
        aria-checked="true"
        aria-label="Toggle atmospheric weather HUD"
        title="Toggle atmospheric weather HUD"
      >
        <span class="pill-dot pill-dot-weather" aria-hidden="true"></span>
        <span class="pill-label">WEATHER HUD</span>
        <span class="pill-val" id="weatherHudStatus">
          ON
        </span>
      </button>
    </div>

    <span class="hud-sep footer-extra" aria-hidden="true">
      //
    </span>

    <a href="#top" class="back-to-top" aria-label="Scroll back to top">
      TOP ↑
    </a>
    <span class="hud-sep vitals-sep footer-extra" aria-hidden="true">
      //
    </span>
    <div class="vitals-cluster footer-extra">
      <span
        class="vitals"
        id="vitals-badge"
        role="button"
        tabindex="0"
        title="Web Vitals Status (Click to copy full performance audit)"
        aria-label="Web Vitals Performance Status"
      >
        <span class="status-dot" id="vitals-status-dot"></span>
        <span class="vitals-text" id="vitals-status-text">
          Vitals — Optimal
        </span>
      </span>
      <div class="vitals-metrics" id="vitals-metrics" role="region" aria-label="Web Vitals Metrics">
        <span
          class="telemetry-pill vital-pill"
          id="vital-fcp"
          role="button"
          tabindex="0"
          title="First Contentful Paint (Good: <1.8s) — Click to copy"
          aria-label="First Contentful Paint"
        >
          <span class="pill-label">FCP</span>
          <span class="pill-val vital-fcp-val">--</span>
        </span>
        <span
          class="telemetry-pill vital-pill"
          id="vital-lcp"
          role="button"
          tabindex="0"
          title="Largest Contentful Paint (Good: <2.5s) — Click to copy"
          aria-label="Largest Contentful Paint"
        >
          <span class="pill-label">LCP</span>
          <span class="pill-val vital-lcp-val">--</span>
        </span>
        <span
          class="telemetry-pill vital-pill"
          id="vital-cls"
          role="button"
          tabindex="0"
          title="Cumulative Layout Shift (Good: <0.1) — Click to copy"
          aria-label="Cumulative Layout Shift"
        >
          <span class="pill-label">CLS</span>
          <span class="pill-val vital-cls-val">0.00</span>
        </span>
        <span
          class="telemetry-pill vital-pill vital-pill-ttfb"
          id="vital-ttfb"
          role="button"
          tabindex="0"
          title="Time to First Byte (Good: <0.8s) — Click to copy"
          aria-label="Time to First Byte"
        >
          <span class="pill-label">TTFB</span>
          <span class="pill-val vital-ttfb-val">--</span>
        </span>
      </div>
    </div>
  </div>
</footer>

<div
  class="easter-egg-toast"
  id="easterEggToast"
  role="status"
  aria-live="polite"
  aria-hidden="true"
>
  <span class="easter-egg-toast-dot"></span>
  <span class="easter-egg-toast-msg" id="easterEggToastMsg"></span>
</div>

<script>
  import '../scripts/client-telemetry';
  import '../scripts/web-vitals';
  import '../scripts/hard-reload';
  import '../scripts/seasonal-effects';

  // Smooth scroll to top for scrollable content container and window
  const backToTop = document.querySelector('.back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', (e) => {
      e.preventDefault();
      const contentCol = document.querySelector('.content-col');
      if (contentCol) {
        contentCol.scrollTo({ top: 0, behavior: 'smooth' });
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Hidden Mode / Easter Egg 7-click trigger on copyright button
  const copyrightBtn = document.getElementById('footerCopyright');
  const toastEl = document.getElementById('easterEggToast');
  const toastMsg = document.getElementById('easterEggToastMsg');
  const yearEl = document.getElementById('copyrightYear');
  if (yearEl) {
    yearEl.textContent = String(new Date().getFullYear());
  }

  let toastTimer: number | null = null;

  function showToast(message: string): void {
    if (!toastEl || !toastMsg) return;
    toastMsg.textContent = message;
    toastEl.classList.add('is-visible');
    toastEl.setAttribute('aria-hidden', 'false');
    if (toastTimer !== null) {
      window.clearTimeout(toastTimer);
    }
    toastTimer = window.setTimeout(() => {
      toastEl.classList.remove('is-visible');
      toastEl.setAttribute('aria-hidden', 'true');
      toastTimer = null;
    }, 3200);
  }

  let eggClicks = 0;
  let lastEggClickTime = 0;
  // User must tap/click quickly: max 650ms between consecutive taps
  const MAX_CLICK_GAP_MS = 650;

  function resetClicks(): void {
    eggClicks = 0;
  }

  function toggleEasterEgg(): void {
    const html = document.documentElement;
    const isUnlocked = html.classList.contains('easter-egg-unlocked');

    if (isUnlocked) {
      // Hide features again
      html.classList.remove('easter-egg-unlocked');
      try {
        sessionStorage.removeItem('easter_egg_unlocked');
      } catch {}
      showToast('NOX');
      window.dispatchEvent(new CustomEvent('easter-egg:lock'));
      window.dispatchEvent(new CustomEvent('cartography:recalibrate'));
    } else {
      // Unlock hidden features
      html.classList.add('easter-egg-unlocked');
      try {
        sessionStorage.setItem('easter_egg_unlocked', 'true');
      } catch {}
      showToast('LUMOS');
      window.dispatchEvent(new CustomEvent('easter-egg:unlock'));
      window.dispatchEvent(new CustomEvent('cartography:recalibrate'));
    }
  }

  function handleEggTrigger(e: Event): void {
    e.stopPropagation();
    const now = Date.now();

    if (now - lastEggClickTime > MAX_CLICK_GAP_MS) {
      eggClicks = 0;
    }
    lastEggClickTime = now;
    eggClicks++;

    if (eggClicks === 7) {
      eggClicks = 0;
      toggleEasterEgg();
    }
  }

  // Bind to copyright triggers on desktop & mobile drawer
  const eggTriggers = [
    copyrightBtn,
    document.getElementById('mobileCopyrightBtn'),
    document.querySelector('.mobile-nav-brand'),
  ].filter(Boolean) as HTMLElement[];

  eggTriggers.forEach((btn) => {
    btn.addEventListener('mouseleave', resetClicks);
    btn.addEventListener('pointerleave', resetClicks);
    btn.addEventListener('blur', resetClicks);
    btn.addEventListener('click', handleEggTrigger);
  });

  window.addEventListener('easter-egg:toggle', toggleEasterEgg);

  // If user clicks anywhere else on the document, reset click counter immediately
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    const clickedTrigger = eggTriggers.some((btn) => btn.contains(target));
    if (!clickedTrigger) {
      resetClicks();
    }
  });

  window.addEventListener('blur', resetClicks);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      resetClicks();
    }
  });

  document.addEventListener('astro:after-swap', () => {
    try {
      if (sessionStorage.getItem('easter_egg_unlocked') === 'true') {
        document.documentElement.classList.add('easter-egg-unlocked');
      }
    } catch {}
  });
</script>
