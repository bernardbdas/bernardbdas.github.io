---
/** ChromeFooter — Fixed bottom status bar with copyright, client telemetry, live age counter, and vitals readout. */
---

<footer class="chrome-bottom anim-chrome">
  <div class="chrome-bottom-left">
    <span>
      &copy; 2026 <span class="author-name">Bernard Birendra Das</span>
    </span>
    <span class="hud-sep" aria-hidden="true">
      //
    </span>
    <div
      class="client-telemetry"
      id="client-telemetry"
      title="Client Telemetry (Click any item to copy)"
    >
      <span
        class="telemetry-pill"
        id="telemetry-loc-pill"
        role="button"
        tabindex="0"
        aria-label="Copy location to clipboard"
        title="Click to copy Location"
      >
        <span class="pill-dot" aria-hidden="true"></span>
        <span class="pill-label">LOC</span>
        <span class="pill-val telemetry-loc-val" id="telemetry-loc">
          DETECTING...
        </span>
      </span>
      <span
        class="telemetry-pill telemetry-ipv4-container"
        id="telemetry-ipv4-pill"
        role="button"
        tabindex="0"
        aria-label="Copy IPv4 address to clipboard"
        title="Click to copy IPv4 address"
      >
        <span class="pill-label">IPv4</span>
        <span class="pill-val telemetry-ipv4-val" id="telemetry-ipv4">
          DETECTING...
        </span>
      </span>
      <span
        class="telemetry-pill telemetry-ipv6-container"
        id="telemetry-ipv6-pill"
        role="button"
        tabindex="0"
        aria-label="Copy IPv6 address to clipboard"
        title="Click to copy IPv6 address"
        style="display: none;"
      >
        <span class="pill-label">IPv6</span>
        <span class="pill-val telemetry-ipv6-val" id="telemetry-ipv6">
          ---
        </span>
      </span>
    </div>
  </div>

  <div class="chrome-bottom-right">
    <a href="#top" class="back-to-top" aria-label="Scroll back to top">
      TOP ↑
    </a>
    <span class="hud-sep vitals-sep" aria-hidden="true">
      //
    </span>
    <div class="vitals-cluster">
      <span
        class="vitals"
        id="vitals-badge"
        role="button"
        tabindex="0"
        title="Web Vitals Status (Click to copy full performance audit)"
        aria-label="Web Vitals Performance Status"
      >
        <span class="status-dot" id="vitals-status-dot"></span>
        <span class="vitals-text" id="vitals-status-text">
          Vitals — Optimal
        </span>
      </span>
      <div class="vitals-metrics" id="vitals-metrics" role="region" aria-label="Web Vitals Metrics">
        <span
          class="telemetry-pill vital-pill"
          id="vital-fcp"
          role="button"
          tabindex="0"
          title="First Contentful Paint (Good: <1.8s) — Click to copy"
          aria-label="First Contentful Paint"
        >
          <span class="pill-label">FCP</span>
          <span class="pill-val vital-fcp-val">--</span>
        </span>
        <span
          class="telemetry-pill vital-pill"
          id="vital-lcp"
          role="button"
          tabindex="0"
          title="Largest Contentful Paint (Good: <2.5s) — Click to copy"
          aria-label="Largest Contentful Paint"
        >
          <span class="pill-label">LCP</span>
          <span class="pill-val vital-lcp-val">--</span>
        </span>
        <span
          class="telemetry-pill vital-pill"
          id="vital-cls"
          role="button"
          tabindex="0"
          title="Cumulative Layout Shift (Good: <0.1) — Click to copy"
          aria-label="Cumulative Layout Shift"
        >
          <span class="pill-label">CLS</span>
          <span class="pill-val vital-cls-val">0.00</span>
        </span>
        <span
          class="telemetry-pill vital-pill vital-pill-ttfb"
          id="vital-ttfb"
          role="button"
          tabindex="0"
          title="Time to First Byte (Good: <0.8s) — Click to copy"
          aria-label="Time to First Byte"
        >
          <span class="pill-label">TTFB</span>
          <span class="pill-val vital-ttfb-val">--</span>
        </span>
      </div>
    </div>
  </div>
</footer>

<script>
  import '../scripts/client-telemetry';
  import '../scripts/web-vitals';
  import '../scripts/hard-reload';

  // Smooth scroll to top for scrollable content container and window
  const backToTop = document.querySelector('.back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', (e) => {
      e.preventDefault();
      const contentCol = document.querySelector('.content-col');
      if (contentCol) {
        contentCol.scrollTo({ top: 0, behavior: 'smooth' });
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
