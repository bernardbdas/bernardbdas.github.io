---
/** ChromeFooter — Fixed bottom status bar with copyright, client telemetry, live age counter, and vitals readout. */
---

<footer class="chrome-bottom anim-chrome">
  <div class="chrome-bottom-left">
    <span>
      &copy; 2026 <span class="author-name">Bernard Birendra Das</span>
    </span>
    <span class="hud-sep" aria-hidden="true">
      //
    </span>
    <div
      class="client-telemetry"
      id="client-telemetry"
      title="Client Location & IP (Click to copy telemetry)"
    >
      <span class="telemetry-pill">
        <span class="pill-dot" aria-hidden="true"></span>
        <span class="pill-label">LOC</span>
        <span class="pill-val" id="telemetry-loc">
          DETECTING...
        </span>
      </span>
      <span class="telemetry-pill" id="telemetry-ip-pill">
        <span class="pill-label">IP</span>
        <span class="pill-val" id="telemetry-ip">
          ---
        </span>
      </span>
    </div>
  </div>

  <div class="chrome-bottom-center">
    <div class="age-counter" id="age-counter" title="Live Age Counter (Click to toggle format)">
      <span class="age-badge">UPTIME</span>
      <span class="age-display" id="age-display">
        <span class="age-num" id="age-y">
          --
        </span>
        <span class="age-unit">Y</span>
        <span class="age-num" id="age-d">
          --
        </span>
        <span class="age-unit">D</span>
        <span class="age-num" id="age-h">
          --
        </span>
        <span class="age-sep">:</span>
        <span class="age-num" id="age-m">
          --
        </span>
        <span class="age-sep">:</span>
        <span class="age-num" id="age-s">
          --
        </span>
        <span class="age-dot">.</span>
        <span class="age-ms" id="age-ms">
          ---
        </span>
      </span>
    </div>
  </div>

  <div class="chrome-bottom-right">
    <a href="#top" class="back-to-top" aria-label="Scroll back to top">
      TOP ↑
    </a>
    <span class="vitals">
      <span class="status-dot"></span>
      <span class="vitals-text">Vitals — Optimal</span>
    </span>
  </div>
</footer>

<script>
  import '../scripts/age-counter';
  import '../scripts/client-telemetry';

  // Smooth scroll to top for scrollable content container and window
  const backToTop = document.querySelector('.back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', (e) => {
      e.preventDefault();
      const contentCol = document.querySelector('.content-col');
      if (contentCol) {
        contentCol.scrollTo({ top: 0, behavior: 'smooth' });
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
