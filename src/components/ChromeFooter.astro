---
/** ChromeFooter — Fixed bottom status bar with copyright, client telemetry, live age counter, and vitals readout. */
---

<footer class="chrome-bottom anim-chrome">
  <div class="chrome-bottom-left">
    <span>
      &copy; 2026 <span class="author-name">Bernard Birendra Das</span>
    </span>
    <span class="hud-sep" aria-hidden="true">
      //
    </span>
    <div
      class="client-telemetry"
      id="client-telemetry"
      title="Client Telemetry (Click to copy IPv4 / IPv6 / Location)"
    >
      <span class="telemetry-pill" id="telemetry-loc-pill">
        <span class="pill-dot" aria-hidden="true"></span>
        <span class="pill-label">LOC</span>
        <span class="pill-val telemetry-loc-val" id="telemetry-loc">
          DETECTING...
        </span>
      </span>
      <span class="telemetry-pill telemetry-ipv4-container" id="telemetry-ipv4-pill">
        <span class="pill-label">IPv4</span>
        <span class="pill-val telemetry-ipv4-val" id="telemetry-ipv4">
          DETECTING...
        </span>
      </span>
      <span
        class="telemetry-pill telemetry-ipv6-container"
        id="telemetry-ipv6-pill"
        style="display: none;"
      >
        <span class="pill-label">IPv6</span>
        <span class="pill-val telemetry-ipv6-val" id="telemetry-ipv6">
          ---
        </span>
      </span>
    </div>
  </div>

  <div class="chrome-bottom-right">
    <a href="#top" class="back-to-top" aria-label="Scroll back to top">
      TOP ↑
    </a>
    <span class="vitals">
      <span class="status-dot"></span>
      <span class="vitals-text">Vitals — Optimal</span>
    </span>
  </div>
</footer>

<script>
  import '../scripts/client-telemetry';

  // Smooth scroll to top for scrollable content container and window
  const backToTop = document.querySelector('.back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', (e) => {
      e.preventDefault();
      const contentCol = document.querySelector('.content-col');
      if (contentCol) {
        contentCol.scrollTo({ top: 0, behavior: 'smooth' });
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
