---
/**
 * PageFooter — Comprehensive in-flow document footer.
 * Renders full copyright, live client telemetry (IPv4, IPv6, location),
 * system vitals, and back-to-top link at the conclusion of page content.
 */
import Loader from './Loader.astro';
---

<footer class="page-footer anim-s5" aria-label="Document Footer">
  <div class="footer-divider" aria-hidden="true"></div>

  <div class="footer-header">
    <p class="micro-label">
      <Loader />
      Terminal Telemetry &amp; System Status
    </p>
    <a href="#top" class="footer-top-link" aria-label="Return to top of page">
      TOP ↑
    </a>
  </div>

  <div class="footer-telemetry-grid">
    <div class="telemetry-card">
      <span class="card-label">CLIENT IPv4</span>
      <span class="card-val telemetry-ipv4-val">DETECTING...</span>
    </div>

    <div class="telemetry-card telemetry-ipv6-container" style="display: none;">
      <span class="card-label">CLIENT IPv6</span>
      <span class="card-val telemetry-ipv6-val">---</span>
    </div>

    <div class="telemetry-card">
      <span class="card-label">GEOGRAPHIC LOCATION</span>
      <span class="card-val telemetry-loc-val">DETECTING...</span>
    </div>

    <div class="telemetry-card">
      <span class="card-label">INFRASTRUCTURE</span>
      <span class="card-val">Distributed MLOps &amp; AI Systems</span>
    </div>
  </div>

  <div class="footer-bottom-bar">
    <div class="footer-copyright">&copy; 2026 Bernard Birendra Das. All rights reserved.</div>
    <div class="footer-vitals">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="vitals-val">Vitals — Optimal // 2000–2026</span>
    </div>
  </div>
</footer>
