---
/**
 * Projects — High-Impact Production AI/ML & Distributed Systems.
 * Engineered to demonstrate end-to-end competencies: Agentic RAG, 3D Parallel Pre-training,
 * Low-Latency Inference Serving, Enterprise MLOps, Multi-Modal Edge, and Real-Time Feature Stores.
 */
import Loader from './Loader.astro';
import { projects } from '../data/projects';
---

<section class="section anim-s3" id="work" aria-labelledby="projects-heading">
  <div class="projects-header-row">
    <div>
      <p class="micro-label">
        <Loader />
        Work
      </p>
      <h2 class="section-heading" id="projects-heading">
        Featured Systems
      </h2>
    </div>
    <div class="projects-meta-badge" title="Production System Deployments">
      <span class="badge-accent">6 ARCHITECTURES</span>
      <span class="badge-sep">//</span>
      <span>PRODUCTION GRADE</span>
    </div>
  </div>

  <div class="projects-list" role="list">
    {projects.map((project) => (
      <article class="project-row" role="listitem">
        <div class="project-top-line">
          <div class="project-meta-cluster">
            <span class="project-sys-id">{project.id}</span>
            <span class="project-cat-badge">{project.category}</span>
          </div>
          <div class="project-metric-pill" title="Key Engineering Benchmark">
            <span class="metric-indicator-dot"></span>
            <span>{project.metric}</span>
          </div>
        </div>

        <h3 class="project-name">
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="project-title-link"
          >
            <span>{project.name}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </h3>

        <p class="project-desc">{project.desc}</p>

        <!-- Key Architectural Highlights -->
        <ul class="project-highlights-list">
          {project.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>

        <div class="tags">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>

        <!-- Interactive Tactical Demonstration Actions -->
        <div class="project-actions-row">
          <button
            type="button"
            class="project-demo-btn"
            data-open-project-demo={project.id}
            title={`Watch live demo & architecture telemetry for ${project.name}`}
          >
            <span class="demo-play-icon" aria-hidden="true">
              ▶
            </span>
            <span>WATCH DEMO & TELEMETRY</span>
          </button>
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="project-github-link"
            title={`View GitHub repository for ${project.name}`}
          >
            <span>GITHUB REPO</span>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
