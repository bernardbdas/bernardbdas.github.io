---
/**
 * MediaTV.astro — Curated Television & Prestige Series Archive
 * Searchable, filterable catalogue by genre, creator, cast, and OTT streaming platforms.
 */
import { CURATED_TV_SHOWS, type TVShowItem } from '../data/media-curation';

const allTVGenres = Array.from(new Set(CURATED_TV_SHOWS.flatMap((s) => s.genres))).sort();
const allTVPlatforms = Array.from(new Set(CURATED_TV_SHOWS.flatMap((s) => s.ottPlatforms))).sort();
---

<div class="media-catalogue-container" id="tv-catalogue-root">
  <!-- Filter & Search Toolbar -->
  <div class="media-toolbar">
    <div class="media-search-wrap">
      <span class="search-icon" aria-hidden="true">
        ⌕
      </span>
      <input
        type="search"
        id="tv-search-input"
        class="media-search-input"
        placeholder="SEARCH TV SHOWS, CREATORS (SAM ESMAIL, BEN STILLER...), CAST, OR KEYWORDS..."
        aria-label="Search curated TV series archive"
      />
      <button
        type="button"
        id="tv-search-clear"
        class="search-clear-btn"
        aria-label="Clear search"
        style="display: none;"
      >
        ✕
      </button>
    </div>

    <!-- Platform Filter Pills -->
    <div class="media-filter-group">
      <span class="filter-group-label">STREAMING PLATFORM:</span>
      <div class="filter-pills-row" id="tv-platform-pills" role="tablist">
        <button
          type="button"
          class="filter-pill active"
          data-filter-platform="ALL"
          role="tab"
          aria-selected="true"
        >
          ALL ({CURATED_TV_SHOWS.length})
        </button>
        {allTVPlatforms.map((plat) => {
          const count = CURATED_TV_SHOWS.filter((s) => s.ottPlatforms.includes(plat)).length;
          return (
            <button
              type="button"
              class="filter-pill"
              data-filter-platform={plat}
              role="tab"
              aria-selected="false"
            >
              {plat} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Genre Filter Pills -->
    <div class="media-filter-group">
      <span class="filter-group-label">GENRE FILTER:</span>
      <div class="filter-pills-row" id="tv-genre-pills" role="tablist">
        <button
          type="button"
          class="filter-pill active"
          data-filter-genre="ALL"
          role="tab"
          aria-selected="true"
        >
          ALL
        </button>
        {allTVGenres.map((g) => (
          <button
            type="button"
            class="filter-pill"
            data-filter-genre={g}
            role="tab"
            aria-selected="false"
          >
            {g}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Counter Status Row -->
  <div class="catalogue-status-bar">
    <span class="catalogue-count" id="tv-visible-count">
      INDEX: {CURATED_TV_SHOWS.length} CURATED PRESTIGE SERIES
    </span>
    <span class="catalogue-telemetry">TRANSMISSION_FEED: OPTIMAL // LIVE ARCHIVE</span>
  </div>

  <!-- TV Shows Grid -->
  <div class="media-cards-grid" id="tv-cards-grid" role="list">
    {CURATED_TV_SHOWS.map((show: TVShowItem) => (
      <article
        class="media-item-card"
        id={`show-${show.id}`}
        data-title={show.title.toLowerCase()}
        data-creator={show.creator.toLowerCase()}
        data-cast={show.cast.join(' ').toLowerCase()}
        data-genres={show.genres.join(',')}
        data-platforms={show.ottPlatforms.join(',')}
        data-years={show.years}
        role="listitem"
      >
        <div class="dev-card-corner-tl" aria-hidden="true"></div>
        <div class="dev-card-corner-br" aria-hidden="true"></div>

        <!-- Card Header -->
        <div class="media-card-header">
          <div class="media-title-wrap">
            <h3 class="media-title">{show.title}</h3>
            <span class="media-year">({show.years})</span>
          </div>
          <div class="media-rating-badge" title="Bernard's Curated Rating">
            <span class="rating-star">★</span>
            <span class="rating-num">{show.rating}</span>
          </div>
        </div>

        <!-- Meta Specifications -->
        <div class="media-specs-grid">
          <div class="spec-item">
            <span class="spec-k">SHOWRUNNER / CREATOR</span>
            <span class="spec-v highlight-director">{show.creator}</span>
          </div>
          <div class="spec-item">
            <span class="spec-k">SEASONS / ARCHIVE</span>
            <span class="spec-v">{show.seasons}</span>
          </div>
          <div class="spec-item spec-span-2">
            <span class="spec-k">PRIMARY ENSEMBLE</span>
            <span class="spec-v cast-list">{show.cast.join(' • ')}</span>
          </div>
        </div>

        <!-- Synopsis -->
        <p class="media-synopsis">{show.synopsis}</p>

        <!-- Bernard's Takeaway Note -->
        <div class="media-takeaway-box">
          <span class="takeaway-label">CRITICAL REASONING &amp; FIELD NOTES:</span>
          <p class="takeaway-text">{show.takeaway}</p>
        </div>

        <!-- Footer: Genres & OTT Platforms -->
        <div class="media-card-footer">
          <div class="media-genres-tags">
            {show.genres.map((g) => (
              <span class="media-genre-chip">{g}</span>
            ))}
          </div>

          <div class="media-ott-badges" aria-label="Available OTT Streaming Services">
            {show.ottPlatforms.map((plat) => (
              <span class="ott-badge" data-ott={plat}>
                {plat}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Empty Search Results Notice -->
  <div class="media-empty-notice" id="tv-empty-notice" style="display: none;">
    <span class="status-dot status-warn"></span>
    <span class="empty-title">NO MATCHING TELEVISION SERIES FOUND</span>
    <p class="empty-desc">
      Adjust your genre, platform filter, or search query to match indexed television series.
    </p>
    <button type="button" id="tv-reset-filters-btn" class="dev-btn">
      RESET SERIES FILTERS
    </button>
  </div>
</div>
