---
/**
 * MediaTV.astro — Curated Television & Prestige Series Archive
 * Minimalist tactical HUD filtering for Bernard's authorized OTT platforms:
 * Apple TV, Netflix, Primevideo, JioHotstar, Mubi, A24 movies, HBO Max, Lionsgate.
 */
import { CURATED_TV_SHOWS, USER_OTT_PLATFORMS, type TVShowItem } from '../data/media-curation';

const coreTVGenres = [
  'ALL',
  'Sci-Fi',
  'Hard Sci-Fi',
  'Space Opera',
  'Anime',
  'Cyber-Thriller',
  'Psychological',
  'Mystery',
  'Supernatural',
  'Drama',
  'Corporate Dystopia',
  'Corporate Satire',
  'Crime',
  'Action',
  'History',
  'Spy Thriller',
  'Comedy',
  'Stoner Comedy',
  'Satire',
  'Epic',
  'Superhero',
];
---

<div class="media-catalogue-container" id="tv-catalogue-root">
  <!-- Minimalist Tactical HUD Control Bar -->
  <div class="media-tactical-toolbar">
    <div class="toolbar-primary-row">
      <!-- Search Input with SVG crosshair icon -->
      <div class="media-search-wrap">
        <span class="search-icon-slot" aria-hidden="true">
          <svg
            class="search-svg"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="7" cy="7" r="4.5"></circle>
            <line x1="10.5" y1="10.5" x2="14" y2="14"></line>
          </svg>
        </span>
        <input
          type="text"
          inputmode="search"
          role="searchbox"
          id="tv-search-input"
          class="media-search-input"
          placeholder="FILTER TV SERIES // TITLE, CREATOR, CAST..."
          aria-label="Filter curated TV series archive"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="tv-search-clear"
          class="search-clear-btn"
          aria-label="Clear TV search query"
          style="display: none;"
          title="Clear search"
        >
          <svg
            class="clear-svg"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          >
            <line x1="3" y1="3" x2="11" y2="11"></line>
            <line x1="11" y1="3" x2="3" y2="11"></line>
          </svg>
        </button>
      </div>

      <!-- Tactical Dropdown Controls -->
      <div class="toolbar-dropdown-controls">
        <div class="hud-select-wrap">
          <label for="tv-genre-select" class="hud-select-label">
            GENRE
          </label>
          <select id="tv-genre-select" class="hud-select" aria-label="Filter TV shows by genre">
            {coreTVGenres.map((g) => (
              <option value={g}>{g === 'ALL' ? 'ALL GENRES' : g.toUpperCase()}</option>
            ))}
          </select>
          <span class="select-chevron" aria-hidden="true">
            ▾
          </span>
        </div>

        <button
          type="button"
          id="tv-reset-filters-btn-top"
          class="hud-reset-btn"
          title="Reset active TV filters"
          style="display: none;"
        >
          <svg
            class="reset-svg"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 2v4h4"></path>
            <path d="M3.5 9.5a5 5 0 1 0 1.2-5.4L2 6"></path>
          </svg>
          <span>RESET</span>
        </button>
      </div>
    </div>

    <!-- Bernard's Authorized OTT Platform Switcher Bar (Clean, uncrowded, no wordy counters) -->
    <div
      class="ott-platform-strip"
      role="tablist"
      aria-label="Filter by Bernard's Streaming Services"
    >
      <span class="strip-label">OTT NETWORK:</span>
      <div class="ott-pills-row" id="tv-platform-pills">
        <button
          type="button"
          class="ott-filter-chip active"
          data-filter-platform="ALL"
          role="tab"
          aria-selected="true"
        >
          ALL
        </button>
        {USER_OTT_PLATFORMS.map((plat) => (
          <button
            type="button"
            class="ott-filter-chip"
            data-filter-platform={plat}
            role="tab"
            aria-selected="false"
          >
            {plat.toUpperCase()}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Telemetry Counter Row -->
  <div class="catalogue-status-bar">
    <div class="status-left">
      <span class="status-pulse-dot" aria-hidden="true"></span>
      <span class="catalogue-count" id="tv-visible-count">
        INDEX: {CURATED_TV_SHOWS.length} CURATED PRESTIGE SERIES
      </span>
    </div>
    <span class="catalogue-telemetry">AUTHORIZATION // BERNARD'S CURATION</span>
  </div>

  <!-- Cross-Deck Quick Hint Bar -->
  <div class="cross-deck-hint-bar" id="tv-cross-hint-bar" style="display: none;">
    <div class="cross-hint-content">
      <span class="status-pulse-dot" aria-hidden="true"></span>
      <span class="cross-hint-text" id="tv-cross-hint-text"></span>
    </div>
    <button type="button" class="cross-hint-action-btn" id="tv-cross-hint-btn">
      <span>SWITCH TO MOVIES</span>
      <span class="cross-hint-arrow" aria-hidden="true">
        →
      </span>
    </button>
  </div>

  <!-- TV Shows Grid -->
  <div class="media-cards-grid" id="tv-cards-grid" role="list">
    {CURATED_TV_SHOWS.map((show: TVShowItem) => (
      <article
        class="media-item-card"
        id={`tv-${show.id}`}
        data-title={show.title.toLowerCase()}
        data-creator={show.creator.toLowerCase()}
        data-cast={show.cast.join(' ').toLowerCase()}
        data-genres={show.genres.join(',')}
        data-platforms={show.ottPlatforms.join(',')}
        data-years={show.years}
        role="listitem"
      >
        <div class="dev-card-corner-tl" aria-hidden="true"></div>
        <div class="dev-card-corner-br" aria-hidden="true"></div>

        <!-- Card Header -->
        <div class="media-card-header">
          <div class="media-title-wrap">
            <h3 class="media-title">{show.title}</h3>
            <span class="media-year">({show.years})</span>
          </div>
          <div class="media-rating-badge" title="Bernard's Curated Rating">
            <svg
              class="rating-reticle-star"
              viewBox="0 0 14 14"
              fill="currentColor"
              stroke="none"
              aria-hidden="true"
            >
              <polygon points="7,1 8.8,4.8 13,5.4 9.9,8.4 10.6,12.6 7,10.6 3.4,12.6 4.1,8.4 1,5.4 5.2,4.8" />
            </svg>
            <span class="rating-num">{show.rating}</span>
          </div>
        </div>

        <!-- Meta Specifications -->
        <div class="media-specs-grid">
          <div class="spec-item">
            <span class="spec-k">CREATOR / SHOWRUNNER</span>
            <span class="spec-v highlight-director">{show.creator}</span>
          </div>
          <div class="spec-item">
            <span class="spec-k">FORMAT</span>
            <span class="spec-v">{show.seasons}</span>
          </div>
          <div class="spec-item spec-span-2">
            <span class="spec-k">KEY ENSEMBLE</span>
            <span class="spec-v cast-list">{show.cast.join(' • ')}</span>
          </div>
        </div>

        <!-- Synopsis -->
        <p class="media-synopsis">{show.synopsis}</p>

        <!-- Bernard's Takeaway Note -->
        <div class="media-takeaway-box">
          <span class="takeaway-label">CURATOR'S ANALYSIS:</span>
          <p class="takeaway-text">{show.takeaway}</p>
        </div>

        <!-- Footer: Genres & OTT Platforms -->
        <div class="media-card-footer">
          <div class="media-genres-tags">
            {show.genres.map((g) => (
              <span class="media-genre-chip">{g}</span>
            ))}
          </div>

          <div class="media-ott-badges" aria-label="Available OTT Streaming Services">
            {show.ottPlatforms.map((plat) => (
              <span class="ott-badge" data-ott={plat}>
                {plat}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Cross-Deck Suggestions Section (e.g. When searching a Film while in TV Shows) -->
  <div class="cross-deck-results-container" id="tv-cross-deck-results" style="display: none;">
    <div class="cross-deck-header-bar">
      <div class="cross-deck-header-info">
        <span class="status-pulse-dot" aria-hidden="true"></span>
        <span class="cross-deck-tag">CROSS-ARCHIVE TELEMETRY</span>
        <h4 class="cross-deck-heading" id="tv-cross-deck-heading">
          MATCHING CINEMA FEATURE FILMS FOUND
        </h4>
      </div>
      <button type="button" class="cross-deck-switch-btn" id="tv-cross-switch-btn">
        <span>SWITCH TO MOVIES DECK</span>
        <span class="cross-deck-arrow" aria-hidden="true">
          →
        </span>
      </button>
    </div>
    <div class="media-cards-grid cross-cards-grid" id="tv-cross-cards-grid">
      <!-- Cloned matching cards rendered dynamically -->
    </div>
  </div>

  <!-- Empty Search Results Notice -->
  <div class="media-empty-notice" id="tv-empty-notice" style="display: none;">
    <span class="status-dot status-warn"></span>
    <span class="empty-title">NO MATCHING TV SERIES FOUND</span>
    <p class="empty-desc">
      Adjust your genre, platform filter, or search query to match indexed series.
    </p>
    <button type="button" id="tv-reset-filters-btn" class="dev-btn">
      RESET TV FILTERS
    </button>
  </div>
</div>
